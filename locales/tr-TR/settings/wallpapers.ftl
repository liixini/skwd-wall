settings-wallpapers-displays-say = { $state ->
        [none] Kilitli ekran yok.
        [one] { $names } kilitli.
        [some] { $names } kilitli.
       *[detecting] Ekranlar algılanıyor.
    } Kendi yerleşimi olmayan ekranlar { $fill } kullanır.
settings-wallpapers-play-say = Görseller { $backend }, videolar { $val }Vulkan{ $end } kullanır, { $layer } katmanında.
settings-wallpapers-transitions-say = { $family } ailesi{ $kind ->
        [random] , her seferinde farklı, { $duration } boyunca.
        [preset] , { $shader } ile, { $ms } ms.
       *[shader] , { $shader } ile, { $duration } boyunca.
    } Kare hızı { $rate }.
settings-wallpapers-primary-count = { $state ->
        [none] { $all } taneden hiçbiri
        [all] { $all } tanenin tümü
       *[some] { $all } taneden { $shown } tanesi
    }
settings-wallpapers-awww-say = Görseller { $type } oynatır, { $filter } filtresiyle, { $duration } boyunca.
settings-wallpapers-drawing-say = { $state ->
        [on] Hazırlanan duvar kâğıtları { $duration } içinde çizilir.
       *[off] Kapalı. Çizim seçili kartlar yine { $duration } içinde çizilir.
    }
settings-wallpapers-sound-say = Duvar kâğıdı sesi { $volume } düzeyinde çalar{ $duck ->
