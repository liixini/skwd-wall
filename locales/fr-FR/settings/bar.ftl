settings-bar-filter = Barre de filtres
settings-bar-filter-desc = La bande de boutons de type, de tri et de filtre au-dessus du sélecteur.
settings-bar-filter-say = Affiche { $val }{ $buttons }{ $end } et { $val }{ $sorts }{ $end }, disposés { $orientation ->
        [vertical] verticalement
       *[horizontal] horizontalement
    }. { $visibility ->
        [hover] Elle s’affiche tant que le pointeur la survole.
        [hidden] Elle reste masquée jusqu’à ce que vous appuyiez sur son raccourci.
       *[always] Elle reste épinglée.
    } Style visuel : { $style }.
settings-bar-button-count = { $shown ->
        [one] { $shown } bouton
       *[other] { $shown } boutons
    } sur { $all }
settings-bar-sort-count = { $shown ->
        [one] { $shown } tri
       *[other] { $shown } tris
    } sur { $all }
settings-bar-offers = Ce qu’elle propose
settings-bar-behaves = Son comportement
settings-bar-buttons = Boutons de la barre
settings-bar-search-pinned-hint = S’ouvre avec le sélecteur
settings-bar-placed = L’emplacement de la barre se règle dans Disposition.
settings-bar-sizes = Plages de taille
settings-bar-sizes-desc = Les plages de résolution que filtre le bouton Taille.
settings-bar-sizes-say = Le bouton Taille propose { $bands }.
settings-bar-sizes-none = Aucune plage de taille pour l’instant : le bouton Taille n’a rien à proposer.
settings-bar-unnamed = sans nom
settings-bar-from = de
settings-bar-up-to = à
settings-bar-no-limit = sans limite
settings-bar-add-hint = Une plage prête ou personnalisée
settings-bar-start = Ouverture du sélecteur
settings-bar-start-desc = Le dossier affiché à l’ouverture du sélecteur.
settings-bar-start-say = Le sélecteur s’ouvre sur { $folder } et { $sticky ->
        [yes] garde vos filtres après sa fermeture.
       *[no] réinitialise vos filtres à chaque ouverture.
    }
settings-bar-sticky-hint = Garde les filtres de type, dossier, couleur, tri et favoris après la fermeture
settings-bar-search-desc = Tags cherche les mots enregistrés. Décrire trouve des images d’après une courte description.
settings-bar-search-say = La recherche s’ouvre sur { $mode ->
        [describe] Décrire
       *[tags] Tags
    }. La recherche Décrire utilise { $model } sur { $views ->
        [multiview] la composition et les recadrages
       *[full] l’image entière
    }.
settings-bar-search-off = La recherche s’ouvre sur { $mode ->
        [describe] Décrire
       *[tags] Tags
    }. La recherche Décrire est désactivée : aucun modèle n’est chargé ni aucune image indexée. Les tags fonctionnent toujours.
settings-bar-model-status = { " " }État du modèle : { $val }{ $status }{ $end }.
settings-bar-searching = Recherche
settings-bar-unused = Non utilisé
settings-bar-name-hint = Affiché dans la liste des modèles actifs
settings-bar-manual-hint = Référence un pack sur place
settings-bar-forget-hint = Garde les fichiers
settings-bar-delete-hint = Désactive aussi la recherche sémantique
settings-menu-choose = Choisir
settings-checks-count = { $shown } sur { $all }
settings-bar-floats-hint = À placer dans Organiser
settings-bar-delete-named = Supprimer { $name }
settings-bar-forget-named = Oublier { $name }
