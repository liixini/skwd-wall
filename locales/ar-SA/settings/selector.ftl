settings-selector-layout-card = التخطيط
settings-selector-display-mode-label = وضع العرض
settings-selector-display-mode-desc = اختر طريقة ترتيب بطاقات الخلفيات في المنتقي.
settings-selector-filter-motion-label = حركة التصفية
settings-selector-filter-motion-desc = سرعة دوران الشريط عند تغيّر نتائج التصفية. الأوزان الثلاثة المشتركة موجودة في إعدادات الحركة.
settings-selector-presets-card = الإعدادات المسبقة
settings-selector-preset-generated-name = النمط { $number }
settings-selector-saved-styles-label = الأنماط المحفوظة
settings-selector-live-preview-card = معاينة الألوان
settings-selector-live-preview-label = معاينة السمات عند التحويم
settings-selector-live-preview-desc = يعيد تلوين المنتقي من الخلفية الواقعة تحت المؤشر. تعود السمة الحالية عند مغادرة المؤشر ما لم تطبّق.
settings-selector-type-badges-label = إظهار شارات النوع
settings-selector-type-badges-desc = يضع علامة Pic أو Vid أو WE على بطاقات الخلفيات ليظهر نوع الملف دون فتح البطاقة.
settings-selector-composition-card = التكوين
settings-selector-composition-card-desc-hex = اختر الشكل العام للحقل، ثم اضبط انحناءه وشكل بلاطاته وصفوفه وأعمدته.
settings-selector-composition-card-desc-wall = اختر تخطيط الجدار، ثم اضبط كثافته وتباعده وبطاقاته.
settings-selector-hex-curve-label = وضع Geometric
settings-selector-hex-curve-desc = اختر إن كان الحقل كله يبقى مسطحًا أو ينحني إلى قوس أو موجة أو شكل S أو أسطوانة.
settings-selector-hex-curve-flat = مستوٍ
settings-selector-hex-curve-arc = قوس
settings-selector-hex-curve-wave = شريط
settings-selector-hex-curve-s = انحناء S
settings-selector-hex-curve-cylinder = أسطوانة
settings-selector-hex-shape-label = عائلة البلاطات
settings-selector-hex-shape-desc = اختر بلاطة متراصفة. «معيّن» و«معيّن مائل» يلفّان خلفية واحدة في هندسة رأسية أو أفقية.
settings-selector-hex-shape-triangle = مثلث
settings-selector-hex-shape-hexagon = سداسي
settings-selector-hex-shape-diamond = معيّن
settings-selector-hex-shape-rhombus = معيّن مائل
settings-selector-hex-intensity-label = قوة الانحناء
settings-selector-hex-intensity-desc = ارفع القيمة لزيادة انحناء شكل الحقل المحدد.
settings-selector-hex-waves-label = الموجات
settings-selector-hex-waves-desc = عدد موجات الشريط التي تعبر الحقل.
settings-selector-hex-orbit-radius-label = نصف قطر الأسطوانة
settings-selector-hex-orbit-radius-desc = القيم الأصغر تلفّ الحقل بإحكام أكبر.
settings-selector-hex-rows-label = الصفوف
settings-selector-hex-cols-label = الأعمدة
settings-selector-cells-card = الخلايا
settings-selector-cells-card-desc = غيّر حجم البلاطات وتباعدها دون تغيير شكل الحقل المحدد.
settings-selector-hex-cell-size-label = حجم الخلية
settings-selector-hex-gap-x-label = التباعد الأفقي
settings-selector-hex-gap-y-label = التباعد الرأسي
settings-selector-wall-mode-label = وضع Wall
settings-selector-wall-mode-desc = اختر كيف يرتّب Wall البطاقات. يستخدم كل وضع أحجام صفوف وسلوك تمرير مختلفة.
settings-selector-wall-mode-uniform = منتظم
settings-selector-wall-mode-brick = طوب
settings-selector-wall-mode-masonry = بناء حجري
settings-selector-wall-mode-justified = مضبوط
settings-selector-wall-mode-editorial = تحريري
settings-selector-wall-mode-cylinder = أسطوانة
settings-selector-grid-columns-label = الأعمدة
settings-selector-grid-rows-label = الصفوف
settings-selector-grid-stagger-label = التوازن
settings-selector-grid-stagger-desc = يغيّر إزاحة الصفوف المتناوبة، أو حجم البطاقة الرئيسية في الوضع التحريري.
settings-selector-grid-bend-label = الانحناء
settings-selector-grid-bend-desc = القيم الموجبة تلتف بعيدًا عنك؛ والسالبة تتقوّس نحوك.
settings-selector-grid-cylinder-radius-label = نصف قطر الأسطوانة
settings-selector-grid-cylinder-radius-desc = القيم الأصغر تجعل اللفّ أكثر إحكامًا.
settings-selector-cards-card = البطاقات
settings-selector-cards-card-desc = اضبط حجم البطاقات وتباعدها وشكل زواياها.
settings-selector-card-width-label = عرض البطاقة
settings-selector-card-height-label = ارتفاع البطاقة
settings-selector-grid-gap-x-label = التباعد الأفقي
settings-selector-grid-gap-x-desc = المسافة المرئية من حافة إلى حافة بين الأعمدة.
settings-selector-grid-gap-y-label = التباعد الرأسي
settings-selector-grid-gap-y-desc = المسافة المرئية من حافة إلى حافة بين الصفوف.
settings-selector-performance-card = الأداء
settings-selector-performance-card-desc = كل حبّة رمل هي شكل هندسي مستقل. الحبّات الأكبر تعني أشكالًا أقل وعملًا أقل بكثير على GPU.
settings-selector-sand-note-discrete = هذا الحمل صغير على GPU المنفصل المكتشف. حجم الحبّة نفسه قد يكون أبطأ بنحو 150 مرة على GPU مدمج.
settings-selector-sand-note-integrated = قد يكون الرمل محدودًا بأداء GPU المدمج هذا. زد حجم الحبّة أو أبقِ تفاصيل الحركة التلقائية مفعّلة.
settings-selector-sand-meter-label = { $count } حبّة/إطار  ·  { $load }
settings-selector-sand-meter-desc = حبّة { $grain } عند صورة مركزية نموذجية · { $card } ({ $tier }) · { $note }
settings-selector-sand-load-very-heavy = ثقيل جدًا
settings-selector-sand-load-heavy = ثقيل
settings-selector-sand-load-moderate = متوسط
settings-selector-sand-load-light = خفيف
settings-selector-grain-size-label = حجم الحبّة
settings-selector-grain-size-desc = حجم الحبّة بالبكسل. القيمة 1 تعني حبّة لكل بكسل من الصورة وهي الأثقل؛ الحبّات الأكبر تبدو أخشن لكنها أقل كلفة بكثير.
settings-selector-render-scale-label = مقياس التصيير
settings-selector-render-scale-desc = يصيّر الرمل بدقة أقل ثم يكبّره. يوفّر أقل من حجم الحبّة، لأن الحبّات أشكال هندسية لا بكسلات.
settings-selector-lod-auto-label = تفاصيل حركة تلقائية
settings-selector-lod-auto-desc = يزيد حجم الحبّة أثناء التمرير السريع. مفعّل افتراضيًا على وحدات GPU المدمجة، حيث يقلّل كلفة الحركة بنحو 3.5 مرة.
settings-selector-lod-strength-label = قوة تفاصيل الحركة
settings-selector-lod-strength-desc = أقصى مضاعف للحبّة عند سرعة التمرير الكاملة أثناء عمل تفاصيل الحركة.
settings-selector-sandy-card = Sandy
settings-selector-sandy-card-desc = تستقر الخلفية الحالية في المنتصف فوق صف من المصغّرات المستديرة. اختيار خلفية أخرى يفتّت الصورتين إلى حبّات تخرج وتدخل من حافتين متقابلتين.
settings-selector-sandy-center-label = ارتفاع المنتصف
settings-selector-sandy-slice-height-label = ارتفاع الشريحة
settings-selector-sandy-slice-width-label = عرض الشريحة
settings-selector-sandy-gap-label = الفجوة
settings-selector-sandy-gap-desc = الفجوة بين الشرائح المائلة عند منتصفها الرأسي. القيمة 0 تجعل الحواف تتلامس؛ والقيم السالبة تتداخل.
settings-selector-sandy-skew-label = الميل
settings-selector-sandy-edge-speed-label = تمرير الحواف
settings-selector-sandy-edge-speed-desc = سرعة تحريك الدوّار عند حواف الشاشة، 100 = الافتراضي.
settings-selector-sand-card = الرمل
settings-selector-sand-card-desc = كيف تنتقل الحبّات. كلها نسب مئوية، 100 = الافتراضي.
settings-selector-sandy-duration-label = المدة
settings-selector-sandy-duration-desc = الوقت الكلي من بدء خروج الصورة القديمة حتى اكتمال تشكّل الصورة الجديدة.
settings-selector-sandy-blend-label = المزج
settings-selector-sandy-blend-desc = طول مسح اللون؛ تلاشي الحلقة يجري بنصف هذه القيمة.
settings-selector-sandy-strands-label = الأشرطة
settings-selector-sandy-strands-desc = يقسم الحبّات إلى تيارات مرئية أكثر أو أقل.
settings-selector-sandy-twist-label = الالتواء
settings-selector-sandy-twist-desc = شدة الالتفاف الحلزوني على طول كل شريط.
settings-selector-sandy-orbit-label = المدار
settings-selector-sandy-orbit-desc = مدى اتساع دوران الحبّات حول شريطها.
settings-selector-sandy-turbulence-label = الاضطراب
settings-selector-sandy-turbulence-desc = التواء عشوائي لمسارات الأشرطة.
settings-selector-sandy-waist-label = الخصر
settings-selector-sandy-waist-desc = تضييق التيارات في منتصف الرحلة؛ أقل = عنق أضيق.
settings-selector-sandy-front-label = الجبهة
settings-selector-sandy-front-desc = تدرّج توقيت خروج أجزاء الصورة القديمة. القيم الأعلى تبقي المناطق اللاحقة في مكانها مدة أطول.
settings-selector-sandy-fan-label = المروحة
settings-selector-sandy-fan-desc = انتشار التيار عند الحواف، أو الالتفاف في وضع الدوّامة.
settings-selector-swap-style-label = نمط التبديل
settings-selector-swap-style-desc = اختر المسار الذي تسلكه الحبّات بين الصورة القديمة والجديدة.
settings-selector-sandy-arc-label = القوس
settings-selector-sandy-arc-desc = حجم الحلقة عند تفعيل تبديل حلقة الزاوية.
settings-selector-swap-loop-label = تبديل حلقة الزاوية
settings-selector-swap-loop-desc = الاختيارات المقاطِعة تمرّر الحبّات في حلقة عبر الزاوية العلوية بدل رفعها إلى الحلقة الدوّارة.
settings-selector-outgoing-live-label = يبقى الفيديو الخارج حيًا
settings-selector-outgoing-live-desc = يُبقي الفيديو القديم قيد التشغيل بينما يتحوّل إلى رمل. التبديل من فيديو إلى فيديو يشغّل مفكّك ترميز ثانيًا حتى انتهاء الانتقال؛ وعند الإيقاف يُحمل إطار مجمّد دون كلفة إضافية.
settings-selector-ring-card = الحلقة
settings-selector-ring-card-desc = تتحكم هذه الإعدادات في حلقة الحبّات الدوّارة التي تظهر أثناء التنقل السريع بين الخلفيات. القيمة 100 هي الافتراضية.
settings-selector-ring-size-label = الحجم
settings-selector-ring-size-desc = قطر المدار نسبةً إلى الصورة الرئيسية. تظل الحلقة تتبع نسبة أبعاد الصورة الرئيسية؛ 100 تحافظ على الحجم المصمَّم.
settings-selector-ring-spin-label = الدوران
settings-selector-ring-spin-desc = سرعة دوران الشريط في مداره.
settings-selector-ring-wave-label = الموجة
settings-selector-ring-wave-desc = تموّج شعاعي يسري عبر الشريط.
settings-selector-ring-soft-label = النعومة
settings-selector-ring-soft-desc = القيم الأعلى تستخدم حبّات أكبر وأخفت وتجعل الحلقة أقل حدة.
settings-selector-ring-blend-label = مزج الحلقة
settings-selector-ring-blend-desc = طول مسح اللون أثناء الحلقة.
settings-selector-ring-hold-label = تأخير الاستقرار
settings-selector-ring-hold-desc = المدة بعد آخر اختيار قبل أن تلتزم الحلقة بالصورة الرئيسية.
settings-selector-slice-size-card = حجم الشريحة
settings-selector-slice-height-label = ارتفاع الشريحة
settings-selector-visible-count-label = العناصر المرئية
settings-selector-expanded-width-label = عرض العنصر المحدد
settings-selector-slice-width-label = عرض الشريحة
settings-selector-slice-gap-label = الفجوة
settings-selector-slice-gap-desc = الفجوة بين الشرائح المائلة عند منتصفها الرأسي. القيمة 0 تجعل الحواف تتلامس؛ والقيم السالبة تتداخل.
settings-selector-skew-label = الميل
settings-selector-edge-tilt-label = ميل الحواف
settings-selector-edge-tilt-desc = يميل الحافتين العلوية والسفلية. القيم الموجبة ترفع الحافة اليمنى؛ والسالبة ترفع الحافة اليسرى.
settings-selector-wobble-label = التمايل
settings-selector-wobble-desc = تنحني البطاقات في اتجاه التمرير وترتد عند توقفه. الحركة الأسرع تفصل قنوات الألوان أيضًا.
settings-selector-wobble-strength-label = قوة التمايل
settings-selector-wobble-strength-desc = القيمة 100 هي الافتراضية. القيمة 200 تضاعف الانحناء وفصل الألوان.
settings-selector-corners-card = الزوايا
settings-selector-card-flip-card = قلب البطاقة
settings-selector-card-flip-card-desc = اختر كيف تنتقل بطاقة الخلفية من مصغّرتها إلى التفاصيل على ظهرها.
settings-selector-flip-effect-label = التأثير
settings-selector-flip-effect-desc = مظلّل المصغّرة المستخدم في المرحلة الأولى.
settings-selector-flip-shader-label = مظلّل المصغّرة
settings-selector-flip-shader-desc = أوقفه لتخطي تأثير المصغّرة وكشف الظهر مباشرة.
settings-selector-flip-back-label = كشف الظهر
settings-selector-flip-back-desc = أوقفه لإظهار اللوحة الخلفية فورًا بعد انتهاء تأثير المصغّرة.
settings-selector-flip-duration-label = تجاوز المدة
settings-selector-flip-duration-desc = الوقت الكلي لقلب البطاقة. يتجاوز عمدًا أوزان حركة الواجهة المشتركة.
settings-selector-tag-cloud-card = البحث
settings-selector-tag-cloud-card-desc = لوحة البحث بالوسوم والوصف التي تنسدل أسفل المنتقي.
settings-selector-tag-cloud-width-label = العرض
settings-selector-tag-cloud-width-desc = عرض لوحة البحث.
settings-selector-tag-cloud-rows-label = صفوف الوسوم القابلة للنقر
settings-selector-tag-cloud-rows-desc = عدد صفوف الاقتراحات القابلة للنقر التي تُفتح أسفل حقل البحث.
settings-selector-tag-cloud-rows-one = صف واحد
settings-selector-tag-cloud-rows-two = صفان
settings-selector-tag-cloud-rows-three = ثلاثة صفوف
settings-selector-video-preview-card = معاينة الفيديو
settings-selector-video-preview-card-desc = معاينة متحركة عند التحويم فوق فيديو أو تحديده.
settings-selector-video-preview-label = تفعيل معاينة الفيديو
settings-selector-video-preview-desc = يحرّك الفيديو نفسه عند التحويم/التحديد بدل مصغّرة ثابتة.
settings-selector-preview-delay-label = تأخير المعاينة
settings-selector-preview-delay-desc = ينتظر هذه المدة عند التحويم/التحديد قبل بدء المعاينة (ms).
settings-selector-tag-cloud-position-card = موضع لوحة البحث
settings-selector-tag-cloud-position-card-desc = حرّك لوحة البحث أفقيًا أو رأسيًا بالبكسل. الإزاحات الأفقية الموجبة تحرّكها يمينًا؛ والرأسية الموجبة تحرّكها لأسفل.
settings-selector-tag-position-enabled-label = استخدام موضع الشاشة
settings-selector-tag-position-enabled-desc = يُبقي لوحة البحث عند إحداثيات الشاشة هذه عندما يتغير حجمها أو نمط المنتقي. أوقفه لاستخدام الإزاحات بالبكسل.
settings-selector-tag-position-x-label = الحافة اليسرى
settings-selector-tag-position-x-desc = حدّد الحافة اليسرى للوحة البحث كنسبة مئوية من عرض الشاشة.
settings-selector-tag-position-y-label = الحافة العلوية
settings-selector-tag-position-y-desc = حدّد الحافة العلوية للوحة البحث كنسبة مئوية من ارتفاع الشاشة.
settings-selector-tag-offset-x-label = الإزاحة الأفقية للوحة البحث
settings-selector-tag-offset-x-desc = يحرّك لوحة البحث يسارًا أو يمينًا نسبةً إلى هذا المنتقي.
settings-selector-tag-offset-y-label = الإزاحة الرأسية للوحة البحث
settings-selector-tag-offset-y-desc = يحرّك لوحة البحث لأعلى أو لأسفل نسبةً إلى هذا المنتقي.
settings-selector-mode-slices = الشرائح
settings-selector-mode-hex = هندسي
settings-selector-mode-wall = الجدار
settings-selector-mode-sandy = رملي
settings-selector-gpu-tier-discrete = منفصل
settings-selector-gpu-tier-integrated = مدمج
settings-selector-gpu-tier-other = آخر
settings-selector-swap-style-vortex = دوّامة
settings-selector-swap-style-hourglass = ساعة رملية
settings-selector-swap-style-castle = قلعة رملية
settings-selector-swap-style-saltation = قفز الرمل
settings-selector-swap-style-pour = صبّ من كأس
settings-selector-swap-style-orbit = الدوّامة الكبرى
settings-selector-swap-style-burst = انفجار
settings-selector-swap-style-weave = نسيج
settings-selector-swap-style-bloom = تفتّح
settings-selector-swap-style-flock = سرب
settings-selector-swap-style-ring = حلقة

settings-selector-mode-hand = يد أوراق
settings-selector-hand-card = يد أوراق
settings-selector-hand-card-desc = مروحة من بطاقات طويلة مُمسكة كيد من أوراق اللعب بمنظور. حرّك المؤشر لإمالة اليد، واسحب المسرح لتدويرها، ومرّر إلى ما بعد الحافة لتوزيع اليد التالية.
settings-selector-hand-move-label = حركة التوزيع
settings-selector-hand-move-desc = كيف تطير البطاقات خارجًا وتدخل اليد التالية. «تعاقب» يمرّ على الحركات المفعّلة بالترتيب؛ و«عشوائي» يختار واحدة منها في كل توزيع. أوقف حركات أدناه لاستبعادها.
settings-selector-hand-move-random = عشوائي
settings-selector-hand-move-cycle = تعاقب
settings-selector-hand-move-corkscrew = لولب
settings-selector-hand-move-cascade = شلال
settings-selector-hand-move-shuffle = خلط
settings-selector-hand-move-ribbon = شريط
settings-selector-hand-move-spiral = حلزون
settings-selector-hand-count-label = البطاقات في اليد
settings-selector-hand-count-desc = البطاقات المعروضة في آن واحد، من 3 إلى 9.
settings-selector-hand-card-width-label = عرض البطاقة
settings-selector-hand-card-height-label = ارتفاع البطاقة
settings-selector-hand-spread-label = انتشار المروحة
settings-selector-hand-spread-desc = المسافة الأفقية بين البطاقات المتجاورة. الأحجام بكسلات تصميم على مسرح 1440 x 900 وتتغير مع مقياس الشاشة.
settings-selector-hand-perspective-label = المنظور
settings-selector-hand-perspective-desc = بُعد الكاميرا. القيم الأقل تبالغ في العمق.
settings-selector-hand-tilt-label = الإمالة بالمؤشر
settings-selector-hand-tilt-desc = مدى ميل اليد كلها نحو المؤشر. 0 يعطّل الإمالة.
settings-selector-hand-speed-label = السرعة
settings-selector-hand-speed-desc = سرعة التوزيع والقلب، 100 = الافتراضي.
settings-selector-ribbons-card = الأشرطة
settings-selector-ribbons-card-desc = تُقطع كل بطاقة إلى أشرطة تنفتح واحدًا تلو الآخر عند قلب البطاقة، وتتطاير متفرقة في توزيع الشريط.
settings-selector-hand-ribbon-axis-label = اتجاه القطع
settings-selector-hand-ribbon-axis-rows = صفوف
settings-selector-hand-ribbon-axis-columns = أعمدة
settings-selector-hand-ribbons-label = الأشرطة
settings-selector-hand-ribbons-desc = عدد الأشرطة لكل بطاقة، من 2 إلى 14.
settings-selector-hand-cut-label = زاوية القطع
settings-selector-hand-cut-straight = مستقيم
settings-selector-hand-cut-slant = مائل
settings-selector-hand-cut-steep = حاد
settings-selector-hand-cut-variance-label = تباين القطع
settings-selector-hand-cut-variance-desc = يجعل عرض الأشرطة وزواياها عشوائية في كل بطاقة.
settings-selector-hand-cut-variance-none = متساوٍ
settings-selector-hand-cut-variance-soft = خفيف
settings-selector-hand-cut-variance-wild = جامح
settings-selector-hand-effects-card = الأجواء
settings-selector-hand-effects-card-desc = طبقات اختيارية حول اليد.
settings-selector-hand-ghosts-label = أثر شبحي
settings-selector-hand-ghosts-desc = نسخ مموّهة وأكثر إشراقًا تتبع كل بطاقة أثناء التوزيع.
settings-selector-hand-backdrop-label = خلفية مموّهة
settings-selector-hand-backdrop-desc = يملأ الشاشة بنسخة داكنة مموّهة من الخلفية المحددة وراء اليد.
settings-selector-hand-bob-label = تمايل الخمول
settings-selector-hand-bob-desc = تتمايل البطاقات بلطف ما دام المنتقي مفتوحًا. يبقي هذا المنتقي متحركًا، فيستهلك وقت GPU أثناء الخمول.
settings-selector-hand-fan-angle-label = زاوية المروحة
settings-selector-hand-fan-angle-desc = انعطاف يُضاف لكل بطاقة بعيدًا عن المركز. 0 يبقي كل بطاقة مواجهة لك.
settings-selector-hand-fan-roll-label = دوران المروحة
settings-selector-hand-fan-roll-desc = ميل يُضاف لكل بطاقة، كأوراق مفرودة في اليد. 0 يبقيها منتصبة.
settings-selector-hand-arch-label = التقوّس
settings-selector-hand-arch-desc = مدى انخفاض البطاقات الخارجية عن البطاقة الوسطى.
settings-selector-hand-skew-label = الميل
settings-selector-hand-skew-desc = يحرف حدود البطاقة إلى متوازي أضلاع، ببكسلات الإزاحة الأفقية.
settings-selector-hand-backdrop-blur-label = تمويه الخلفية
settings-selector-hand-backdrop-blur-desc = نصف قطر تمويه الخلفية، 100 = الافتراضي.
settings-selector-hand-reveal-fill-label = المعاينة تملأ الإطار
settings-selector-hand-reveal-fill-desc = عند قلب اليد إلى المعاينة، تتمدد البطاقات لتكوّن صورة بالحجم الكامل. عند الإيقاف تحتفظ كل بطاقة بعرضها وارتفاعها ويُغيَّر حجم الصف ليتسع.

settings-selector-start-position-label = موضع البداية
settings-selector-start-position-desc = يفتح عند البداية، أو عند آخر خلفية طبّقتها، أو حيث توقفت عن التصفح. يستخدم عوامل التصفية الحالية.
settings-selector-start-position-beginning = البداية
settings-selector-start-position-applied = آخر خلفية مطبّقة
settings-selector-start-position-browsing = آخر موضع تصفح
settings-selector-loop-around-label = الالتفاف عند الطرفين
settings-selector-loop-around-desc = التحرك بعد أول خلفية أو آخر خلفية ينقل التحديد إلى الطرف الآخر. المفاتيح المضغوط عليها باستمرار والتنقل بالصفحات والتمرير السريع تتوقف عند الطرف أولًا، لذا اضغط أو مرّر مرة أخرى للالتفاف. المصادر عبر الإنترنت تلتف بعد تحميل كل الصفحات. في تخطيط Wall وفي المصادر عبر الإنترنت، عجلة الفأرة تمرّر العرض فقط.

settings-selector-mode-depth = العمق
settings-selector-depth-card = بطاقات العمق
settings-selector-depth-desc = تصغر البطاقات باتجاه الحواف. أثناء التمرير تنزاح الصورة داخل كل بطاقة بحسب موضعها في الصف.

settings-selector-parallax-label = تأثير المنظور للصورة
settings-selector-parallax-desc = أزِح الصورة داخل كل بطاقة أثناء تحركها عبر العرض. تواصل الصورة الحركة عبر الحواف المرئية.
settings-selector-mode-collection = المجموعة
settings-selector-collection-desc = تصفح رزمة مائلة بعجلة الفأرة أو مفاتيح الأسهم. انقر على بطاقة لتكبيرها؛ انقر مجددًا أو اضغط Escape للعودة. اضغط Enter للتطبيق. انقر بزر الفأرة الأيمن للتفاصيل.

settings-selector-depth-height-label = ارتفاع البطاقة
settings-selector-depth-height-desc = ارتفاع البطاقة المركزية. تصغر البطاقات الكبيرة لتناسب الشاشة.

settings-selector-depth-width-label = عرض البطاقة
settings-selector-depth-width-desc = عرض البطاقة المركزية بالبكسل.

settings-selector-depth-spacing-label = تباعد البطاقات
settings-selector-depth-spacing-desc = المسافة بين مراكز البطاقات بالبكسل قبل تدرّج العمق.

settings-selector-depth-count-label = البطاقات المرئية
settings-selector-depth-count-desc = أقصى عدد من البطاقات حول التحديد الحالي.

settings-selector-depth-falloff-label = تدرّج العمق
settings-selector-depth-falloff-desc = مقدار تصغير الحجم لكل بطاقة أبعد عن المركز، من 0 إلى 1. الصفر يُبقي الأحجام متساوية.


settings-selector-depth-skew-label = إمالة البطاقة
settings-selector-depth-skew-desc = إمالة حواف البطاقات. الصفر يُبقيها عمودية.

settings-selector-depth-speed-label = مدة التنقل
settings-selector-depth-speed-desc = مدة حركة التنقل بالميلي ثانية. القيم الأقل أسرع.

settings-selector-collection-size-label = حجم البطاقة
settings-selector-collection-size-desc = عرض البطاقة كنسبة مئوية من ارتفاع الشاشة.

settings-selector-collection-spacing-label = تباعد الكومة
settings-selector-collection-spacing-desc = المسافة الرأسية بين البطاقات المتراصة كنسبة مئوية من حجم البطاقة.

settings-selector-collection-count-label = البطاقات المرئية
settings-selector-collection-count-desc = أقصى عدد من البطاقات في الكومة.

settings-selector-collection-tilt-label = ميل الكومة
settings-selector-collection-tilt-desc = أمِل الكومة بعيدًا عنك. الصفر يعرض البطاقات من الأمام.


settings-selector-collection-speed-label = سرعة الحركة
settings-selector-collection-speed-desc = سرعة التنقل وسرعة فتح البطاقة أو إغلاقها. القيم الأعلى أسرع.

settings-selector-depth-frame-label = إطار التحديد
settings-selector-depth-frame-desc = ارسم حدًا مميزًا حول البطاقة المحددة.

settings-selector-shadows-label = ظلال البطاقات
settings-selector-shadows-desc = ارسم ظلًا خلف كل بطاقة.
