settings-wallpapers-displays-say = { $state ->
        [none] لا توجد شاشة مقفلة.
        [one] { $names } مقفلة.
        [some] { $names } مقفلة.
       *[detecting] جارٍ اكتشاف الشاشات.
    } الشاشات بلا موضع خاص تستخدم { $fill }.
settings-wallpapers-play-say = الصور تستخدم { $backend }، والفيديو { $val }Vulkan{ $end }، على طبقة { $layer }.
settings-wallpapers-transitions-say = عائلة { $family }{ $kind ->
        [random] ، واحد مختلف كل مرة، خلال { $duration }.
        [preset] ، باستخدام { $shader }، خلال { $ms } مللي ثانية.
       *[shader] ، باستخدام { $shader }، خلال { $duration }.
    } المعدل { $rate }.
settings-wallpapers-primary-count = { $state ->
        [none] ولا واحد من { $all }
        [all] كل الـ { $all }
       *[some] { $shown } من { $all }
    }
settings-wallpapers-awww-say = الصور تعرض { $type } بمرشح { $filter }، خلال { $duration }.
settings-wallpapers-drawing-say = { $state ->
        [on] الخلفيات المُعدة تُرسم خلال { $duration }.
       *[off] معطل. البطاقات المضبوطة على الرسم تُرسم خلال { $duration }.
    }
settings-wallpapers-sound-say = يعمل صوت الخلفيات عند { $volume }{ $duck ->
        [yes] { " " }ويتوقف عندما تصدر تطبيقات أخرى صوتًا.
       *[no] .
    }
settings-wallpapers-pause-say = يتوقف مع { $rules } على { $scope }{ $apps ->
        [yes] ، وللتطبيقات المدرجة.
       *[no] .
    }
settings-wallpapers-pause-rules = { $count } قواعد للنوافذ
settings-wallpapers-plasma-say = { $state ->
        [off] شاشة القفل { $mode }.
        [static] شاشة القفل { $mode }: { $image }.
       *[follow] شاشة القفل { $mode }، والمشاهد { $scenes ->
        [live] بعرض حي.
       *[poster] كإطار ملصق.
    }
    }
settings-wallpapers-niri-say = تعرض { $source ->
       *[current] الخلفية الحالية
        [own] مصدرها الخاص
        [stationary] خلفية ثابتة
    }{ $blur ->
        [yes] ، مموهة
       *[no] { "" }
    }، معتمة { $dim }{ $auto ->
        [yes] ، بألوان جديدة
       *[no] { "" }
    }.
settings-wallpapers-device-hint = «تلقائي» يجرّب CUDA ثم WebGPU ثم CPU
settings-wallpapers-memory-hint = عند تجاوز الحد يعيد «تلقائي» المحاولة على CPU
