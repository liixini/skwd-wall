settings-paper-awww-type-simple = بسيط
settings-paper-awww-type-fade = تلاشٍ
settings-paper-awww-type-wipe = مسح
settings-paper-awww-type-wave = موجة
settings-paper-awww-type-grow = نمو
settings-paper-awww-type-center = المنتصف
settings-paper-awww-type-outer = الخارج
settings-paper-awww-type-left = يسار
settings-paper-awww-type-right = يمين
