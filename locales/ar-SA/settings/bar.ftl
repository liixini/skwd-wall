settings-bar-filter = شريط التصفية
settings-bar-filter-desc = صف أزرار النوع والترتيب والتصفية فوق المنتقي.
settings-bar-filter-say = يعرض { $val }{ $buttons }{ $end } و{ $val }{ $sorts }{ $end } مرتبة { $orientation ->
        [vertical] عموديًا
       *[horizontal] أفقيًا
    }. { $pinned ->
        [yes] يبقى مثبتًا.
       *[no] يختفي حتى تحتاج إليه.
    } النمط المرئي: { $style }.
settings-bar-button-count = { $shown } من أصل { $all } { $all ->
        [zero] زر
        [one] زر
        [two] زر
        [few] أزرار
        [many] زرًا
       *[other] زر
    }
settings-bar-sort-count = { $shown } من أصل { $all } { $all ->
        [zero] ترتيب
        [one] ترتيب
        [two] ترتيب
        [few] ترتيبات
        [many] ترتيبًا
       *[other] ترتيب
    }
settings-bar-offers = ما يقدّمه
settings-bar-behaves = كيف يتصرف
settings-bar-buttons = أزرار الشريط
settings-bar-pinned-hint = مثبت بدل الإخفاء التلقائي
settings-bar-placed = يُضبط موضع الشريط في التخطيط.
settings-bar-sizes = نطاقات الحجم
settings-bar-sizes-desc = نطاقات الدقة التي يصفّي بها زر «الحجم».
settings-bar-sizes-say = يقدّم زر «الحجم» { $bands }.
settings-bar-sizes-none = لا توجد نطاقات حجم بعد، لذا لا يقدّم زر «الحجم» شيئًا.
settings-bar-unnamed = بلا اسم
settings-bar-from = من
settings-bar-up-to = حتى
settings-bar-no-limit = بلا حد أعلى
settings-bar-add-hint = نطاق جاهز أو نطاق مخصص
settings-bar-start = من أين يبدأ المنتقي
settings-bar-start-desc = المجلد المعروض عند فتح المنتقي.
settings-bar-start-say = يفتح المنتقي على { $folder } و{ $sticky ->
        [yes] يحتفظ بعوامل التصفية بعد إغلاقه.
       *[no] يعيد ضبط عوامل التصفية في كل مرة يُفتح فيها.
    }
settings-bar-sticky-hint = الاحتفاظ بتصفية النوع والمجلد واللون والترتيب والمفضلة بعد إغلاق المنتقي
settings-bar-search-desc = تطابق الوسوم الكلمات المحفوظة. «وصف» يجد الصور من وصف قصير.
settings-bar-search-say = يفتح البحث على { $mode ->
        [describe] «وصف»
       *[tags] الوسوم
    }. يستخدم البحث بالوصف { $model } على { $views ->
        [multiview] التكوين والاقتصاصات
       *[full] الصورة كاملة
    }.
settings-bar-search-off = يفتح البحث على { $mode ->
        [describe] «وصف»
       *[tags] الوسوم
    }. البحث بالوصف متوقف: لا يُحمَّل أي نموذج ولا تتم فهرسة شيء. الوسوم تبقى متاحة.
settings-bar-model-status = { " " }حالة النموذج: { $val }{ $status }{ $end }.
settings-bar-searching = البحث
settings-bar-unused = غير مستخدم
settings-bar-name-hint = يظهر في قائمة النماذج النشطة
settings-bar-manual-hint = الإشارة إلى حزمة في مكانها
settings-bar-forget-hint = تبقى الملفات
settings-bar-delete-hint = يوقف البحث الدلالي أيضًا
settings-menu-choose = اختر
settings-checks-count = { $shown } من { $all }
settings-bar-floats-hint = ضعه من الترتيب
settings-bar-delete-named = حذف { $name }
settings-bar-forget-named = نسيان { $name }
