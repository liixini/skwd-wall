settings-bar-filter = Barra de filtros
settings-bar-filter-desc = A faixa de botões de tipo, ordenação e filtro acima do seletor.
settings-bar-filter-say = Mostra { $val }{ $buttons }{ $end } e { $val }{ $sorts }{ $end }, na disposição { $orientation ->
        [vertical] vertical
       *[horizontal] horizontal
    }. { $pinned ->
        [yes] Ela fica sempre fixa.
       *[no] Ela se oculta até você precisar.
    } Estilo visual: { $style }.
settings-bar-button-count = { $shown } de { $all } { $all ->
        [one] botão
       *[other] botões
    }
settings-bar-sort-count = { $shown } de { $all } { $all ->
        [one] ordenação
       *[other] ordenações
    }
settings-bar-offers = O que oferece
settings-bar-behaves = Como se comporta
settings-bar-buttons = Botões da barra
settings-bar-pinned-hint = Fixa em vez de se ocultar sozinha
settings-bar-placed = Onde a barra fica é ajustado em Layout.
settings-bar-sizes = Faixas de tamanho
settings-bar-sizes-desc = Faixas de resolução usadas pelo botão Tamanho.
settings-bar-sizes-say = O botão Tamanho oferece { $bands }.
settings-bar-sizes-none = Ainda não há faixas de tamanho, então o botão Tamanho não tem nada a oferecer.
settings-bar-unnamed = sem nome
settings-bar-from = de
settings-bar-up-to = até
settings-bar-no-limit = sem limite superior
settings-bar-add-hint = Uma faixa pronta ou personalizada
settings-bar-start = Onde o seletor começa
settings-bar-start-desc = A pasta mostrada quando o seletor abre.
settings-bar-start-say = O seletor abre em { $folder } e { $sticky ->
        [yes] mantém seus filtros depois de fechar.
       *[no] redefine seus filtros sempre que abre.
    }
settings-bar-sticky-hint = Mantém filtros de tipo, pasta, cor, ordenação e favoritos depois que o seletor fecha
settings-bar-search-desc = Tags busca palavras salvas. Descrever encontra imagens a partir de uma descrição curta.
settings-bar-search-say = A busca abre com { $mode ->
        [describe] Descrever
       *[tags] Tags
    }. A busca Descrever usa { $model } na { $views ->
        [multiview] composição e recortes
       *[full] imagem inteira
    }.
settings-bar-search-off = A busca abre com { $mode ->
        [describe] Descrever
       *[tags] Tags
    }. A busca Descrever está desligada: nenhum modelo é carregado e nada é indexado. As tags continuam funcionando.
settings-bar-model-status = { " " }Status do modelo: { $val }{ $status }{ $end }.
settings-bar-searching = Busca
settings-bar-unused = Fora de uso
settings-bar-name-hint = Mostrado na lista de modelos ativos
settings-bar-manual-hint = Referencia um pacote onde ele está
settings-bar-forget-hint = Mantém os arquivos
settings-bar-delete-hint = Também desliga a busca semântica
settings-menu-choose = Escolher
settings-checks-count = { $shown } de { $all }
settings-bar-floats-hint = Posicione em Organizar
settings-bar-delete-named = Excluir { $name }
settings-bar-forget-named = Esquecer { $name }
