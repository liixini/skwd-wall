settings-bar-filter = 筛选栏
settings-bar-filter-desc = 选择器上方由类型、排序和筛选按钮组成的一栏。
settings-bar-filter-say = 显示{ $val }{ $buttons }{ $end }和{ $val }{ $sorts }{ $end }，{ $orientation ->
        [vertical] 纵向
       *[horizontal] 横向
    }排列。{ $pinned ->
        [yes] 它始终固定显示。
       *[no] 需要时才会出现。
    }视觉样式：{ $style }。
settings-bar-button-count = { $all } 个按钮中的 { $shown } 个
settings-bar-sort-count = { $all } 种排序中的 { $shown } 种
settings-bar-offers = 提供的内容
settings-bar-behaves = 显示方式
settings-bar-buttons = 栏中的按钮
settings-bar-pinned-hint = 固定显示而不是自动隐藏
settings-bar-placed = 筛选栏的位置在“布局”中设置。
settings-bar-sizes = 尺寸范围
settings-bar-sizes-desc = “尺寸”按钮用来筛选的分辨率范围。
settings-bar-sizes-say = “尺寸”按钮提供 { $bands }。
settings-bar-sizes-none = 还没有尺寸范围，所以“尺寸”按钮没有可选项。
settings-bar-unnamed = 未命名
settings-bar-from = 从
settings-bar-up-to = 到
settings-bar-no-limit = 无上限
settings-bar-add-hint = 现成范围或自定义范围
settings-bar-start = 选择器从哪里开始
settings-bar-start-desc = 打开选择器时显示的文件夹。
settings-bar-start-say = 选择器打开时显示 { $folder }，并且{ $sticky ->
        [yes] 关闭后保留你的筛选。
       *[no] 每次打开都会重置你的筛选。
    }
settings-bar-sticky-hint = 选择器关闭后保留类型、文件夹、颜色、排序和收藏筛选
settings-bar-search-desc = 标签匹配保存的词语。描述根据简短描述查找图片。
settings-bar-search-say = 搜索默认使用{ $mode ->
        [describe] 描述
       *[tags] 标签
    }。描述搜索在{ $views ->
        [multiview] 构图和裁切
       *[full] 完整图片
    }上使用 { $model }。
settings-bar-search-off = 搜索默认使用{ $mode ->
        [describe] 描述
       *[tags] 标签
    }。描述搜索已关闭：不加载模型，也不建立索引。标签仍可使用。
settings-bar-model-status = 模型状态：{ $val }{ $status }{ $end }。
settings-bar-searching = 搜索
settings-bar-unused = 未使用
settings-bar-name-hint = 显示在活动模型列表中
settings-bar-manual-hint = 直接引用原位置的模型包
settings-bar-forget-hint = 保留文件
settings-bar-delete-hint = 同时关闭语义搜索
settings-menu-choose = 选择
settings-checks-count = { $shown }/{ $all }
settings-bar-floats-hint = 在排列中摆放
settings-bar-delete-named = 删除 { $name }
settings-bar-forget-named = 移除 { $name }
