settings-matugen-external-card = Matugen خارجی
settings-matugen-external-card-desc = وقتی Matugen رنگ‌های کاغذدیواری را می‌سازد، پیکربندی خارجی خود را اجرا کنید.
settings-matugen-config-label = مسیر پیکربندی
settings-matugen-config-desc = مسیر فایل پیکربندی خارجی matugen.
settings-matugen-command-label = فرمان
settings-matugen-command-desc = فرمان اجرای Matugen. می‌توانید %config%، %path%، %scheme%، %mode% و %index% را به‌عنوان جای‌نگهدار بگذارید.
settings-matugen-integrations-card = یکپارچه‌سازی‌ها
settings-matugen-integrations-card-desc = هر ورودی یک الگو را در یک فایل خروجی تولید می‌کند. پس از نوشتن فایل می‌توان فرمان بازخوانی اجرا کرد.
settings-matugen-name-label = نام
settings-matugen-name-desc = شناسهٔ ثابت این یکپارچه‌سازی.
settings-matugen-template-label = الگو
settings-matugen-template-desc = قالب مورد استفاده برای تولید رنگ‌های برنامه.
settings-matugen-output-label = خروجی
settings-matugen-output-desc = مسیر نوشتن خروجی ساخته‌شده.
settings-matugen-reload-label = بازخوانی
settings-matugen-reload-desc = فرمان پوستهٔ اختیاری که پس از نوشتن خروجی اجرا می‌شود.
settings-matugen-live-preview-label = پیش‌نمایش زنده
settings-matugen-live-preview-desc = هنگام نگه‌داشتن نشانگر روی کاغذدیواری‌ها، رنگ Wall را تغییر دهید. برای تغییر رنگ فقط پس از اعمال کاغذدیواری، خاموش کنید.
settings-matugen-remove-desc = این ورودی را حذف کنید.
settings-matugen-remove-action = حذف
settings-matugen-add-label = افزودن یکپارچه‌سازی
settings-matugen-add-desc = یکپارچه‌سازی خالی اضافه کنید، سپس الگو، فایل خروجی و فرمان بازخوانی اختیاری آن را تعیین کنید.
settings-matugen-add-action = افزودن

settings-app-themes-title = پوسته‌های برنامه‌ها
settings-app-themes-desc = انتخاب کنید کدام برنامه‌ها از رنگ‌های شما پیروی کنند. خاموش کردن برنامه، پیکربندی پوستهٔ قبلی آن را بازمی‌گرداند.
settings-app-themes-custom = خروجی‌های سفارشی
settings-app-themes-custom-desc = الگوها، فایل‌های خروجی و فرمان‌های بازخوانی پیشرفته.
settings-app-themes-error = تنظیم پوستهٔ برنامه ناموفق بود: { $error }
settings-app-themes-scan = یافتن برنامه‌ها
settings-app-themes-scan-desc = پس از نصب برنامه یا تغییر پیکربندی آن، دوباره بررسی کنید.
settings-app-themes-loading = برای بررسی برنامه‌های نصب‌شده و تنظیم پوستهٔ آن‌ها به Deck وصل شوید.
settings-app-themes-refresh = بررسی دوباره
settings-app-themes-ready = آمادهٔ پیروی از رنگ‌های شما
settings-app-themes-not-installed = نصب نیست
settings-app-themes-conflict = یکپارچه‌سازی پوستهٔ دیگری تنظیم شده است
settings-app-themes-review = تنظیمات نیاز به بررسی دارند
settings-app-themes-changed = پیکربندی بیرون از Skwd تغییر کرده است
settings-app-themes-interrupted = تنظیمات نیمه‌تمام ماند
settings-app-themes-reload-needed = تازه‌سازی رنگ‌ها ممکن نشد
settings-app-themes-reload-sent = رنگ‌ها نوشته شدند · درخواست بازخوانی فرستاده شد
settings-app-themes-watching = رنگ‌ها نوشته شدند · برنامه تغییرات را پایش می‌کند
settings-app-themes-next-open = با باز شدن برنامه اعمال می‌شود
settings-app-themes-busy = در حال کار…
settings-app-themes-configured = پوسته تنظیم شد
settings-app-themes-installed = نصب‌شده
settings-app-themes-config-found = پیکربندی پیدا شد
settings-app-themes-config-create = در نخستین استفاده پیکربندی می‌سازد
settings-app-themes-on = روشن
settings-app-themes-off = خاموش
settings-app-themes-hide = پنهان کردن جزئیات
settings-app-themes-details = جزئیات
settings-app-themes-custom-conflict = این برنامه از خروجی سفارشی Skwd استفاده می‌کند که خودکار قابل جابه‌جایی نیست. پیش از خاموش کردن «اجرای خروجی سفارشی»، خروجی‌های پوسته را باز کنید و الگو، فایل خروجی و فرمان بازخوانی آن را بررسی کنید. برای ادامهٔ استفاده از آن، روشن بگذارید.
settings-app-themes-other-owner = ابزار پوستهٔ دیگری به این برنامه وصل است. پیش از فعال کردن Skwd، آن یکپارچه‌سازی را قطع کنید.
settings-app-themes-restore-desc = Skwd تنظیمات پوستهٔ قبلی را ذخیره می‌کند و فقط تنظیمات خودش را تغییر می‌دهد. تغییرات بعدی در تنظیمات نامرتبط حفظ می‌شوند.
settings-app-themes-config = پیکربندی برنامه
settings-app-themes-output = رنگ‌های ساخته‌شده
settings-app-themes-adopt = استفاده از پوستهٔ مدیریت‌شده
settings-app-themes-adopt-desc = خروجی سفارشی قدیمی ذخیره می‌ماند، اما دیگر اجرا نمی‌شود. Skwd نگاشت رنگ‌های مدیریت‌شده را اعمال می‌کند و می‌توانید آن‌ها را با الگوی قابل ویرایش تغییر دهید.
settings-app-themes-custom-enabled = اجرای خروجی سفارشی
settings-app-themes-custom-enabled-desc = با تغییر رنگ‌ها، این خروجی را بسازید و فرمان بازخوانی‌اش را اجرا کنید. پس از رفتن به پوستهٔ مدیریت‌شده، خاموش نگه دارید.
settings-app-themes-undo = واگردانی تنظیمات

settings-app-themes-applied = رنگ‌ها اعمال شدند
settings-app-themes-refresh-colours = تازه‌سازی رنگ‌ها
settings-app-themes-retry-reload = برنامه را باز کنید، سپس برای تلاش دوباره «تازه‌سازی رنگ‌ها» را انتخاب کنید.

settings-matugen-enabled-notice = رنگ‌های کاغذدیواری به Matugen تغییر یافت.
settings-matugen-disabled-notice = رنگ‌های کاغذدیواری به Iris داخلی تغییر یافت.

settings-app-themes-disconnected = قطع شد - رنگ‌های فعلی حفظ می‌شوند
settings-app-themes-template-desc = این الگو را ویرایش کنید تا تعیین شود هر بخش از کدام رنگ پالت استفاده کند. فایل را ذخیره کنید و سپس رنگ‌ها را تازه کنید. تغییر کاغذدیواری نگاشت‌های شما را حفظ می‌کند.
settings-app-themes-create-template = ساخت الگوی قابل ویرایش
settings-app-themes-copy-template = کپی مسیر الگو
settings-app-themes-reset-template = بازنشانی نگاشت‌ها به پیش‌فرض
settings-app-themes-disconnect = قطع اتصال و حفظ رنگ‌های فعلی
settings-app-themes-disconnect-desc = به‌روزرسانی این برنامه را متوقف کنید. فایل‌ها و رنگ‌های فعلی آن، از جمله ویرایش‌های شما، حفظ شوند.
settings-app-themes-reconnect = پشتیبان‌گیری از ویرایش‌ها و اتصال دوباره
settings-app-themes-reconnect-desc = از فایل‌های فعلی پشتیبان بگیرید، سپس نگاشت‌هایتان را اعمال کنید و به‌روزرسانی رنگ‌ها را ادامه دهید. ویرایش‌های مستقیم رنگ‌های ساخته‌شده جایگزین می‌شوند.

settings-app-themes-custom-output-status = یک خروجی سفارشی موجود Skwd به این برنامه پوسته می‌دهد
settings-app-themes-custom-switch = برای جابه‌جایی، «استفاده از پوستهٔ مدیریت‌شده» را در پایین انتخاب کنید؛ یا برای ادامهٔ استفاده از خروجی سفارشی، همین حالت را نگه دارید.
