settings-selector-layout-card = چیدمان
settings-selector-display-mode-label = حالت نمایش
settings-selector-display-mode-desc = نحوهٔ چیدن کارت‌های تصویر زمینه در انتخابگر را انتخاب کنید.
settings-selector-filter-motion-label = حرکت فیلتر
settings-selector-filter-motion-desc = سرعت گردش کارت‌ها هنگام تغییر نتایج فیلتر. سه ضریب مشترک در تنظیمات حرکت قرار دارند.
settings-selector-presets-card = پیش‌تنظیم‌ها
settings-selector-preset-generated-name = سبک { $number }
settings-selector-saved-styles-label = سبک‌های ذخیره‌شده
settings-selector-live-preview-card = پیش‌نمایش رنگ
settings-selector-live-preview-label = پیش‌نمایش پوسته با بردن نشانگر روی تصویر
settings-selector-live-preview-desc = رنگ انتخابگر را از تصویر زمینهٔ زیر نشانگر بگیرید. با دور شدن نشانگر، پوستهٔ فعلی برمی‌گردد، مگر اینکه تصویر را اعمال کنید.
settings-selector-type-badges-label = نمایش نشان نوع فایل
settings-selector-type-badges-desc = کارت‌های تصویر زمینه را با Pic، Vid یا WE مشخص کنید تا نوع فایل بدون باز کردن کارت دیده شود.
settings-selector-composition-card = ترکیب‌بندی
settings-selector-composition-card-desc-hex = شکل کلی میدان را انتخاب کنید، سپس خمیدگی، شکل کاشی‌ها، ردیف‌ها و ستون‌ها را تنظیم کنید.
settings-selector-composition-card-desc-wall = یک چیدمان دیواری انتخاب کنید، سپس تراکم، فاصله و کارت‌های آن را تنظیم کنید.
settings-selector-hex-curve-label = حالت هندسی
settings-selector-hex-curve-desc = انتخاب کنید که کل میدان تخت بماند یا به شکل کمان، موج، S یا استوانه خم شود.
settings-selector-hex-curve-flat = صفحه
settings-selector-hex-curve-arc = کمان
settings-selector-hex-curve-wave = نوار
settings-selector-hex-curve-s = منحنی S
settings-selector-hex-curve-cylinder = استوانه
settings-selector-hex-shape-label = شکل کاشی
settings-selector-hex-shape-desc = کاشی‌ای انتخاب کنید که سطح را بدون شکاف بپوشاند. لوزی عمودی و افقی، هر تصویر زمینه را در هندسه‌ای عمودی یا افقی قرار می‌دهند.
settings-selector-hex-shape-triangle = مثلث
settings-selector-hex-shape-hexagon = شش‌ضلعی
settings-selector-hex-shape-diamond = لوزی عمودی
settings-selector-hex-shape-rhombus = لوزی افقی
settings-selector-hex-intensity-label = شدت خمیدگی
settings-selector-hex-intensity-desc = برای خمیدگی بیشتر شکل انتخاب‌شده، به راست ببرید.
settings-selector-hex-waves-label = موج‌ها
settings-selector-hex-waves-desc = تعداد موج‌های نواری که از میدان می‌گذرند.
settings-selector-hex-orbit-radius-label = شعاع استوانه
settings-selector-hex-orbit-radius-desc = مقادیر کمتر، میدان را فشرده‌تر می‌پیچند.
settings-selector-hex-rows-label = ردیف‌ها
settings-selector-hex-cols-label = ستون‌ها
settings-selector-cells-card = خانه‌ها
settings-selector-cells-card-desc = اندازه و فاصلهٔ کاشی‌ها را بدون تغییر شکل انتخاب‌شدهٔ میدان تنظیم کنید.
settings-selector-hex-cell-size-label = اندازهٔ خانه
settings-selector-hex-gap-x-label = فاصلهٔ افقی
settings-selector-hex-gap-y-label = فاصلهٔ عمودی
settings-selector-wall-mode-label = حالت دیوار
settings-selector-wall-mode-desc = نحوهٔ چیدن کارت‌ها در حالت دیوار را انتخاب کنید. اندازهٔ ردیف‌ها و رفتار پیمایش در هر حالت متفاوت است.
settings-selector-wall-mode-uniform = یکنواخت
settings-selector-wall-mode-brick = آجری
settings-selector-wall-mode-masonry = بنایی
settings-selector-wall-mode-justified = هم‌تراز
settings-selector-wall-mode-editorial = مجله‌ای
settings-selector-wall-mode-cylinder = استوانه
settings-selector-grid-columns-label = ستون‌ها
settings-selector-grid-rows-label = ردیف‌ها
settings-selector-grid-stagger-label = تعادل
settings-selector-grid-stagger-desc = جابه‌جایی ردیف‌های یکی‌درمیان، یا اندازهٔ کارت اصلی در حالت مجله‌ای را تغییر دهید.
settings-selector-grid-bend-label = انحنا
settings-selector-grid-bend-desc = مقدار مثبت به سمت دور از شما می‌پیچد؛ مقدار منفی به سمت شما خم می‌شود.
settings-selector-grid-cylinder-radius-label = شعاع استوانه
settings-selector-grid-cylinder-radius-desc = مقادیر کمتر، پیچش را فشرده‌تر می‌کنند.
settings-selector-cards-card = کارت‌ها
settings-selector-cards-card-desc = اندازه، فاصله و شکل گوشه‌های کارت‌ها را تنظیم کنید.
settings-selector-card-width-label = عرض کارت
settings-selector-card-height-label = ارتفاع کارت
settings-selector-grid-gap-x-label = فاصلهٔ افقی
settings-selector-grid-gap-x-desc = فاصلهٔ قابل مشاهده بین لبه‌های ستون‌ها.
settings-selector-grid-gap-y-label = فاصلهٔ عمودی
settings-selector-grid-gap-y-desc = فاصلهٔ قابل مشاهده بین لبه‌های ردیف‌ها.
settings-selector-performance-card = کارایی
settings-selector-performance-card-desc = هر دانه هندسهٔ جداگانه‌ای دارد. دانه‌های بزرگ‌تر یعنی شکل‌های کمتر و کار بسیار کمتر برای GPU.
settings-selector-sand-note-discrete = این بار برای GPU مجزای شناسایی‌شده کم است. همین اندازهٔ دانه می‌تواند روی GPU یکپارچه حدود 150 برابر کندتر باشد.
settings-selector-sand-note-integrated = سرعت شن روی این GPU یکپارچه ممکن است به توان GPU محدود شود. اندازهٔ دانه را بیشتر کنید یا جزئیات خودکار حرکت را روشن نگه دارید.
settings-selector-sand-meter-label = { $count } دانه در هر فریم  ·  { $load }
settings-selector-sand-meter-desc = دانهٔ { $grain } در یک تصویر میانی معمولی · { $card } ({ $tier }) · { $note }
settings-selector-sand-load-very-heavy = بسیار سنگین
settings-selector-sand-load-heavy = سنگین
settings-selector-sand-load-moderate = متوسط
settings-selector-sand-load-light = سبک
settings-selector-grain-size-label = اندازهٔ دانه
settings-selector-grain-size-desc = اندازهٔ دانه به پیکسل. 1 یعنی یک دانه برای هر پیکسل تصویر و سنگین‌ترین حالت است؛ دانه‌های بزرگ‌تر درشت‌تر دیده می‌شوند ولی هزینهٔ بسیار کمتری دارند.
settings-selector-render-scale-label = مقیاس رندر
settings-selector-render-scale-desc = شن را با وضوح کمتر رندر و سپس بزرگ کنید. صرفه‌جویی آن از اندازهٔ دانه کمتر است، چون دانه‌ها هندسه هستند، نه پیکسل.
settings-selector-lod-auto-label = جزئیات خودکار حرکت
settings-selector-lod-auto-desc = هنگام پیمایش سریع، اندازهٔ دانه را بیشتر کنید. روی GPUهای یکپارچه به‌طور پیش‌فرض روشن است و هزینهٔ حرکت را حدود 3.5 برابر کاهش می‌دهد.
settings-selector-lod-strength-label = شدت کاهش جزئیات حرکت
settings-selector-lod-strength-desc = بیشترین ضریب اندازهٔ دانه در حداکثر سرعت پیمایش، هنگام فعال بودن جزئیات حرکت.
settings-selector-sandy-card = شنی
settings-selector-sandy-card-desc = تصویر زمینهٔ فعلی در مرکز، بالای ردیفی از بندانگشتی‌های گرد قرار می‌گیرد. با انتخاب تصویری دیگر، هر دو تصویر به دانه‌هایی تبدیل می‌شوند که از لبه‌های مخالف خارج و وارد می‌شوند.
settings-selector-sandy-center-label = ارتفاع مرکز
settings-selector-sandy-slice-height-label = ارتفاع برش
settings-selector-sandy-slice-width-label = عرض برش
settings-selector-sandy-gap-label = فاصله
settings-selector-sandy-gap-desc = فاصلهٔ برش‌های مورب در نقطهٔ میانی ارتفاعشان. 0 لبه‌ها را به هم می‌چسباند؛ مقادیر منفی باعث هم‌پوشانی می‌شوند.
settings-selector-sandy-skew-label = کجی
settings-selector-sandy-edge-speed-label = پیمایش لبه
settings-selector-sandy-edge-speed-desc = سرعت حرکت گردونه در لبه‌های صفحه؛ 100 = پیش‌فرض.
settings-selector-sand-card = شن
settings-selector-sand-card-desc = نحوهٔ حرکت دانه‌ها. همهٔ مقادیر درصد هستند؛ 100 = پیش‌فرض.
settings-selector-sandy-duration-label = مدت
settings-selector-sandy-duration-desc = کل زمان از شروع خروج تصویر قدیمی تا کامل شدن تصویر جدید.
settings-selector-sandy-blend-label = آمیختگی
settings-selector-sandy-blend-desc = طول جاروب رنگ؛ محوشدن حلقه با نصف این مقدار انجام می‌شود.
settings-selector-sandy-strands-label = نوارها
settings-selector-sandy-strands-desc = دانه‌ها را به جریان‌های قابل مشاهدهٔ بیشتر یا کمتری تقسیم کنید.
settings-selector-sandy-twist-label = پیچش
settings-selector-sandy-twist-desc = شدت پیچش مارپیچی در امتداد هر نوار.
settings-selector-sandy-orbit-label = مدار
settings-selector-sandy-orbit-desc = پهنای گردش مارپیچی دانه‌ها دور نوارشان.
settings-selector-sandy-turbulence-label = آشفتگی
settings-selector-sandy-turbulence-desc = پیچش تصادفی مسیر نوارها.
settings-selector-sandy-waist-label = گلوگاه
settings-selector-sandy-waist-desc = باریک شدن جریان‌ها در میانهٔ پرواز؛ کمتر = گلوگاه باریک‌تر.
settings-selector-sandy-front-label = جبههٔ خروج
settings-selector-sandy-front-desc = زمان خروج بخش‌های مختلف تصویر قدیمی را از هم جدا کنید. مقادیر بیشتر، بخش‌های بعدی را مدت بیشتری در جای خود نگه می‌دارند.
settings-selector-sandy-fan-label = گسترش
settings-selector-sandy-fan-desc = میزان پخش جریان در لبه‌ها، یا چرخش در حالت گرداب.
settings-selector-swap-style-label = سبک تعویض
settings-selector-swap-style-desc = مسیری را انتخاب کنید که دانه‌ها بین تصویر قدیمی و جدید طی می‌کنند.
settings-selector-sandy-arc-label = کمان
settings-selector-sandy-arc-desc = اندازهٔ حلقه هنگام فعال بودن تعویض حلقه‌ای از گوشه.
settings-selector-swap-loop-label = تعویض حلقه‌ای از گوشه
settings-selector-swap-loop-desc = اگر انتخاب تازه‌ای گذار را قطع کند، دانه‌ها به‌جای رفتن به حلقهٔ چرخان، از گوشهٔ بالایی حلقه می‌زنند.
settings-selector-outgoing-live-label = ویدیوی خروجی به پخش ادامه دهد
settings-selector-outgoing-live-desc = ویدیوی قدیمی هنگام تبدیل شدن به شن همچنان پخش شود. تعویض ویدیو با ویدیو تا پایان گذار رمزگشای دومی اجرا می‌کند؛ حالت خاموش، یک فریم ثابت را بدون هزینهٔ اضافه نگه می‌دارد.
settings-selector-ring-card = حلقه
settings-selector-ring-card-desc = این تنظیمات حلقهٔ چرخان دانه‌ها را کنترل می‌کنند که هنگام مرور سریع تصاویر زمینه دیده می‌شود. مقدار پیش‌فرض 100 است.
settings-selector-ring-size-label = اندازه
settings-selector-ring-size-desc = قطر مدار نسبت به تصویر اصلی. حلقه همچنان نسبت ابعاد تصویر اصلی را حفظ می‌کند؛ 100 اندازهٔ طراحی‌شده را نگه می‌دارد.
settings-selector-ring-spin-label = چرخش
settings-selector-ring-spin-desc = سرعت گردش نوار در مدار.
settings-selector-ring-wave-label = موج
settings-selector-ring-wave-desc = میزان موج شعاعی که در نوار جریان دارد.
settings-selector-ring-soft-label = نرمی
settings-selector-ring-soft-desc = مقادیر بیشتر از دانه‌های بزرگ‌تر و کم‌رنگ‌تر استفاده می‌کنند و حلقه را کم‌وضوح‌تر نشان می‌دهند.
settings-selector-ring-blend-label = آمیختگی حلقه
settings-selector-ring-blend-desc = طول جاروب رنگ در حالت حلقه‌ای.
settings-selector-ring-hold-label = تأخیر آرام گرفتن
settings-selector-ring-hold-desc = زمان انتظار پس از آخرین انتخاب تا تبدیل حلقه به تصویر اصلی.
settings-selector-slice-size-card = اندازهٔ برش
settings-selector-slice-height-label = ارتفاع برش
settings-selector-visible-count-label = موارد قابل مشاهده
settings-selector-expanded-width-label = عرض مورد انتخاب‌شده
settings-selector-slice-width-label = عرض برش
settings-selector-slice-gap-label = فاصله
settings-selector-slice-gap-desc = فاصلهٔ برش‌های مورب در نقطهٔ میانی ارتفاعشان. 0 لبه‌ها را به هم می‌چسباند؛ مقادیر منفی باعث هم‌پوشانی می‌شوند.
settings-selector-skew-label = کجی
settings-selector-edge-tilt-label = شیب لبه
settings-selector-edge-tilt-desc = لبه‌های بالا و پایین را کج کنید. مقادیر مثبت لبهٔ راست و مقادیر منفی لبهٔ چپ را بالا می‌برند.
settings-selector-wobble-label = تاب خوردن
settings-selector-wobble-desc = کارت‌ها در جهت پیمایش خم می‌شوند و با توقف پیمایش به جای خود برمی‌گردند. حرکت سریع‌تر کانال‌های رنگ را هم از هم جدا می‌کند.
settings-selector-wobble-strength-label = شدت تاب خوردن
settings-selector-wobble-strength-desc = مقدار پیش‌فرض 100 است. مقدار 200 خمیدگی و جدایی رنگ را دو برابر می‌کند.
settings-selector-corners-card = گوشه‌ها
settings-selector-card-flip-card = برگرداندن کارت
settings-selector-card-flip-card-desc = نحوهٔ تغییر کارت تصویر زمینه از بندانگشتی به جزئیات پشت آن را انتخاب کنید.
settings-selector-flip-effect-label = جلوه
settings-selector-flip-effect-desc = سایه‌زن بندانگشتی که در مرحلهٔ اول استفاده می‌شود.
settings-selector-flip-shader-label = سایه‌زن بندانگشتی
settings-selector-flip-shader-desc = خاموش کنید تا جلوهٔ بندانگشتی رد شود و پشت کارت مستقیم دیده شود.
settings-selector-flip-back-label = آشکار شدن پشت کارت
settings-selector-flip-back-desc = خاموش کنید تا پس از پایان جلوهٔ بندانگشتی، پنل پشتی بی‌درنگ ظاهر شود.
settings-selector-flip-duration-label = مدت سفارشی
settings-selector-flip-duration-desc = زمان کل برگرداندن کارت. این مقدار عمداً جایگزین ضرایب مشترک حرکت رابط می‌شود.
settings-selector-tag-cloud-card = جست‌وجو
settings-selector-tag-cloud-card-desc = پنل جست‌وجوی برچسب و توضیح که زیر انتخابگر باز می‌شود.
settings-selector-tag-cloud-width-label = عرض
settings-selector-tag-cloud-width-desc = عرض پنل جست‌وجو.
settings-selector-tag-cloud-rows-label = ردیف‌های برچسب قابل کلیک
settings-selector-tag-cloud-rows-desc = تعداد ردیف‌های پیشنهاد قابل کلیک که زیر کادر جست‌وجو باز می‌شوند.
settings-selector-tag-cloud-rows-one = 1 ردیف
settings-selector-tag-cloud-rows-two = 2 ردیف
settings-selector-tag-cloud-rows-three = 3 ردیف
settings-selector-video-preview-card = پیش‌نمایش ویدیو
settings-selector-video-preview-card-desc = پیش‌نمایش متحرک هنگام بردن نشانگر روی ویدیو یا انتخاب آن.
settings-selector-video-preview-label = فعال کردن پیش‌نمایش ویدیو
settings-selector-video-preview-desc = هنگام بردن نشانگر یا انتخاب، خود ویدیو را به‌جای بندانگشتی ثابت پخش کنید.
settings-selector-preview-delay-label = تأخیر پیش‌نمایش
settings-selector-preview-delay-desc = زمان انتظار پس از بردن نشانگر یا انتخاب تا شروع پیش‌نمایش، به میلی‌ثانیه.
settings-selector-tag-cloud-position-card = جای پنل جست‌وجو
settings-selector-tag-cloud-position-card-desc = پنل جست‌وجو را افقی یا عمودی، به پیکسل جابه‌جا کنید. جابه‌جایی افقی مثبت آن را به راست و جابه‌جایی عمودی مثبت آن را به پایین می‌برد.
settings-selector-tag-position-enabled-label = استفاده از موقعیت صفحه
settings-selector-tag-position-enabled-desc = وقتی اندازهٔ پنل جستجو یا سبک انتخابگر تغییر می‌کند، پنل را در همین مختصات صفحه نگه می‌دارد. برای استفاده از جابه‌جایی‌های پیکسلی خاموشش کنید.
settings-selector-tag-position-x-label = لبهٔ چپ
settings-selector-tag-position-x-desc = لبهٔ چپ پنل جستجو را به درصدی از عرض صفحه تعیین کنید.
settings-selector-tag-position-y-label = لبهٔ بالا
settings-selector-tag-position-y-desc = لبهٔ بالای پنل جستجو را به درصدی از ارتفاع صفحه تعیین کنید.
settings-selector-tag-offset-x-label = جابه‌جایی افقی پنل جست‌وجو
settings-selector-tag-offset-x-desc = پنل جست‌وجو را نسبت به این انتخابگر به چپ یا راست ببرید.
settings-selector-tag-offset-y-label = جابه‌جایی عمودی پنل جست‌وجو
settings-selector-tag-offset-y-desc = پنل جست‌وجو را نسبت به این انتخابگر بالا یا پایین ببرید.
settings-selector-mode-slices = برش‌ها
settings-selector-mode-hex = هندسی
settings-selector-mode-wall = دیوار
settings-selector-mode-sandy = شنی
settings-selector-gpu-tier-discrete = مجزا
settings-selector-gpu-tier-integrated = یکپارچه
settings-selector-gpu-tier-other = سایر
settings-selector-swap-style-vortex = گرداب
settings-selector-swap-style-hourglass = ساعت شنی
settings-selector-swap-style-castle = قلعهٔ شنی
settings-selector-swap-style-saltation = جهش دانه‌ها
settings-selector-swap-style-pour = ریختن از لیوان
settings-selector-swap-style-orbit = گرداب بزرگ
settings-selector-swap-style-burst = انفجار
settings-selector-swap-style-weave = بافت
settings-selector-swap-style-bloom = شکفتن
settings-selector-swap-style-flock = پرواز دسته‌جمعی
settings-selector-swap-style-ring = حلقه
settings-selector-mode-hand = دست کارت
settings-selector-hand-card = دست کارت
settings-selector-hand-card-desc = بادبزنی از کارت‌های بلند با نمای پرسپکتیو، مانند کارت‌های بازی در دست. نشانگر را حرکت دهید تا دست کج شود، صحنه را بکشید تا بچرخد و با پیمایش از لبه بگذرید تا دست بعدی پخش شود.
settings-selector-hand-move-label = حرکت پخش کارت
settings-selector-hand-move-desc = نحوهٔ خروج کارت‌ها و ورود دست بعدی. حالت چرخه، حرکت‌های فعال را به‌ترتیب اجرا می‌کند؛ حالت تصادفی در هر بار یکی را انتخاب می‌کند. برای کنار گذاشتن حرکت‌ها، آن‌ها را در پایین خاموش کنید.
settings-selector-hand-move-random = تصادفی
settings-selector-hand-move-cycle = چرخه
settings-selector-hand-move-corkscrew = پیچ مارپیچی
settings-selector-hand-move-cascade = آبشار
settings-selector-hand-move-shuffle = بُر زدن
settings-selector-hand-move-ribbon = نوار
settings-selector-hand-move-spiral = مارپیچ
settings-selector-hand-count-label = کارت‌های دست
settings-selector-hand-count-desc = تعداد کارت‌های هم‌زمان، از 3 تا 9.
settings-selector-hand-card-width-label = عرض کارت
settings-selector-hand-card-height-label = ارتفاع کارت
settings-selector-hand-spread-label = گسترش بادبزن
settings-selector-hand-spread-desc = فاصلهٔ افقی کارت‌های مجاور. اندازه‌ها پیکسل طراحی در صحنهٔ 1440 x 900 هستند و متناسب با صفحه تغییر می‌کنند.
settings-selector-hand-perspective-label = پرسپکتیو
settings-selector-hand-perspective-desc = فاصلهٔ دوربین. مقادیر کمتر عمق را اغراق‌آمیزتر می‌کنند.
settings-selector-hand-tilt-label = شیب به سمت نشانگر
settings-selector-hand-tilt-desc = میزان خم شدن کل دست به سمت نشانگر. 0 شیب را غیرفعال می‌کند.
settings-selector-hand-speed-label = سرعت
settings-selector-hand-speed-desc = سرعت پخش و برگرداندن کارت؛ 100 = پیش‌فرض.
settings-selector-ribbons-card = نوارها
settings-selector-ribbons-card-desc = هر کارت به نوارهایی بریده می‌شود که هنگام برگرداندن کارت یکی‌یکی تاب می‌خورند و باز می‌شوند و در پخش نواری از هم جدا می‌شوند.
settings-selector-hand-ribbon-axis-label = جهت برش
settings-selector-hand-ribbon-axis-rows = ردیف‌ها
settings-selector-hand-ribbon-axis-columns = ستون‌ها
settings-selector-hand-ribbons-label = نوارها
settings-selector-hand-ribbons-desc = تعداد نوار در هر کارت، از 2 تا 14.
settings-selector-hand-cut-label = زاویهٔ برش
settings-selector-hand-cut-straight = مستقیم
settings-selector-hand-cut-slant = مورب
settings-selector-hand-cut-steep = پرشیب
settings-selector-hand-cut-variance-label = تنوع برش
settings-selector-hand-cut-variance-desc = عرض و زاویهٔ نوارها را در هر کارت تصادفی کنید.
settings-selector-hand-cut-variance-none = یکسان
settings-selector-hand-cut-variance-soft = ملایم
settings-selector-hand-cut-variance-wild = شدید
settings-selector-hand-effects-card = فضای پیرامون
settings-selector-hand-effects-card-desc = لایه‌های اختیاری دور دست کارت.
settings-selector-hand-ghosts-label = رد شبح‌وار
settings-selector-hand-ghosts-desc = هنگام پخش، نسخه‌های محو و روشن‌تر به دنبال هر کارت حرکت می‌کنند.
settings-selector-hand-backdrop-label = پس‌زمینهٔ محو
settings-selector-hand-backdrop-desc = صفحه را پشت دست کارت با نسخه‌ای تیره و محو از تصویر زمینهٔ انتخاب‌شده پر کنید.
settings-selector-hand-bob-label = نوسان در حالت بیکار
settings-selector-hand-bob-desc = تا وقتی انتخابگر باز است، کارت‌ها به‌آرامی حرکت می‌کنند. این گزینه پویانمایی انتخابگر را ادامه می‌دهد و در حالت بیکار هم از GPU استفاده می‌کند.
settings-selector-hand-fan-angle-label = زاویهٔ بادبزن
settings-selector-hand-fan-angle-desc = چرخش افقی اضافه برای هر کارت دورتر از مرکز. 0 همهٔ کارت‌ها را روبه‌روی شما نگه می‌دارد.
settings-selector-hand-fan-roll-label = چرخش بادبزن
settings-selector-hand-fan-roll-desc = شیب اضافه برای هر کارت، مانند کارت‌های بازشده در دست. 0 آن‌ها را قائم نگه می‌دارد.
settings-selector-hand-arch-label = قوس
settings-selector-hand-arch-desc = میزان پایین رفتن کارت‌های کناری نسبت به کارت میانی.
settings-selector-hand-skew-label = کجی
settings-selector-hand-skew-desc = طرح کارت را به متوازی‌الاضلاع تبدیل کنید؛ مقدار برحسب پیکسل جابه‌جایی افقی است.
settings-selector-hand-backdrop-blur-label = محوشدگی پس‌زمینه
settings-selector-hand-backdrop-blur-desc = شعاع محوشدگی پس‌زمینه؛ 100 = پیش‌فرض.
settings-selector-hand-reveal-fill-label = پیش‌نمایش قاب را پر کند
settings-selector-hand-reveal-fill-desc = وقتی دست کارت به پیش‌نمایش برمی‌گردد، کارت‌ها کشیده می‌شوند تا یک تصویر کامل را کنار هم بسازند. در حالت خاموش، هر کارت عرض و ارتفاع خودش را نگه می‌دارد و مقیاس ردیف برای جا شدن تنظیم می‌شود.
settings-selector-start-position-label = جای شروع
settings-selector-start-position-desc = از ابتدا، از آخرین تصویر زمینهٔ اعمال‌شده یا از جایی که مرور را متوقف کردید باز شود. فیلترهای فعلی را در نظر می‌گیرد.
settings-selector-start-position-beginning = ابتدا
settings-selector-start-position-applied = آخرین تصویر زمینهٔ اعمال‌شده
settings-selector-start-position-browsing = آخرین جای مرور
settings-selector-loop-around-label = چرخش در دو انتها
settings-selector-loop-around-desc = رفتن از اولین یا آخرین تصویر زمینه به جلوتر، انتخاب را به انتهای دیگر می‌برد. کلیدهای نگه‌داشته، ورق‌زدن صفحه‌ای و پیمایش سریع اول در انتها می‌ایستند؛ برای دور زدن دوباره بزنید یا پیمایش کنید. منابع آنلاین وقتی همهٔ صفحه‌ها بارگذاری شدند دور می‌زنند. در چیدمان دیوار و در منابع آنلاین، چرخ ماوس فقط نما را پیمایش می‌کند.
settings-selector-mode-depth = عمق
settings-selector-depth-card = کارت‌های عمقی
settings-selector-depth-desc = کارت‌ها به سمت لبه‌ها کوچک می‌شوند. با پیمایش، تصویر داخل هر کارت متناسب با جای آن در ردیف جابه‌جا می‌شود.
settings-selector-parallax-label = اختلاف منظر تصویر
settings-selector-parallax-desc = هنگام حرکت کارت در نما، تصویر داخل آن را جابه‌جا کنید. تصویر از میان لبه‌های قابل مشاهده به حرکت ادامه می‌دهد.
settings-selector-mode-collection = مجموعه
settings-selector-collection-desc = یک دستهٔ کج را با چرخ ماوس یا کلیدهای جهت مرور کنید. برای باز کردن کارت کلیک کنید؛ برای بازگشت دوباره کلیک کنید یا Escape را بزنید. برای اعمال Enter را بزنید. برای جزئیات راست‌کلیک کنید.
settings-selector-depth-height-label = ارتفاع کارت
settings-selector-depth-height-desc = ارتفاع کارت میانی. کارت‌های بزرگ برای جا شدن در صفحه کوچک می‌شوند.
settings-selector-depth-width-label = عرض کارت
settings-selector-depth-width-desc = عرض کارت میانی به پیکسل.
settings-selector-depth-spacing-label = فاصلهٔ کارت‌ها
settings-selector-depth-spacing-desc = فاصلهٔ مرکز کارت‌ها به پیکسل، پیش از کاهش اندازه بر اثر عمق.
settings-selector-depth-count-label = کارت‌های قابل مشاهده
settings-selector-depth-count-desc = بیشترین تعداد کارت‌های اطراف انتخاب فعلی.
settings-selector-depth-falloff-label = کاهش اندازه با عمق
settings-selector-depth-falloff-desc = کاهش مقیاس هر کارت دورتر از مرکز، از 0 تا 1. صفر اندازه‌ها را برابر نگه می‌دارد.
settings-selector-depth-skew-label = کجی کارت
settings-selector-depth-skew-desc = لبه‌های کارت را کج کنید. صفر آن‌ها را قائم نگه می‌دارد.
settings-selector-depth-speed-label = مدت جابه‌جایی
settings-selector-depth-speed-desc = زمان هر حرکت مرور به میلی‌ثانیه. مقادیر کمتر سریع‌تر حرکت می‌کنند.
settings-selector-collection-size-label = اندازهٔ کارت
settings-selector-collection-size-desc = عرض کارت به درصدی از ارتفاع صفحه.
settings-selector-collection-spacing-label = فاصلهٔ دسته
settings-selector-collection-spacing-desc = فاصلهٔ عمودی کارت‌های روی هم به درصدی از اندازهٔ کارت.
settings-selector-collection-count-label = کارت‌های قابل مشاهده
settings-selector-collection-count-desc = بیشترین تعداد کارت در دسته.
settings-selector-collection-tilt-label = شیب دسته
settings-selector-collection-tilt-desc = دسته را به سمت دور از خود کج کنید. صفر کارت‌ها را روبه‌رو نشان می‌دهد.
settings-selector-collection-speed-label = سرعت حرکت
settings-selector-collection-speed-desc = سرعت مرور و باز یا بسته شدن کارت. مقادیر بیشتر سریع‌تر حرکت می‌کنند.
settings-selector-depth-frame-label = قاب انتخاب
settings-selector-depth-frame-desc = دور کارت انتخاب‌شده حاشیه‌ای برجسته بکشید.
settings-selector-shadows-label = سایهٔ کارت‌ها
settings-selector-shadows-desc = پشت هر کارت سایه بکشید.
