settings-sources-other = منابع دیگر
settings-sources-other-desc = Unsplash، Pexels، تصویر روز Bing و YouTube.
settings-sources-wallhaven-say = { $top ->
        [yes] جلسه‌های تازه بر اساس { $sort } در { $range } مرتب می‌شوند، نسبت { $ratio }، با نمایش { $categories } در سطح { $purity }.
       *[no] جلسه‌های تازه بر اساس { $sort } مرتب می‌شوند، نسبت { $ratio }، با نمایش { $categories } در سطح { $purity }.
    }
settings-sources-wallhaven-off = خاموش. مرورگر Wallhaven پنهان است.
settings-sources-workshop-say = { $trend ->
        [yes] جلسه‌های تازه بر اساس { $sort } در { $days } مرتب می‌شوند، نوع { $type }، وضوح { $resolution }، دسته { $category }.
       *[no] جلسه‌های تازه بر اساس { $sort } مرتب می‌شوند، نوع { $type }، وضوح { $resolution }، دسته { $category }.
    }
settings-sources-workshop-off = خاموش. مرورگر Steam Workshop و تنظیمات صحنه‌های Wallpaper Engine پنهان هستند.
