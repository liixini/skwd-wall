settings-sources-needs-key = { $key ->
        [access] { " " }{ $source } به کلید دسترسی نیاز دارد.
       *[api] { " " }{ $source } به کلید API نیاز دارد.
    }
settings-sources-off = { $count ->
        [one] { " " }{ $sources } خاموش است.
       *[some] { " " }{ $sources } خاموش هستند.
    }
