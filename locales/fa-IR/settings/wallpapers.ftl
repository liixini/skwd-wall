settings-wallpapers-displays-say = { $state ->
        [none] هیچ نمایشگری قفل نیست.
        [one] { $names } قفل است.
        [some] { $names } قفل هستند.
       *[detecting] در حال یافتن نمایشگرها.
    } نمایشگرهای بدون جایگذاری خاص از { $fill } استفاده می‌کنند.
settings-wallpapers-play-say = تصاویر از { $backend }، ویدیوها از { $val }Vulkan{ $end }، روی لایه { $layer }.
settings-wallpapers-transitions-say = خانواده { $family }{ $kind ->
        [random] ، هر بار یکی متفاوت، در { $duration }.
        [preset] ، با { $shader }، در { $ms } میلی‌ثانیه.
       *[shader] ، با { $shader }، در { $duration }.
    } نرخ { $rate }.
settings-wallpapers-primary-count = { $state ->
        [none] هیچ‌کدام از { $all }
        [all] همه { $all }
       *[some] { $shown } از { $all }
    }
settings-wallpapers-awww-say = تصاویر { $type } را با فیلتر { $filter } در { $duration } پخش می‌کنند.
settings-wallpapers-drawing-say = { $state ->
        [on] تصاویر آماده در { $duration } طراحی می‌شوند.
       *[off] خاموش. کارت‌های طراحی همچنان در { $duration } طراحی می‌شوند.
    }
settings-wallpapers-sound-say = صدای تصاویر زمینه روی { $volume } پخش می‌شود{ $duck ->
        [yes] { " " }و با صدای برنامه‌های دیگر متوقف می‌شود.
       *[no] .
    }
settings-wallpapers-pause-say = با { $rules } روی { $scope } متوقف می‌شود{ $apps ->
        [yes] ، و برای برنامه‌های فهرست‌شده.
       *[no] .
    }
settings-wallpapers-pause-rules = { $count } قانون پنجره
settings-wallpapers-plasma-say = { $state ->
        [off] صفحه قفل { $mode }.
        [static] صفحه قفل { $mode }: { $image }.
       *[follow] صفحه قفل { $mode }، صحنه‌ها به‌صورت { $scenes ->
        [live] رندر زنده.
       *[poster] فریم پوستر.
    }
    }
settings-wallpapers-niri-say = نمایش { $source ->
       *[current] تصویر زمینه فعلی
        [own] منبع خودش
        [stationary] یک تصویر زمینه ثابت
    }{ $blur ->
        [yes] ، محو
       *[no] { "" }
    }، تاریک‌شده { $dim }{ $auto ->
        [yes] ، بازرنگ‌شده
       *[no] { "" }
    }.
settings-wallpapers-device-hint = «خودکار» به‌ترتیب CUDA، WebGPU و CPU
settings-wallpapers-memory-hint = با گذشتن از حد، «خودکار» روی CPU تلاش می‌کند
