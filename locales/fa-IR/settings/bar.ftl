settings-bar-filter = نوار فیلتر
settings-bar-filter-desc = ردیف دکمه‌های نوع، مرتب‌سازی و فیلتر بالای انتخابگر.
settings-bar-filter-say = { $val }{ $buttons }{ $end } و { $val }{ $sorts }{ $end } را { $orientation ->
        [vertical] عمودی
       *[horizontal] افقی
    } نشان می‌دهد. { $pinned ->
        [yes] همیشه سنجاق می‌ماند.
       *[no] تا وقتی لازمش نداشته باشید پنهان می‌ماند.
    } سبک ظاهری: { $style }.
settings-bar-button-count = { $shown } از { $all } { $all ->
        [one] دکمه
       *[other] دکمه
    }
settings-bar-sort-count = { $shown } از { $all } { $all ->
        [one] مرتب‌سازی
       *[other] مرتب‌سازی
    }
settings-bar-offers = چه چیزی دارد
settings-bar-behaves = چگونه رفتار می‌کند
settings-bar-buttons = دکمه‌های نوار
settings-bar-pinned-hint = سنجاق‌شده به‌جای پنهان شدن خودکار
settings-bar-placed = جای نوار در چیدمان تنظیم می‌شود.
settings-bar-sizes = بازه‌های اندازه
settings-bar-sizes-desc = بازه‌های وضوحی که دکمهٔ «اندازه» با آن‌ها فیلتر می‌کند.
settings-bar-sizes-say = دکمهٔ «اندازه» { $bands } را ارائه می‌دهد.
settings-bar-sizes-none = هنوز بازهٔ اندازه‌ای نیست، پس دکمهٔ «اندازه» گزینه‌ای ندارد.
settings-bar-unnamed = بی‌نام
settings-bar-from = از
settings-bar-up-to = تا
settings-bar-no-limit = بدون سقف
settings-bar-add-hint = یک بازهٔ آماده یا سفارشی
settings-bar-start = انتخابگر از کجا شروع می‌شود
settings-bar-start-desc = پوشه‌ای که هنگام باز شدن انتخابگر نشان داده می‌شود.
settings-bar-start-say = انتخابگر روی { $folder } باز می‌شود و { $sticky ->
        [yes] فیلترهای شما را پس از بسته شدن نگه می‌دارد.
       *[no] هر بار که باز می‌شود فیلترها را بازنشانی می‌کند.
    }
settings-bar-sticky-hint = فیلترهای نوع، پوشه، رنگ، ترتیب و برگزیده پس از بسته شدن انتخابگر نگه داشته شوند
settings-bar-search-desc = برچسب‌ها با واژه‌های ذخیره‌شده تطبیق می‌شوند. «توصیف» تصاویر را از یک توضیح کوتاه پیدا می‌کند.
settings-bar-search-say = جستجو با { $mode ->
        [describe] «توصیف»
       *[tags] برچسب‌ها
    } باز می‌شود. جستجوی توصیفی از { $model } روی { $views ->
        [multiview] ترکیب‌بندی و برش‌ها
       *[full] تصویر کامل
    } استفاده می‌کند.
settings-bar-search-off = جستجو با { $mode ->
        [describe] «توصیف»
       *[tags] برچسب‌ها
    } باز می‌شود. جستجوی توصیفی خاموش است: هیچ مدلی بارگذاری و چیزی نمایه نمی‌شود. برچسب‌ها کار می‌کنند.
settings-bar-model-status = { " " }وضعیت مدل: { $val }{ $status }{ $end }.
settings-bar-searching = جستجو
settings-bar-unused = استفاده نمی‌شود
settings-bar-name-hint = در فهرست مدل‌های فعال نشان داده می‌شود
settings-bar-manual-hint = ارجاع به بسته در جای خودش
settings-bar-forget-hint = فایل‌ها نگه داشته می‌شوند
settings-bar-delete-hint = جستجوی معنایی را هم خاموش می‌کند
settings-menu-choose = انتخاب
settings-checks-count = { $shown } از { $all }
settings-bar-floats-hint = در چیدمان جایش را تعیین کنید
settings-bar-delete-named = حذف { $name }
settings-bar-forget-named = فراموش کردن { $name }
