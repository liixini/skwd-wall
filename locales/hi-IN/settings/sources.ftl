settings-sources-providers-section-desc = डाउनलोड प्रदाताओं को सक्षम या अक्षम करें और हर एक के लिए ज़रूरी क्रेडेंशियल, पथ और सीमाएँ सेट करें।
settings-sources-wallhaven-card = Wallhaven
settings-sources-wallhaven-card-desc = Wallhaven पर खोजें और छवियाँ या संग्रह स्थानीय लाइब्रेरी में डाउनलोड करें।
settings-sources-workshop-card = Steam Workshop
settings-sources-workshop-card-desc = Wallpaper Engine Workshop आइटम ब्राउज़ करें, डाउनलोड करें और ढूँढें।
settings-sources-unsplash-card = Unsplash
settings-sources-unsplash-card-desc = मुफ़्त उच्च-रिज़ॉल्यूशन फ़ोटो। unsplash.com/developers से मुफ़्त एक्सेस कुंजी चाहिए।
settings-sources-unsplash-enable-label = Unsplash सक्षम करें
settings-sources-unsplash-enable-desc = डाउनलोड स्रोत पिकर में Unsplash दिखाएँ।
settings-sources-unsplash-key-label = एक्सेस कुंजी
settings-sources-unsplash-key-desc = आपके Unsplash एप्लिकेशन की Access Key। फ़ोटोग्राफ़र क्रेडिट और ज़रूरी डाउनलोड पिंग अपने आप संभाले जाते हैं।
settings-sources-unsplash-key-placeholder = Unsplash एक्सेस कुंजी
settings-sources-pexels-card = Pexels
settings-sources-pexels-card-desc = मुफ़्त उच्च-रिज़ॉल्यूशन फ़ोटो और खोज। pexels.com/api से मुफ़्त API कुंजी चाहिए।
settings-sources-pexels-enable-label = Pexels सक्षम करें
settings-sources-pexels-enable-desc = डाउनलोड स्रोत पिकर में Pexels दिखाएँ।
settings-sources-pexels-key-label = API कुंजी
settings-sources-pexels-key-desc = आपकी Pexels API कुंजी। Pexels की आवश्यकता के अनुसार फ़ोटोग्राफ़र क्रेडिट अपने आप दिखाया जाता है।
settings-sources-pexels-key-placeholder = Pexels API कुंजी
settings-sources-youtube-card = YouTube
settings-sources-youtube-card-desc = YouTube पर खोजें और वीडियो को वीडियो वॉलपेपर फ़ोल्डर में डाउनलोड करें। PATH पर yt-dlp चाहिए, API कुंजी नहीं। केवल वही वीडियो डाउनलोड करें जिनके इस्तेमाल की आपको अनुमति है।
settings-sources-youtube-enable-label = YouTube सक्षम करें
settings-sources-youtube-enable-desc = डाउनलोड स्रोत पिकर में YouTube दिखाएँ।
settings-sources-youtube-height-label = अधिकतम ऊँचाई
settings-sources-youtube-height-desc = डाउनलोड रिज़ॉल्यूशन सीमित करें। कम का मतलब छोटी फ़ाइलें और हल्का प्लेबैक।
settings-sources-youtube-clip-label = क्लिप लंबाई
settings-sources-youtube-clip-desc = YouTube लूप अक्सर घंटों लंबे होते हैं। केवल इतने मिनट डाउनलोड करें; हर वीडियो डाउनलोड से पहले इसे बदल सकता है। 0 सब कुछ डाउनलोड करता है।
settings-sources-bing-card = Bing दैनिक
settings-sources-bing-card-desc = Bing होमपेज की पिछली 8 छवियाँ। कुंजी की ज़रूरत नहीं।
settings-sources-bing-enable-label = Bing सक्षम करें
settings-sources-bing-enable-desc = डाउनलोड स्रोत पिकर में Bing दैनिक दिखाएँ।
settings-sources-bing-market-label = बाज़ार
settings-sources-bing-market-desc = Bing बाज़ार/क्षेत्र कोड, जैसे en-US, en-GB, ja-JP।

settings-source-defaults-card = डिफ़ॉल्ट फ़िल्टर
settings-source-defaults-desc = हर नया ब्राउज़र सत्र इन फ़िल्टरों से शुरू करें। ब्राउज़ करते समय किए गए बदलाव ब्राउज़र बंद होने तक रहते हैं।
settings-source-default-sort = डिफ़ॉल्ट क्रम
settings-source-default-range = डिफ़ॉल्ट समय सीमा
settings-source-default-min = न्यूनतम रिज़ॉल्यूशन
settings-source-default-max = अधिकतम रिज़ॉल्यूशन
settings-source-default-ratio = डिफ़ॉल्ट पहलू अनुपात
settings-source-default-type = डिफ़ॉल्ट वॉलपेपर प्रकार
settings-source-default-resolution = डिफ़ॉल्ट रिज़ॉल्यूशन
settings-source-default-category = डिफ़ॉल्ट श्रेणी
settings-source-default-category-desc = Wallhaven खोलते समय यह श्रेणी शामिल करें। कोई न चुनने पर सामान्य इस्तेमाल होती है।
settings-source-default-purity-desc = स्रोत खोलते समय यह सामग्री शामिल करें। कोई सामग्री स्तर न चुनने पर Wallhaven SFW इस्तेमाल करता है।

settings-sources-apply-label = लागू करें बटन दिखाएँ
settings-sources-apply-desc = इस स्रोत के लिए लागू करें बटन दिखाएँ। कई फ़िल्टर बदलें, फिर एक खोज अनुरोध भेजने के लिए लागू करें या Enter दबाएँ। बंद होने पर हर फ़िल्टर बदलाव तुरंत खोजता है।
