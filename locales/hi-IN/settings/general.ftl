settings-general-general-card = सामान्य
settings-general-monitor-label = पिकर मॉनिटर
settings-general-monitor-desc = कोई डिस्प्ले चुनें, या पिकर खुलते समय जो भी मॉनिटर फ़ोकस में हो उसे उपयोग करें। इसे बदलने के बाद पिकर बंद करके फिर से खोलें।
settings-general-monitor-focused = फ़ोकस वाला मॉनिटर
settings-general-monitor-unavailable = { $output } (अनुपलब्ध)
settings-general-ui-scale-label = UI स्केल
settings-general-ui-scale-desc = पूरे पिकर इंटरफ़ेस को स्केल करें। सीमा 0.5 से 2.0 है।
settings-general-features-card = सुविधाएँ
settings-general-features-card-desc = वैकल्पिक एकीकरण चालू या बंद करें। हर चालू एकीकरण की विस्तृत सेटिंग्स उसके अपने टैब में होती हैं।
settings-general-feature-matugen-label = Matugen
settings-general-feature-matugen-desc = वॉलपेपर के रंगों के लिए Matugen इस्तेमाल करें। बंद करने पर अंतर्निहित Iris इस्तेमाल होगा।
settings-general-feature-steam-label = Steam Workshop ब्राउज़र
settings-general-feature-steam-desc = Steam Workshop से Wallpaper Engine आइटम ब्राउज़ और इंस्टॉल करें।
settings-general-feature-wallhaven-label = Wallhaven ब्राउज़र
settings-general-feature-wallhaven-desc = wallhaven.cc से वॉलपेपर ब्राउज़ और डाउनलोड करें।
settings-general-audio-card = ऑडियो
settings-general-audio-card-desc = वीडियो और Wallpaper Engine वॉलपेपर के लिए डिफ़ॉल्ट ऑडियो सेट करें।
settings-general-mute-label = वॉलपेपर ऑडियो म्यूट करें
settings-general-mute-desc = वीडियो और Wallpaper Engine का ऑडियो आउटपुट बंद करें।
settings-general-volume-label = वॉलपेपर वॉल्यूम
settings-general-volume-desc = वीडियो और Wallpaper Engine ऑडियो का प्लेबैक वॉल्यूम (0-100)। ऑडियो म्यूट होने पर इसका कोई असर नहीं होता।
settings-general-auto-recolour-card = स्वचालित पुनः रंगना
settings-general-auto-recolour-card-desc = नया वॉलपेपर जुड़ने पर पैलेट से पुनः रंगी प्रति बनाएँ। मूल फ़ाइल अपरिवर्तित रहती है।
settings-general-auto-recolour-label = नए वॉलपेपर स्वचालित रूप से पुनः रंगें
settings-general-auto-recolour-desc = हर नए वॉलपेपर के साथ पुनः रंगी प्रति सहेजें। केवल मूल फ़ाइल चाहिए तो इसे बंद करें।
settings-general-recolour-theme-label = पुनः रंगने की थीम
settings-general-recolour-theme-desc = नए वॉलपेपर स्वचालित रूप से पुनः रंगते समय उपयोग होने वाला पैलेट।
settings-general-behaviour-card = व्यवहार
settings-general-close-on-selection-label = चयन पर बंद करें
settings-general-close-on-selection-desc = वॉलपेपर लागू होते ही चयनकर्ता छिपाएँ।
settings-general-hover-selects-label = होवर पर चुनें
settings-general-hover-selects-desc = पॉइंटर के नीचे वाले कार्ड पर चयन ले जाता है। बंद करने पर केवल क्लिक और कुंजियों से चुनें।
settings-general-notify-label = वॉलपेपर बदलने पर सूचित करें
settings-general-notify-desc = वॉलपेपर बदलने पर हर बार सिस्टम सूचना भेजें।
settings-general-restore-label = स्टार्टअप पर वॉलपेपर बहाल करें
settings-general-restore-desc = डेमन शुरू होने पर अंतिम वॉलपेपर फिर से लागू करें।
settings-general-random-card = यादृच्छिक रोटेशन
settings-general-rotate-label = स्वचालित रूप से बदलें
settings-general-rotate-desc = अंतराल पूरा होने पर नीचे के पूल से यादृच्छिक वॉलपेपर लागू करें। यह बंद होने पर अंतराल कुछ नहीं करता।
settings-general-interval-label = अंतराल
settings-general-interval-desc = यादृच्छिक रोटेशन के बीच सेकंड (न्यूनतम 10)।
settings-general-include-images-label = छवियाँ शामिल करें
settings-general-include-images-desc = यादृच्छिक पूल में स्थिर वॉलपेपर शामिल करें।
settings-general-include-video-label = वीडियो शामिल करें
settings-general-include-video-desc = यादृच्छिक पूल में वीडियो वॉलपेपर शामिल करें।
settings-general-include-we-label = Wallpaper Engine शामिल करें
settings-general-include-we-desc = यादृच्छिक पूल में Wallpaper Engine आइटम शामिल करें।
settings-general-favourites-only-label = केवल पसंदीदा
settings-general-favourites-only-desc = यादृच्छिक पूल को पसंदीदा वॉलपेपर तक सीमित करें।

settings-general-apply-picker-monitor-label = केवल पिकर मॉनिटर पर लागू करें
settings-general-apply-picker-monitor-desc = वॉलपेपर उस मॉनिटर पर लागू करें जहाँ यह पिकर खुला। डिस्प्ले चुनें से अब भी दूसरे मॉनिटर चुने जा सकते हैं।
status-picker-monitor-unavailable = पिकर मॉनिटर अनुपलब्ध है। पिकर फिर से खोलें या डिस्प्ले चुनें उपयोग करें।
settings-general-other-audio-label = अन्य ऐप्स के आवाज़ बजाने पर वॉलपेपर की आवाज़ रोकें
settings-general-other-audio-desc = जब भी कोई अन्य एप्लिकेशन आवाज़ बजाए तो वीडियो और Wallpaper Engine की आवाज़ बंद कर देता है और उसके रुकने के लगभग एक सेकंड बाद वापस लाता है। pactl कमांड के साथ PipeWire या PulseAudio चाहिए। म्यूट और वॉल्यूम सेटिंग जैसी हैं वैसी रहती हैं।
settings-general-other-audio-ducked = वॉलपेपर की आवाज़ रुकी है: कोई अन्य एप्लिकेशन आवाज़ बजा रहा है
settings-general-other-audio-listening = अन्य एप्लिकेशन की आवाज़ सुनी जा रही है
settings-general-other-audio-unavailable = साउंड सर्वर का पता नहीं चल सका। देखें कि pactl स्थापित है और PipeWire या PulseAudio चल रहा है।
settings-configuration-transfer-card = कॉन्फ़िगरेशन स्थानांतरण
settings-configuration-transfer-card-desc = अपनी साथ ले जाने लायक़ दिखावट की सेटिंग एक Skwd इंस्टॉलेशन से दूसरे में ले जाएँ। गोपनीय जानकारी, स्थानीय पाथ, डिस्प्ले के नाम और हार्डवेयर के चुनाव इसी डिवाइस पर रहते हैं।
settings-configuration-export-label = सेटिंग निर्यात करें
settings-configuration-export-desc = संस्करण वाला सेटिंग पैक सहेजता है। पैक में आज पहचानी जाने वाली सेटिंग दर्ज होती हैं, ताकि आगे के संस्करण नई सेटिंग सुरक्षित रखें और हटाई गई सेटिंग को अनदेखा करें।
settings-configuration-export-action = निर्यात करें
settings-configuration-import-label = सेटिंग आयात करें
settings-configuration-import-desc = सेटिंग पैक को इस इंस्टॉलेशन में मिलाता है। जो सेटिंग पैक में नहीं हैं, वे जस की तस रहती हैं।
settings-configuration-import-action = आयात करें
settings-configuration-export-dialog = Skwd सेटिंग निर्यात करें
settings-configuration-import-dialog = Skwd सेटिंग आयात करें
settings-configuration-export-complete = सेटिंग { $path } में निर्यात की गईं
settings-configuration-export-error = सेटिंग निर्यात नहीं हो सकीं: { $error }
settings-configuration-import-complete = सेटिंग { $path } से आयात की गईं
settings-configuration-import-error = सेटिंग आयात नहीं हो सकीं: { $error }
