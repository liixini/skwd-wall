settings-bar-filter = फ़िल्टर बार
settings-bar-filter-desc = पिकर के ऊपर प्रकार, क्रम और फ़िल्टर बटनों की पट्टी।
settings-bar-filter-say = { $val }{ $buttons }{ $end } और { $val }{ $sorts }{ $end } दिखाता है, { $orientation ->
        [vertical] लंबवत
       *[horizontal] क्षैतिज
    } रूप में। { $pinned ->
        [yes] यह हमेशा पिन रहता है।
       *[no] ज़रूरत होने तक यह छिपा रहता है।
    } दृश्य शैली: { $style }।
settings-bar-button-count = { $all } में से { $shown } बटन
settings-bar-sort-count = { $all } में से { $shown } क्रम
settings-bar-offers = इसमें क्या है
settings-bar-behaves = यह कैसे दिखता है
settings-bar-buttons = बार के बटन
settings-bar-pinned-hint = अपने आप छिपने के बजाय पिन
settings-bar-placed = बार की जगह लेआउट में तय होती है।
settings-bar-sizes = आकार सीमाएँ
settings-bar-sizes-desc = रिज़ॉल्यूशन सीमाएँ जिनसे आकार बटन फ़िल्टर करता है।
settings-bar-sizes-say = आकार बटन { $bands } देता है।
settings-bar-sizes-none = अभी कोई आकार सीमा नहीं है, इसलिए आकार बटन में देने को कुछ नहीं है।
settings-bar-unnamed = बिना नाम
settings-bar-from = से
settings-bar-up-to = तक
settings-bar-no-limit = कोई ऊपरी सीमा नहीं
settings-bar-add-hint = तैयार सीमा या अपनी सीमा
settings-bar-start = पिकर कहाँ से शुरू होता है
settings-bar-start-desc = पिकर खुलने पर दिखने वाला फ़ोल्डर।
settings-bar-start-say = पिकर { $folder } पर खुलता है और { $sticky ->
        [yes] बंद होने के बाद आपके फ़िल्टर रखता है।
       *[no] हर बार खुलने पर आपके फ़िल्टर रीसेट करता है।
    }
settings-bar-sticky-hint = पिकर बंद होने के बाद प्रकार, फ़ोल्डर, रंग, क्रम और पसंदीदा फ़िल्टर बनाए रखें
settings-bar-search-desc = टैग सहेजे गए शब्दों से मेल खाते हैं। वर्णन छोटे विवरण से छवियाँ ढूँढता है।
settings-bar-search-say = खोज { $mode ->
        [describe] वर्णन
       *[tags] टैग
    } के साथ खुलती है। वर्णन खोज { $views ->
        [multiview] रचना और क्रॉप
       *[full] पूरी छवि
    } पर { $model } इस्तेमाल करती है।
settings-bar-search-off = खोज { $mode ->
        [describe] वर्णन
       *[tags] टैग
    } के साथ खुलती है। वर्णन खोज बंद है: कोई मॉडल लोड नहीं होता और कुछ इंडेक्स नहीं होता। टैग काम करते रहते हैं।
settings-bar-model-status = { " " }मॉडल की स्थिति: { $val }{ $status }{ $end }।
settings-bar-searching = खोज
settings-bar-unused = उपयोग में नहीं
settings-bar-name-hint = सक्रिय मॉडल सूची में दिखता है
settings-bar-manual-hint = पैक को उसी जगह से जोड़ें
settings-bar-forget-hint = फ़ाइलें बनी रहती हैं
settings-bar-delete-hint = सिमैंटिक खोज भी बंद करता है
settings-menu-choose = चुनें
settings-checks-count = { $all } में से { $shown }
settings-bar-floats-hint = व्यवस्था में रखें
settings-bar-delete-named = { $name } हटाएँ
settings-bar-forget-named = { $name } भूलें
