settings-position-sandy-card = रेत पिकर
settings-position-hand-card = कार्ड हैंड पिकर
settings-position-horizontal-label = क्षैतिज ऑफ़सेट
settings-position-horizontal-desc = पिकर को आधी स्क्रीन चौड़ाई के प्रतिशत से बाएँ या दाएँ खिसकाएँ। धनात्मक मान दाएँ ले जाते हैं।
settings-position-vertical-label = ऊर्ध्वाधर ऑफ़सेट
settings-position-vertical-desc = पिकर को आधी स्क्रीन ऊँचाई के प्रतिशत से ऊपर या नीचे खिसकाएँ। धनात्मक मान नीचे ले जाते हैं।
settings-position-frame-card = पिकर फ़्रेम
settings-position-frame-card-desc = पिकर की जगह और आकार स्क्रीन के प्रतिशत के रूप में तय करें। पिकर को हिलाने या उसका आकार बदलने पर "व्यवस्था" ये मान अपडेट कर देती है।
settings-position-frame-enabled-label = कस्टम पिकर फ़्रेम का उपयोग करें
settings-position-frame-enabled-desc = पिकर के लिए नीचे दी गई जगह और आकार का उपयोग करता है।
settings-position-frame-x-label = बायाँ किनारा
settings-position-frame-x-desc = फ़्रेम का बायाँ किनारा स्क्रीन की चौड़ाई के प्रतिशत के रूप में तय करें।
settings-position-frame-y-label = ऊपरी किनारा
settings-position-frame-y-desc = फ़्रेम का ऊपरी किनारा स्क्रीन की ऊँचाई के प्रतिशत के रूप में तय करें।
settings-position-frame-width-label = चौड़ाई
settings-position-frame-width-desc = फ़्रेम की चौड़ाई स्क्रीन की चौड़ाई के प्रतिशत के रूप में तय करें।
settings-position-frame-height-label = ऊँचाई
settings-position-frame-height-desc = फ़्रेम की ऊँचाई स्क्रीन की ऊँचाई के प्रतिशत के रूप में तय करें।

settings-filter-position-enabled-label = बार को अलग से रखें
settings-filter-position-enabled-desc = पिकर बदलने पर भी फ़िल्टर बार को उसकी अपनी जगह पर रखता है।
settings-filter-position-x-label = बार का बायाँ
settings-filter-position-x-desc = बाएँ किनारे से दूरी, डिस्प्ले की चौड़ाई के प्रतिशत के रूप में।
settings-filter-position-y-label = बार का ऊपरी
settings-filter-position-y-desc = ऊपरी किनारे से दूरी, डिस्प्ले की ऊँचाई के प्रतिशत के रूप में।
