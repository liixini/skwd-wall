settings-transitions-transitions-card = ट्रांज़िशन
settings-transitions-transitions-card-desc = चुनें कि एक वॉलपेपर अगले में कैसे बदले। यही सेटिंग छवियों, वीडियो और Wallpaper Engine सीन पर लागू होती है।
settings-transitions-enable-label = ट्रांज़िशन सक्षम करें
settings-transitions-enable-desc = बंद सीधे नए वॉलपेपर पर कट करता है।
settings-transitions-duration-label = अवधि
settings-transitions-duration-desc = कुल ट्रांज़िशन समय मिलीसेकंड में सेट करें। रेत ट्रांज़िशन में कणों की गति दिखती रहे, इसके लिए कम से कम 4000 ms चाहिए।
settings-transitions-family-label = परिवार
settings-transitions-shader-label = ट्रांज़िशन
settings-transitions-shader-count-desc = इस परिवार में { $count }।
settings-transitions-preview-card = पूर्वावलोकन
settings-transitions-preview-card-desc = चुने गए ट्रांज़िशन को नीचे की अवधि और प्रदर्शन सेटिंग से लूप करें।
settings-transitions-show-preview-label = पूर्वावलोकन दिखाएँ
settings-transitions-show-preview-desc = यह टैब खुला रहने पर ट्रांज़िशन रेंडरर चलाएँ। इसका CPU और GPU उपयोग रोकने के लिए बंद करें।
settings-transitions-preview-fps-label = पूर्वावलोकन फ़्रेम दर
settings-transitions-preview-fps-desc = हर पूर्वावलोकन फ़्रेम पूरा पिकर फिर से बनाता है। 30 सहज है; 120 बिना दिखने वाले लाभ के लगभग चार गुना CPU खर्च करता है। अधिकतम FPS पर सीमित।
settings-transitions-sand-card = ट्रांज़िशन प्रदर्शन
settings-transitions-sand-card-desc = चुनें कि हर ट्रांज़िशन हर मॉनिटर पर चले या केवल प्राथमिक मॉनिटर पर। ऊपर का वैश्विक स्विच ही एकमात्र बंद नियंत्रण है।
settings-transitions-quality-label = गुणवत्ता
settings-transitions-quality-desc = स्वचालित अलग GPU पर 60 fps में पूरा रिज़ॉल्यूशन और एकीकृत पर कम चलाता है। पूर्ण असीमित है; कम घटे रिज़ॉल्यूशन पर 30 fps तक सीमित रखता है, लगभग 4.5 गुना सस्ता।
settings-transitions-quality-auto = स्वचालित
settings-transitions-quality-full = पूर्ण
settings-transitions-quality-low = कम
settings-transitions-scope-desc = सभी इस शेडर को हर अपडेट हुए मॉनिटर पर एनिमेट करता है। प्राथमिक इसे एक बार एनिमेट करता है और बाकी मॉनिटर तुरंत बदलता है।
settings-transitions-scope-all = सभी मॉनिटर
settings-transitions-scope-primary = केवल प्राथमिक
settings-transitions-primary-label = प्राथमिक मॉनिटर
settings-transitions-primary-desc = वह आउटपुट जो शेडर के प्राथमिक पर सेट होने पर एनिमेट होता है, जैसे DP-2। खाली पहला उपलब्ध आउटपुट इस्तेमाल करता है।
settings-transitions-sharp-label = घटी रेत को तीक्ष्ण करें
settings-transitions-sharp-desc = कम-रिज़ॉल्यूशन रेत पर FSR1-शैली की तीक्ष्णता। थोड़ा अधिक GPU; केवल तब सक्रिय जब गुणवत्ता रिज़ॉल्यूशन घटाती है।
settings-transitions-family-random = यादृच्छिक
settings-transitions-family-random-desc = हर बार एक अलग ट्रांज़िशन।
settings-transitions-family-fade = फ़ेड
settings-transitions-family-fade-desc = घुलना और मिलना, कोई ज्यामिति नहीं।
settings-transitions-family-wipe = वाइप
settings-transitions-family-wipe-desc = कोई आकार या किनारा स्क्रीन पर फिरता है।
settings-transitions-family-warp = वार्प
settings-transitions-family-warp-desc = छवि मुड़ती, खिंचती या लहराती है।
settings-transitions-family-break = टूटना
settings-transitions-family-break-desc = छवि बिखरती, पिक्सेलेट होती या फैलती है।
settings-transitions-family-sand = रेत
settings-transitions-family-sand-desc = हर पिक्सेल एक कण बनकर किसी आकार में उड़ जाता है।

settings-transitions-rate-label = ट्रांज़िशन FPS
settings-transitions-rate-desc = वॉलपेपर प्लेबैक बदले बिना ऐनिमेशन के फ़्रेम प्रति सेकंड सीमित करें। हर डिस्प्ले की रिफ़्रेश दर के लिए खाली छोड़ें या 0 दर्ज करें।
settings-transitions-rate-auto = अपने आप

settings-drawing-card = ड्रॉइंग ट्रांज़िशन
settings-drawing-card-desc = ड्रॉइंग के लिए किसी छवि, वीडियो या समर्थित Wallpaper Engine वॉलपेपर को तैयार करता है। प्रोसेसिंग चलाने से पहले एक बार होती है; कैश की गई ड्रॉइंग प्रोसेसिंग फ़ाइलों के बिना चलती हैं।
settings-drawing-enable-label = तैयार वॉलपेपर डिफ़ॉल्ट रूप से बनाएँ
settings-drawing-enable-desc = जिन तैयार वॉलपेपर के कार्ड पर कोई चुनाव नहीं है, उनके लिए ड्रॉइंग का उपयोग करता है। कार्ड पर "बनाएँ" या "बनाया गया" इस डिफ़ॉल्ट को बदल देता है। सामान्य ट्रांज़िशन अलग हैं।
settings-drawing-enable-unprepared = ड्रॉइंग ट्रांज़िशन चालू करने से पहले चुना हुआ वॉलपेपर तैयार करें।
settings-drawing-paper-label = काग़ज़ का रंग
settings-drawing-paper-desc = वह पृष्ठभूमि जिस पर चित्र बनता है।
settings-drawing-ink-label = स्याही का रंग
settings-drawing-ink-desc = खींची गई रेखाओं का रंग।
settings-drawing-ink-style-label = स्याही
settings-drawing-ink-style-desc = सादी रेखाएँ स्याही के रंग में होती हैं। इंद्रधनुषी रेखाएँ स्पेक्ट्रम के सभी रंगों से गुज़रती हैं।
settings-drawing-ink-style-plain = सादी
settings-drawing-ink-style-rainbow = इंद्रधनुष
settings-drawing-duration-label = अवधि
settings-drawing-duration-desc = ड्रॉइंग और फ़िनिश का कुल समय मिलीसेकंड में, 1500 से 20000 तक।
settings-drawing-battery-label = बैटरी पर तैयार करें
settings-drawing-battery-desc = चार्जर हटे होने पर भी प्रोसेसिंग की अनुमति देता है। बंद होने पर बैटरी पर तैयारी रुक जाती है; तैयार ड्रॉइंग फिर भी चल सकती हैं।
settings-drawing-library-label = सभी वॉलपेपर तैयार करें
settings-drawing-library-desc = जिस भी वॉलपेपर में ड्रॉइंग चालू है उसे तैयार करता है, वीडियो और Wallpaper Engine समेत। तैयार वॉलपेपर छोड़ दिए जाते हैं, इसलिए रुकी हुई प्रक्रिया वहीं से आगे बढ़ती है जहाँ रुकी थी।
settings-drawing-library-action = सभी तैयार करें
settings-drawing-library-stop = रोकें
settings-drawing-library-skipped = { $count } छोड़े गए
settings-drawing-auto-label = नए वॉलपेपर अपने आप तैयार करें
settings-drawing-auto-desc = हर लाइब्रेरी स्कैन के बाद, उन वॉलपेपर को तैयार करता है जिनमें ड्रॉइंग चालू है और जो अभी तैयार नहीं हैं। रोकने पर यह फिर से शुरू करने तक रुका रहता है; बंद करने पर यह बंद हो जाता है।
settings-drawing-pack-label = प्रोसेसिंग फ़ाइलें
settings-drawing-pack-missing = कोई प्रोसेसिंग फ़ाइल पंजीकृत नहीं है। वॉलपेपर तैयार करने के लिए स्थानीय ड्रॉइंग पैक मैनिफ़ेस्ट चुनें।
settings-drawing-pack-checking = प्रोसेसिंग फ़ाइलों और रनटाइम की जाँच हो रही है। आप इस जाँच को रद्द कर सकते हैं।
settings-drawing-pack-install = ड्रॉइंग इस्तेमाल करने के लिए skwd-drawing-model पैकेज इंस्टॉल करें।
settings-drawing-pack-ready = प्रोसेसिंग फ़ाइलें उपलब्ध हैं। इनका उपयोग केवल वॉलपेपर तैयार करते समय होता है।
settings-drawing-pack-invalid = पंजीकृत प्रोसेसिंग फ़ाइलों का उपयोग नहीं हो सका। मान्य ड्रॉइंग पैक मैनिफ़ेस्ट चुनें।
settings-drawing-pack-action-label = प्रोसेसिंग फ़ाइलें चुनें
settings-drawing-pack-action-desc = स्थानीय रूप से इंस्टॉल किए गए ड्रॉइंग प्रोसेसिंग पैक का मैनिफ़ेस्ट चुनें। इससे कोई फ़ाइल डाउनलोड नहीं होती।
settings-drawing-pack-action = मैनिफ़ेस्ट चुनें
settings-drawing-pack-picker-title = ड्रॉइंग पैक मैनिफ़ेस्ट चुनें
settings-drawing-pack-picker-filter = JSON मैनिफ़ेस्ट | *.json
settings-drawing-detach-label = प्रोसेसिंग फ़ाइलें अलग करें
settings-drawing-detach-desc = पंजीकृत प्रोसेसिंग पैक का उपयोग बंद करता है। तैयार ड्रॉइंग कैश में रहती हैं और चल सकती हैं।
settings-drawing-detach-action = फ़ाइलें अलग करें
settings-drawing-selection-label = चुना हुआ वॉलपेपर
settings-drawing-selection-none = कोई वॉलपेपर चुनें
settings-drawing-selection-unprepared = यह वॉलपेपर तैयार नहीं है। यह सामान्य ट्रांज़िशन सेटिंग का उपयोग करता है; वह बंद हो तो वॉलपेपर तुरंत बदल जाता है।
settings-drawing-selection-prepared = तैयार। ड्रॉइंग प्रोसेसिंग फ़ाइलों के बिना चल सकती है।
settings-drawing-selection-checking = तैयारी से पहले प्रोसेसिंग फ़ाइलों की जाँच हो रही है।
settings-drawing-selection-preparing = चुना हुआ वॉलपेपर तैयार हो रहा है।
settings-drawing-selection-cancelled = तैयारी रद्द कर दी गई। वॉलपेपर दोबारा तैयार किया जा सकता है।
settings-drawing-selection-failed = तैयारी विफल रही। त्रुटि देखें और फिर कोशिश करें।
settings-drawing-checking-label = प्रोसेसिंग फ़ाइलों की जाँच हो रही है
settings-drawing-checking-desc = स्थानीय पैक और उसके रनटाइम की जाँच हो रही है। इसमें कुछ समय लग सकता है।
settings-drawing-progress-label = तैयारी
settings-drawing-progress-value = { $stage } · { $percent }% · { $total } में से { $completed } पूरे
settings-drawing-prepare-desc = चुने हुए वॉलपेपर को ड्रॉइंग के लिए तैयार करता है। वीडियो और Wallpaper Engine दृश्य एक कैप्चर किया हुआ फ़्रेम इस्तेमाल करते हैं।
settings-drawing-prepare-action = चुना हुआ वॉलपेपर तैयार करें
settings-drawing-prepare-again-action = दोबारा तैयार करें
settings-drawing-cancel-desc = तैयारी रोकता है। कैश में पूरी हो चुकी ड्रॉइंग रखी जाती हैं।
settings-drawing-cancel-action = तैयारी रद्द करें
settings-drawing-preview-desc = चुने हुए रंगों और अवधि के साथ यह ड्रॉइंग डेस्कटॉप पर चलाता है। आप उसे देख सकें, इसलिए पिकर छिप जाता है; लौटने के लिए Wall का शॉर्टकट इस्तेमाल करें। इससे ड्रॉइंग ट्रांज़िशन चालू नहीं होते।
settings-drawing-preview-action = डेस्कटॉप पर पूर्वावलोकन
settings-drawing-cache-label = ड्रॉइंग कैश
settings-drawing-clear-desc = कैश से तैयार ड्रॉइंग हटाता है। प्रोसेसिंग फ़ाइलें पंजीकृत रहती हैं।
settings-drawing-clear-action = ड्रॉइंग कैश खाली करें
settings-drawing-unavailable-label = ड्रॉइंग उपलब्ध नहीं है
settings-drawing-unavailable-desc = नए वॉलपेपर तैयार करने के लिए प्रोसेसिंग फ़ाइलें पंजीकृत करें, या पहले से तैयार वॉलपेपर का उपयोग करें।
settings-drawing-error = ड्रॉइंग विफल रही: { $error }
settings-drawing-selection-paused = तैयारी रुकी हुई है। कैश की गई ड्रॉइंग उपलब्ध रहती हैं।
settings-drawing-pause-desc = प्रोसेसिंग रोकता है और मॉडल मुक्त करता है। फिर से शुरू करने पर इस वॉलपेपर की तैयारी दोबारा शुरू होती है।
settings-drawing-pause-action = तैयारी रोकें
settings-drawing-resume-desc = चुने हुए वॉलपेपर की तैयारी फिर से शुरू करता है। कैश में पूरी हो चुकी ड्रॉइंग उपलब्ध रहती हैं।
settings-drawing-resume-action = तैयारी फिर से शुरू करें
settings-drawing-pack-size = मॉडल फ़ाइलें: { $size }
settings-drawing-stage-checking = वॉलपेपर की जाँच हो रही है
settings-drawing-stage-ready = तैयार करने के लिए तैयार
settings-drawing-stage-starting = मॉडल शुरू हो रहे हैं
settings-drawing-stage-source = स्रोत छवि पढ़ी जा रही है
settings-drawing-stage-lineart = रेखाएँ खोजी जा रही हैं
settings-drawing-stage-depth = गहराई मापी जा रही है
settings-drawing-stage-subjects = मुख्य विषय खोजे जा रहे हैं
settings-drawing-stage-complete = ड्रॉइंग तैयार
settings-drawing-stage-other = छवि तैयार हो रही है
settings-drawing-selection-other-preparing = दूसरा वॉलपेपर तैयार हो रहा है। इसे तैयार करने से पहले उसे रोकें या रद्द करें।
settings-drawing-selection-other-paused = दूसरा वॉलपेपर रुका हुआ है। इसे तैयार करने से पहले उसे फिर से शुरू करें या रद्द करें।
settings-drawing-scope-label = तैयार करें
settings-drawing-scope-desc = एक वॉलपेपर या मौजूदा फ़िल्टर किया गया दृश्य चुनें। छवियाँ, वीडियो और समर्थित Wallpaper Engine वॉलपेपर तैयार किए जा सकते हैं, एक बार में 128 तक।
settings-drawing-scope-selected = चुना हुआ वॉलपेपर
settings-drawing-scope-view = मौजूदा दृश्य
settings-drawing-view-count-label = मौजूदा दृश्य में वॉलपेपर
settings-drawing-view-count = मौजूदा फ़िल्टर किए गए दृश्य में { $count } वॉलपेपर हैं।
settings-drawing-view-empty-label = इस दृश्य में कोई वॉलपेपर नहीं
settings-drawing-view-empty-desc = इस दृश्य को तैयार करने से पहले मौजूदा फ़िल्टर बदलें या कोई वॉलपेपर चुनें।
settings-drawing-view-limit-label = बहुत ज़्यादा वॉलपेपर
settings-drawing-view-limit-desc = इस दृश्य में { $count } वॉलपेपर हैं। इसे तैयार करने से पहले फ़िल्टर को घटाकर { $limit } या उससे कम करें।
settings-drawing-prepare-view-desc = मौजूदा फ़िल्टर किए गए दृश्य के वॉलपेपर एक-एक करके तैयार करता है। कैश में पहले से मौजूद ड्रॉइंग रखी जाती हैं।
settings-drawing-prepare-view-action = { $count } वॉलपेपर तैयार करें
settings-drawing-selection-view-preparing = मौजूदा दृश्य तैयार हो रहा है। केवल कैश किए गए वॉलपेपर ड्रॉइंग ट्रांज़िशन का उपयोग करेंगे।
settings-drawing-selection-view-paused = मौजूदा दृश्य की तैयारी रुकी हुई है। नीचे से इसे फिर से शुरू करें या रद्द करें।

settings-transitions-family-studio = स्टूडियो
settings-transitions-family-studio-desc = कटे, मुड़े और मंचित ट्रांज़िशन।
settings-transitions-preset-timing-label = प्रीसेट समय इस्तेमाल करें
settings-transitions-preset-timing-desc = इस ट्रांज़िशन के लिए बनाया गया समय इस्तेमाल करता है: { $duration } ms। अपनी अवधि तय करने के लिए बंद करें।
settings-transitions-effect-photo-cutout = फ़ोटो कटआउट
settings-transitions-effect-slat-turn = घूमती फ़ोटो पट्टियाँ
settings-transitions-effect-crop-relay = क्रॉप रिले
settings-transitions-effect-sunlit-arcade = धूप भरा आर्केड
settings-transitions-effect-paper-heart = फ़्रेम में काग़ज़ी दिल
settings-drawing-device-label = तैयारी का डिवाइस
settings-drawing-device-desc = चुनें कि वॉलपेपर तैयार करते समय मॉडल किस पर चलें। स्वचालित, ड्रॉइंग पैक का अपना चुनाव इस्तेमाल करता है, जो पहले CUDA, फिर WebGPU और आख़िर में CPU आज़माता है। मेमोरी सीमा पार होने पर केवल स्वचालित ही CPU पर दोबारा कोशिश करता है। CPU हर मशीन पर चलता है, लेकिन सबसे धीमा है।
settings-drawing-device-auto = स्वचालित
settings-drawing-device-cuda = CUDA (NVIDIA)
settings-drawing-device-webgpu = WebGPU
settings-drawing-device-cpu = CPU
settings-drawing-memory-label = मेमोरी सीमा
settings-drawing-memory-desc = रोके जाने से पहले तैयारी अधिकतम कितनी मेमोरी इस्तेमाल कर सकती है। स्वचालित 6 GiB की सामान्य सीमा रखता है। बड़े वॉलपेपर तैयार न हों तो इसे बढ़ाएँ, या दूसरे ऐप्स के लिए ज़्यादा मेमोरी छोड़ने को घटाएँ। स्वचालित डिवाइस के साथ, सीमा पार करने वाला GPU रन CPU पर दोबारा चलता है।
settings-drawing-memory-auto = स्वचालित (6 GiB)
settings-drawing-memory-gib = { $gib } GiB
settings-drawing-memory-mib = { $mib } MiB
