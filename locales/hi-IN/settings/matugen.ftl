settings-matugen-external-card = बाहरी Matugen
settings-matugen-external-card-desc = जब Matugen वॉलपेपर के रंग बनाए, तब अपना बाहरी कॉन्फ़िगरेशन चलाएँ।
settings-matugen-config-label = कॉन्फ़िग पथ
settings-matugen-config-desc = बाहरी matugen कॉन्फ़िग फ़ाइल का पथ।
settings-matugen-command-label = कमांड
settings-matugen-command-desc = Matugen चलाने के लिए इस्तेमाल होने वाला कमांड। आप %config%, %path%, %scheme%, %mode% और %index% को प्लेसहोल्डर के रूप में डाल सकते हैं।
settings-matugen-integrations-card = इंटीग्रेशन
settings-matugen-integrations-card-desc = हर प्रविष्टि एक टेम्पलेट को एक आउटपुट फ़ाइल में रेंडर करती है। फ़ाइल लिखे जाने के बाद एक रीलोड कमांड चल सकता है।
settings-matugen-name-label = नाम
settings-matugen-name-desc = इस इंटीग्रेशन का स्थिर पहचानकर्ता।
settings-matugen-template-label = टेम्पलेट
settings-matugen-template-desc = ऐप के रंग बनाने के लिए इस्तेमाल किया जाने वाला टेम्पलेट।
settings-matugen-output-label = आउटपुट
settings-matugen-output-desc = वह पथ जहाँ रेंडर किया गया आउटपुट लिखा जाता है।
settings-matugen-reload-label = रीलोड
settings-matugen-reload-desc = आउटपुट लिखे जाने के बाद चलाने के लिए वैकल्पिक शेल कमांड।
settings-matugen-live-preview-label = लाइव पूर्वावलोकन
settings-matugen-live-preview-desc = वॉलपेपर पर होवर करते समय Wall को फिर से रंगें। रंग केवल वॉलपेपर लागू होने के बाद बदलने के लिए इसे बंद करें।
settings-matugen-remove-desc = इस प्रविष्टि को हटाएँ।
settings-matugen-remove-action = हटाएँ
settings-matugen-add-label = इंटीग्रेशन जोड़ें
settings-matugen-add-desc = एक खाली इंटीग्रेशन जोड़ें, फिर उसका टेम्पलेट, आउटपुट फ़ाइल और वैकल्पिक रीलोड कमांड सेट करें।
settings-matugen-add-action = जोड़ें

settings-app-themes-title = ऐप थीम
settings-app-themes-desc = चुनें कि कौन से ऐप आपके रंगों का पालन करें। किसी ऐप को बंद करने पर उसका पिछला थीम सेटअप बहाल हो जाता है।
settings-app-themes-custom = कस्टम आउटपुट
settings-app-themes-custom-desc = उन्नत टेम्पलेट, आउटपुट फ़ाइलें और रीलोड कमांड।
settings-app-themes-error = ऐप थीम सेटअप विफल रहा: { $error }
settings-app-themes-scan = ऐप खोजें
settings-app-themes-scan-desc = कोई ऐप इंस्टॉल करने या उसका कॉन्फ़िगरेशन बदलने के बाद फिर से जाँचें।
settings-app-themes-loading = इंस्टॉल किए गए ऐप और उनके थीम सेटअप की जाँच के लिए Deck से कनेक्ट करें।
settings-app-themes-refresh = फिर से जाँचें
settings-app-themes-ready = आपके रंगों का पालन करने के लिए तैयार
settings-app-themes-not-installed = इंस्टॉल नहीं है
settings-app-themes-conflict = इस थीम को कोई दूसरा सेटअप नियंत्रित करता है
settings-app-themes-review = सेटअप की समीक्षा ज़रूरी है
settings-app-themes-changed = कॉन्फ़िग Skwd के बाहर बदला गया
settings-app-themes-interrupted = सेटअप बाधित हुआ
settings-app-themes-reload-needed = रंग रीफ़्रेश नहीं हो सके
settings-app-themes-reload-sent = रंग लिखे गए · रीलोड का अनुरोध किया गया
settings-app-themes-watching = रंग लिखे गए · ऐप बदलावों पर नज़र रखता है
settings-app-themes-next-open = ऐप खुलने पर लागू होता है
settings-app-themes-busy = काम चल रहा है…
settings-app-themes-configured = थीम कॉन्फ़िगर की गई
settings-app-themes-installed = इंस्टॉल है
settings-app-themes-config-found = कॉन्फ़िग मिला
settings-app-themes-config-create = पहली बार इस्तेमाल पर कॉन्फ़िग बनाता है
settings-app-themes-on = चालू
settings-app-themes-off = बंद
settings-app-themes-hide = विवरण छिपाएँ
settings-app-themes-details = विवरण
settings-app-themes-custom-conflict = इस ऐप का पहले से एक कस्टम आउटपुट है। प्रबंधित थीमिंग पर जाने से पहले उसे कस्टम आउटपुट के अंतर्गत देखें।
settings-app-themes-other-owner = इस ऐप से कोई दूसरा थीम टूल जुड़ा है। Skwd सक्षम करने से पहले उस इंटीग्रेशन को डिस्कनेक्ट करें।
settings-app-themes-restore-desc = Skwd पिछला थीम सेटअप सहेजता है और केवल अपनी सेटिंग बदलता है। असंबंधित सेटिंग में बाद के संपादन सुरक्षित रहते हैं।
settings-app-themes-config = ऐप कॉन्फ़िगरेशन
settings-app-themes-output = जनरेट किए गए रंग
settings-app-themes-adopt = प्रबंधित थीम इस्तेमाल करें
settings-app-themes-adopt-desc = पुराना कस्टम आउटपुट सहेजा रहेगा पर निष्क्रिय। Skwd इस ऐप को सेट करेगा, आपके रंग लागू करेगा और बंद करने पर बहाली संभालेगा।
settings-app-themes-custom-enabled = कस्टम आउटपुट चलाएँ
settings-app-themes-custom-enabled-desc = रंग बदलने पर यह आउटपुट जनरेट करें और उसका रीलोड कमांड चलाएँ। प्रबंधित थीमिंग पर जाने के बाद इसे बंद रखें।
settings-app-themes-undo = सेटअप पूर्ववत करें

settings-app-themes-applied = रंग लागू किए गए
settings-app-themes-refresh-colours = रंग रीफ़्रेश करें
settings-app-themes-retry-reload = ऐप खोलें, फिर दोबारा कोशिश के लिए रंग रीफ़्रेश करें चुनें।

settings-matugen-enabled-notice = वॉलपेपर के रंगों के लिए Matugen चुना गया।
settings-matugen-disabled-notice = वॉलपेपर के रंगों के लिए अंतर्निहित Iris चुना गया।

settings-app-themes-disconnected = Disconnected - keeping current colours
settings-app-themes-template-desc = Edit this template to choose which palette colours each field uses. Save the file, then refresh colours. Wallpaper changes keep your mappings.
settings-app-themes-create-template = Create editable template
settings-app-themes-copy-template = Copy template path
settings-app-themes-reset-template = Reset mappings to defaults
settings-app-themes-disconnect = Disconnect and keep current colours
settings-app-themes-disconnect-desc = Stop updating this app. Keep its current files and colours, including your edits.
settings-app-themes-reconnect = Back up edits and reconnect
settings-app-themes-reconnect-desc = Save a backup of the current files, then apply your mappings and resume colour updates. Direct edits to generated colours are replaced.

settings-app-themes-custom-output-status = मौजूदा Skwd कस्टम आउटपुट इस ऐप के रंग तय करता है
settings-app-themes-custom-switch = बदलने के लिए नीचे प्रबंधित थीम चुनें, या अपने कस्टम आउटपुट का उपयोग जारी रखने के लिए इसे जैसा है वैसा छोड़ दें।
