settings-theme-behaviour-card = व्यवहार
settings-theme-behaviour-card-desc = चुनें कि वॉलपेपर बदलने पर इंटरफ़ेस और डेस्कटॉप इंटीग्रेशन भी फिर से रंगे जाएँ या नहीं।
settings-theme-policy-label = पैलेट व्यवहार
settings-theme-policy-desc = वॉलपेपर का पालन करें हर लागू वॉलपेपर से फिर से रंगता है। स्थिर पैलेट एक चुना हुआ पैलेट इस्तेमाल करता है। वर्तमान रंग रखें थीम को छूता नहीं।
settings-theme-policy-wallpaper = वॉलपेपर का पालन करें
settings-theme-policy-fixed = स्थिर पैलेट
settings-theme-policy-off = वर्तमान रंग रखें
settings-theme-driver-card = रंग स्रोत
settings-theme-driver-card-desc = चुनें कि skwd-wall रंग स्वयं बनाए या डेस्कटॉप शेल द्वारा बनाए गए रंग आयात करे।
settings-theme-authority-label = रंग नियंत्रण
settings-theme-authority-desc = Skwd-wall नीचे का जनरेटर चलाता है; इसके बजाय डेस्कटॉप शेल वर्तमान छवि से अपना पैलेट लौटाता है।
settings-theme-authority-caelestia = Caelestia इस्तेमाल करें
settings-theme-authority-noctalia = Noctalia इस्तेमाल करें
settings-theme-authority-dms = DMS इस्तेमाल करें
settings-theme-authority-end4 = end-4 इस्तेमाल करें
settings-theme-engine-card = रंग जनरेटर
settings-theme-engine-card-desc = वह प्रोग्राम चुनें जो skwd-wall वॉलपेपर लागू होने के बाद चलाए। यहाँ केवल इंस्टॉल किए गए जनरेटर दिखते हैं।
settings-theme-engine-label = जनरेटर
settings-theme-engine-desc = अंतर्निहित Iris को किसी बाहरी प्रोग्राम की ज़रूरत नहीं। Matugen, Wallust, Pywal और बाहरी Iris अपना पैलेट जनरेशन खुद चलाते हैं।
settings-theme-engine-iris-builtin = Iris (अंतर्निहित)
settings-theme-engine-matugen = Matugen
settings-theme-engine-wallust = Wallust
settings-theme-engine-pywal = Pywal
settings-theme-engine-iris-external = Iris (बाहरी)
settings-theme-engine-native-legacy = Skwd-colour (पुराना)
settings-theme-engine-pywal-legacy = Skwd-Pywal (पुराना)
settings-theme-engine-wallust-legacy = Skwd-Wallust (पुराना)
settings-theme-appearance-card = रूप
settings-theme-appearance-card-desc = जनरेट किए गए पैलेट को इंटरफ़ेस पर लागू होने से पहले समायोजित करें।
settings-theme-scheme-label = रंग चरित्र
settings-theme-scheme-desc = तय करता है कि बीज रंग कितनी तीव्रता से फैले। Tonal spot संतुलित है, Vibrant और Expressive अधिक रंग इस्तेमाल करते हैं, Neutral और Monochrome कम।
settings-theme-scheme-tonal-spot = Tonal spot
settings-theme-scheme-vibrant = Vibrant
settings-theme-scheme-expressive = Expressive
settings-theme-scheme-neutral = Neutral
settings-theme-scheme-monochrome = Monochrome
settings-theme-scheme-fidelity = Fidelity
settings-theme-scheme-content = Content
settings-theme-scheme-rainbow = Rainbow
settings-theme-scheme-fruit-salad = Fruit salad
settings-theme-finish-label = फ़िनिश
settings-theme-finish-desc = प्राकृतिक जनरेट किए गए रंग रखता है। पेस्टल हल्का करता है, मंद असंतृप्त करता है, जीवंत संतृप्त करता है। टेक्स्ट रंग पठनीय रहते हैं।
settings-theme-finish-natural = प्राकृतिक (वॉलपेपर से)
settings-theme-finish-natural-plain = प्राकृतिक
settings-theme-finish-pastel = पेस्टल
settings-theme-finish-muted = मंद
settings-theme-finish-vibrant = जीवंत
settings-theme-variant-label = वेरिएंट
settings-theme-variant-desc = गहरा या हल्का पैलेट। स्वचालित वॉलपेपर की मापी गई चमक से चुनता है।
settings-theme-variant-dark = गहरा
settings-theme-variant-light = हल्का
settings-theme-variant-auto = स्वचालित (वॉलपेपर से)
settings-theme-fixed-card = स्थिर पैलेट
settings-theme-fixed-card-desc = चाहे कोई भी वॉलपेपर लागू हो, हमेशा एक ही पैलेट इस्तेमाल करें।
settings-theme-static-theme-label = थीम
settings-theme-static-theme-desc = कोई अंतर्निहित पैलेट, डिज़ाइनर में सहेजा हुआ पैलेट, या अपने रंगों से पैलेट बनाने के लिए कस्टम बीज चुनें।
settings-theme-static-theme-yours = { $name } (आपका)
settings-theme-static-theme-custom = कस्टम बीज
settings-theme-designer-label = थीम डिज़ाइनर
settings-theme-designer-desc = हर इंटरफ़ेस रंग को रंग चक्र पर संपादित करें और परिणाम लाइव पूर्वावलोकन में देखें। सहेजे गए पैलेट ऊपर की थीम सूची में जुड़ जाते हैं।
settings-theme-designer-action = खोलें
settings-theme-custom-colors-label = कस्टम बीज रंग
settings-theme-custom-colors-desc = अल्पविराम से अलग हेक्स रंग, जैसे #1e1e2e, #89b4fa। केवल कस्टम बीज के साथ इस्तेमाल होते हैं और पूरे पैलेट में विस्तारित होते हैं।
settings-theme-matugen-card = Matugen रूप
settings-theme-matugen-card-desc = Matugen पैलेट बनाता है और skwd-wall उसके इंटरफ़ेस रंग आयात करता है।
settings-theme-matugen-scheme-desc = टेम्पलेट और इंटरफ़ेस पैलेट के लिए Material 3 योजना। स्मार्ट में Matugen चित्र की रंगीनता के आधार पर योजना चुनता है। स्मार्ट के लिए Matugen 4.2 या नया संस्करण चाहिए।
settings-theme-interface-finish-label = इंटरफ़ेस फ़िनिश
settings-theme-interface-finish-desc = आयातित इंटरफ़ेस भूमिकाओं पर लागू वैकल्पिक अंतिम उपचार। यह Matugen के बाहरी टेम्पलेट फिर से नहीं लिखता।
settings-theme-color-index-label = स्रोत रंग सूचकांक
settings-theme-color-index-desc = बीज रंग के रूप में पैलेट का कौन सा स्लॉट इस्तेमाल हो।
settings-theme-color-index-primary = 0 (प्राथमिक)
settings-theme-contrast-label = कंट्रास्ट
settings-theme-contrast-desc = Matugen कंट्रास्ट। सीमा -1.0 से 1.0 (0 = मानक)।
settings-theme-wallust-card = Wallust
settings-theme-wallust-palette-label = पैलेट
settings-theme-wallust-palette-desc = कोई wallust पैलेट लागू करें (जैसे dark16, harddark, light16)। खाली = मोड के अनुसार स्वचालित।
settings-theme-native-card = Skwd-colour
settings-theme-native-card-desc = पुराना अंतर्निहित एक्सट्रैक्टर, मौजूदा कॉन्फ़िगरेशन के लिए रखा गया। Iris वर्तमान पैलेट प्रारूप बनाता है।
settings-theme-external-card = बाहरी पैलेट
settings-theme-external-card-desc-noctalia = Noctalia रंग जनरेशन संभालता है। skwd-wall दूसरा रंग स्रोत चलाने के बजाय तैयार पैलेट आयात करता है।
settings-theme-external-card-desc-dms = Dank Material Shell रंग जनरेशन संभालता है। skwd-wall दूसरा रंग स्रोत चलाने के बजाय तैयार पैलेट आयात करता है।
settings-theme-imported-variant-label = आयातित वेरिएंट
settings-theme-imported-variant-desc-noctalia = चुनें कि वर्तमान वॉलपेपर के लिए skwd-wall कौन सा Noctalia वेरिएंट बनाए और आयात करे।
settings-theme-imported-variant-desc-dms = चुनें कि DMS के बनाए गहरे/हल्के पैलेट का कौन सा आधा हिस्सा skwd-wall वर्तमान वॉलपेपर के लिए आयात करे।

settings-theme-matugen-smart = स्मार्ट
settings-theme-matugen-smart-mode-desc = ऑटो Skwd की चमक पहचान का उपयोग करता है। स्मार्ट में Matugen चित्र के आधार पर हल्का या गहरा मोड चुनता है। स्मार्ट के लिए Matugen 4.2 या नया संस्करण चाहिए।
