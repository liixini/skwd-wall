settings-niri-backdrop-card = Niri
settings-niri-backdrop-card-desc = अलग पृष्ठभूमि रखें या एक स्थिर वॉलपेपर इस्तेमाल करें जो केवल ओवरव्यू में धुंधला होता है।
settings-niri-show-label = ओवरव्यू में वॉलपेपर दिखाएँ
settings-niri-show-desc = अलग पृष्ठभूमि रखें या एक स्थिर वॉलपेपर इस्तेमाल करें जो केवल ओवरव्यू में धुंधला होता है।
settings-niri-blur-static-label = छवियाँ धुंधली करें
settings-niri-blur-static-desc = छवि बैकड्रॉप को लोड होते समय एक बार धुंधला करता है। ओवरव्यू खुला रहने पर इसकी लागत लगभग शून्य है।
settings-niri-blur-static-radius-label = छवि धुंधलापन त्रिज्या
settings-niri-blur-static-radius-desc = छवि बैकड्रॉप के लिए धुंधलापन त्रिज्या, 0 से 100 तक। अधिक मान अधिक नरम।
settings-niri-blur-video-label = वीडियो धुंधले करें
settings-niri-blur-video-desc = ओवरव्यू खुला रहने पर वीडियो का हर फ़्रेम धुंधला करता है। साफ़ वीडियो की तुलना में काफ़ी अधिक GPU लेता है, खासकर 4K पर।
settings-niri-blur-video-radius-label = वीडियो धुंधलापन त्रिज्या
settings-niri-blur-video-radius-desc = वीडियो बैकड्रॉप के लिए धुंधलापन त्रिज्या, 0 से 100 तक। अधिक मान अधिक नरम।
settings-niri-blur-we-label = Wallpaper Engine दृश्य धुंधले करें
settings-niri-blur-we-desc = ओवरव्यू खुला रहने पर दृश्य का हर फ़्रेम धुंधला करता है। साफ़ दृश्य की तुलना में काफ़ी अधिक GPU लेता है।
settings-niri-blur-we-radius-label = Wallpaper Engine धुंधलापन त्रिज्या
settings-niri-blur-we-radius-desc = Wallpaper Engine बैकड्रॉप के लिए धुंधलापन त्रिज्या, 0 से 100 तक। अधिक मान अधिक नरम।
settings-niri-follow-label = हमेशा वर्तमान वॉलपेपर इस्तेमाल करें
settings-niri-follow-desc = आपके लागू किए गए वॉलपेपर का अनुसरण करें। नीचे अलग बैकड्रॉप चुनने के लिए बंद करें।
settings-niri-image-label = बैकड्रॉप स्रोत
settings-niri-image-desc = किसी वॉलपेपर पर बैकड्रॉप के रूप में सेट करें चुनें, या छवि, वीडियो या Wallpaper Engine प्रोजेक्ट का पथ दर्ज करें। पिछला वॉलपेपर इस्तेमाल करने के लिए खाली छोड़ें।
settings-niri-auto-theme-label = बैकड्रॉप को ऑटो-थीम करें
settings-niri-auto-theme-desc = स्थिर छवियों को gowall थीम पैलेट से फिर से रंगें। वीडियो और Wallpaper Engine सीन अपने मूल रंग रखते हैं।
settings-niri-theme-label = बैकड्रॉप थीम
settings-niri-theme-desc = बैकड्रॉप को ऑटो-थीम करते समय इस्तेमाल होने वाला पैलेट।
settings-niri-dim-label = बैकड्रॉप मंदता
settings-niri-dim-desc = ओवरव्यू बैकड्रॉप को गहरा करें। 0 = कुछ नहीं, 100 = काला।
settings-niri-rule-label = आवश्यक niri layer-rule
settings-niri-rule-desc = लेयर नियम ~/.config/niri/config.kdl में जोड़ें। layout और overview सेटिंग मौजूदा ब्लॉक में मिलाएँ।
settings-niri-refresh-label = बैकड्रॉप अभी रीफ़्रेश करें
settings-niri-refresh-desc = चुने गए स्रोत को वर्तमान धुंधलापन, मंदता और थीम सेटिंग के साथ फिर से लोड करें।
settings-niri-refresh-action = रीफ़्रेश करें
settings-niri-copy-label = layer-rule क्लिपबोर्ड पर कॉपी करें
settings-niri-copy-desc = ऊपर का स्निपेट niri के कॉन्फ़िग के लिए कॉपी करता है।
settings-niri-copy-action = कॉपी करें

settings-niri-mode-label = ओवरव्यू मोड
settings-niri-mode-desc = अलग पृष्ठभूमि रखें या एक स्थिर वॉलपेपर इस्तेमाल करें जो केवल ओवरव्यू में धुंधला होता है।
settings-niri-mode-separate = अलग पृष्ठभूमि
settings-niri-mode-stationary = स्थिर वॉलपेपर
settings-niri-stationary-desc = वर्तमान वॉलपेपर और डिफ़ॉल्ट वीडियो रेंडरर इस्तेमाल करता है। नीचे दिया Niri कॉन्फ़िगरेशन जोड़ें। धुंधलापन और मंद करना केवल ओवरव्यू में लागू होते हैं।
