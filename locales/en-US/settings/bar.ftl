settings-bar-filter = Filter bar
settings-bar-filter-desc = The strip of type, sort and filter buttons above the picker.
settings-bar-filter-say = Shows { $val }{ $buttons }{ $end } and { $val }{ $sorts }{ $end }, laid out { $orientation ->
        [vertical] vertically
       *[horizontal] horizontally
    }. { $pinned ->
        [yes] It stays pinned.
       *[no] It hides until you need it.
    } Visual style: { $style }.
settings-bar-button-count = { $shown } of { $all } { $all ->
        [one] button
       *[other] buttons
    }
settings-bar-sort-count = { $shown } of { $all } { $all ->
        [one] sort
       *[other] sorts
    }
settings-bar-offers = What it offers
settings-bar-behaves = How it behaves
settings-bar-buttons = Buttons on the bar
settings-bar-pinned-hint = Pinned instead of auto-hiding
settings-bar-placed = Where the bar sits stays in Layout.
settings-bar-sizes = Size bands
settings-bar-sizes-desc = Resolution ranges the Size button filters by.
settings-bar-sizes-say = The Size button offers { $bands }.
settings-bar-sizes-none = No size bands yet, so the Size button has nothing to offer.
settings-bar-unnamed = unnamed
settings-bar-from = from
settings-bar-up-to = up to
settings-bar-no-limit = no upper limit
settings-bar-add-hint = A ready band, or a custom range
settings-bar-start = Where the picker starts
settings-bar-start-desc = The folder shown when the picker opens.
settings-bar-start-say = The picker opens on { $folder } and { $sticky ->
        [yes] keeps your filters after it closes.
       *[no] resets your filters each time it opens.
    }
settings-bar-sticky-hint = Keep type, folder, colour, sort, and favourite filters after the picker closes
settings-bar-search-desc = Tags match saved words. Describe finds images from a short description.
settings-bar-search-say = Search opens with { $mode ->
        [describe] Describe
       *[tags] Tags
    }. Describe search uses { $model } on the { $views ->
        [multiview] composition and crops
       *[full] full image
    }.
settings-bar-search-off = Search opens with { $mode ->
        [describe] Describe
       *[tags] Tags
    }. Describe search is off: no model loads and nothing is indexed. Tags keep working.
settings-bar-model-status = { " " }Model status: { $val }{ $status }{ $end }.
settings-bar-searching = Searching
settings-bar-unused = Not in use
settings-bar-name-hint = Shown in the active-model list
settings-bar-manual-hint = Reference a pack in place
settings-bar-forget-hint = Keeps the files
settings-bar-delete-hint = Also turns off semantic search
settings-menu-choose = Choose
settings-checks-count = { $shown } of { $all }
settings-bar-floats-hint = Place it in Arrange
settings-bar-delete-named = Delete { $name }
settings-bar-forget-named = Forget { $name }
