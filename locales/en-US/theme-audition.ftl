theme-audition-title = Colour preview
theme-audition-subtitle = Choose a colour source, then compare its profiles using the same wallpaper.
theme-audition-backend = Colour source
theme-audition-backend-on = { $backend } · on
theme-audition-selected = Selected
theme-audition-preview = Preview
theme-audition-loading = Generating previews from the current wallpaper…
theme-audition-empty = No colour previews were returned. Check that the selected colour source is installed and working.

settings-theme-profile-desc = Edit the current colours and save a profile for the wallpaper that supplies them.
theme-profile-load = Load current
theme-profile-save = Save for this wallpaper
theme-profile-enabled = Use this profile
theme-profile-dark = Dark
theme-profile-light = Light

settings-playback-pause-title = Automatic pause
settings-playback-pause-desc = Pause animated wallpapers when any enabled condition is met.
settings-playback-process-enabled = Pause when applications are running
settings-playback-process-desc = Pause all displays while a listed process is running.
settings-playback-processes = Processes
settings-playback-processes-desc = Separate executable names with commas. Names match without case sensitivity or the .exe suffix.
settings-playback-choose-process = Choose a running process
settings-playback-fullscreen = Pause on fullscreen
settings-playback-fullscreen-desc = Pause while a fullscreen window is visible. Requires compositor support.
settings-playback-scope = Window pause displays
settings-playback-scope-desc = Choose whether a window pause condition pauses its display or every display.
settings-playback-all = All displays
settings-playback-display = Display containing the window
settings-playback-resume = Resume delay
settings-playback-resume-desc = Wait after the last automatic pause condition clears. Manual pause stays in effect.
settings-playback-detection-off = Enable fullscreen or maximised-window pause to check compositor support.
settings-playback-detection-ready = Window state detection available
settings-playback-detection-unavailable = Window state detection unavailable on this compositor
settings-playback-paused-process = Paused: { $names } is running
settings-playback-paused-fullscreen = Paused: fullscreen window
settings-playback-resuming = Waiting to resume
settings-playback-no-rule = No automatic pause rule is active

settings-paper-layer-label = Wallpaper layer
settings-paper-layer-desc = Wayland layer for videos and scenes. Use Background with Niri's place-within-backdrop rule to show the active wallpaper behind the overview.
settings-paper-layer-bottom = Bottom (default)
settings-paper-layer-background = Background
settings-paper-layer-top = Top
settings-paper-layer-overlay = Overlay
settings-paper-overview-only-label = Animate only in Niri overview
settings-paper-overview-only-desc = Requires Background and place-within-backdrop. Pauses while overview is closed.
settings-playback-paused-overview = Paused while Niri overview is closed

settings-playback-maximized = Pause on maximised windows
settings-playback-maximized-desc = Pause when the compositor reports a maximised window. Requires compositor support; Niri also reports windows on hidden workspaces.
settings-playback-paused-maximized = Paused: maximised window

settings-playback-full-width = Pause on full-width columns (Niri)
settings-playback-full-width-desc = Pause when the active tiled column covers at least 90% of its display width. Includes Mod+F with normal gaps. Other workspaces do not count.
settings-playback-paused-full-width = Paused: full-width column
