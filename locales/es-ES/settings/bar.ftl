settings-bar-filter = Barra de filtros
settings-bar-filter-desc = La franja de botones de tipo, orden y filtro sobre el selector.
settings-bar-filter-say = Muestra { $val }{ $buttons }{ $end } y { $val }{ $sorts }{ $end }, en disposición { $orientation ->
        [vertical] vertical
       *[horizontal] horizontal
    }. { $visibility ->
        [hover] Se muestra mientras el puntero está sobre ella.
        [hidden] Queda oculta hasta que pulses su atajo.
       *[always] Queda siempre fija.
    } Estilo visual: { $style }.
settings-bar-button-count = { $shown } de { $all } { $all ->
        [one] botón
       *[other] botones
    }
settings-bar-sort-count = { $shown } de { $all } { $all ->
        [one] orden
       *[other] órdenes
    }
settings-bar-offers = Qué ofrece
settings-bar-behaves = Cómo se comporta
settings-bar-buttons = Botones de la barra
settings-bar-search-pinned-hint = Se abre con el selector
settings-bar-placed = Dónde se sitúa la barra se ajusta en Diseño.
settings-bar-sizes = Rangos de tamaño
settings-bar-sizes-desc = Rangos de resolución por los que filtra el botón Tamaño.
settings-bar-sizes-say = El botón Tamaño ofrece { $bands }.
settings-bar-sizes-none = Aún no hay rangos de tamaño, así que el botón Tamaño no tiene nada que ofrecer.
settings-bar-unnamed = sin nombre
settings-bar-from = desde
settings-bar-up-to = hasta
settings-bar-no-limit = sin límite superior
settings-bar-add-hint = Un rango listo o uno personalizado
settings-bar-start = Dónde empieza el selector
settings-bar-start-desc = La carpeta que se muestra al abrir el selector.
settings-bar-start-say = El selector se abre en { $folder } y { $sticky ->
        [yes] conserva tus filtros al cerrarse.
       *[no] restablece tus filtros cada vez que se abre.
    }
settings-bar-sticky-hint = Conserva los filtros de tipo, carpeta, color, orden y favoritos al cerrar el selector
settings-bar-search-desc = Etiquetas busca palabras guardadas. Describir encuentra imágenes a partir de una descripción corta.
settings-bar-search-say = La búsqueda se abre con { $mode ->
        [describe] Describir
       *[tags] Etiquetas
    }. La búsqueda Describir usa { $model } sobre { $views ->
        [multiview] la composición y los recortes
       *[full] la imagen completa
    }.
settings-bar-search-off = La búsqueda se abre con { $mode ->
        [describe] Describir
       *[tags] Etiquetas
    }. La búsqueda Describir está desactivada: no se carga ningún modelo ni se indexa nada. Las etiquetas siguen funcionando.
settings-bar-model-status = { " " }Estado del modelo: { $val }{ $status }{ $end }.
settings-bar-searching = Búsqueda
settings-bar-unused = Sin usar
settings-bar-name-hint = Se muestra en la lista de modelos activos
settings-bar-manual-hint = Hace referencia a un paquete en su sitio
settings-bar-forget-hint = Conserva los archivos
settings-bar-delete-hint = También desactiva la búsqueda semántica
settings-menu-choose = Elegir
settings-checks-count = { $shown } de { $all }
settings-bar-floats-hint = Colócalo en Organizar
settings-bar-delete-named = Eliminar { $name }
settings-bar-forget-named = Olvidar { $name }
