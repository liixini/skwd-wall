settings-selector-layout-card = Diseño
settings-selector-display-mode-label = Modo de visualización
settings-selector-display-mode-desc = Elige cómo se ordenan las tarjetas de fondos en el selector.
settings-selector-filter-motion-label = Movimiento del filtro
settings-selector-filter-motion-desc = Qué tan rápido gira el rollo cuando cambian los resultados del filtro. Los tres pesos compartidos están en los ajustes de Movimiento.
settings-selector-presets-card = Preajustes
settings-selector-presets-card-desc = Guarda los ajustes de diseño actuales o aplica un conjunto guardado. Cada modo de visualización mantiene sus propios preajustes.
settings-selector-preset-name-label = Nombre
settings-selector-preset-name-desc = Renombra el preajuste seleccionado. Guardar actual crea un nuevo preajuste con nombre automático.
settings-selector-preset-name-placeholder = Nombre del estilo
settings-selector-preset-generated-name = Estilo { $number }
settings-selector-saved-styles-label = Estilos guardados
settings-selector-live-preview-card = Vista previa de color
settings-selector-live-preview-label = Previsualizar temas al pasar por encima
settings-selector-live-preview-desc = Recolorea el selector desde el fondo bajo el puntero. El tema actual vuelve al salir el puntero, a menos que apliques.
settings-selector-type-badges-label = Mostrar insignias de tipo
settings-selector-type-badges-desc = Marca las tarjetas de fondos como Img, Vid o WE para que el tipo de archivo sea visible sin abrir la tarjeta.
settings-selector-composition-card = Composición
settings-selector-composition-card-desc-hex = Elige la forma general del campo y luego ajusta su curvatura, forma de mosaico, filas y columnas.
settings-selector-composition-card-desc-wall = Elige un diseño de muro y luego ajusta su densidad, espaciado y tarjetas.
settings-selector-hex-curve-label = Modo Geometric
settings-selector-hex-curve-desc = Elige si todo el campo permanece plano o se curva en arco, onda, forma de S o cilindro.
settings-selector-hex-curve-flat = Plano
settings-selector-hex-curve-arc = Arco
settings-selector-hex-curve-wave = Cinta
settings-selector-hex-curve-s = Curva S
settings-selector-hex-curve-cylinder = Cilindro
settings-selector-hex-shape-label = Familia de mosaicos
settings-selector-hex-shape-desc = Elige un mosaico teselado. Diamante y Rombo envuelven un fondo en geometría vertical u horizontal.
settings-selector-hex-shape-triangle = Triángulo
settings-selector-hex-shape-hexagon = Hexágono
settings-selector-hex-shape-diamond = Diamante
settings-selector-hex-shape-rhombus = Rombo
settings-selector-hex-intensity-label = Intensidad de curvatura
settings-selector-hex-intensity-desc = Mueve a la derecha para curvar más la forma del campo seleccionada.
settings-selector-hex-waves-label = Ondas
settings-selector-hex-waves-desc = Cuántas ondas de cinta cruzan el campo.
settings-selector-hex-orbit-radius-label = Radio del cilindro
settings-selector-hex-orbit-radius-desc = Valores más pequeños envuelven el campo con más fuerza.
settings-selector-hex-rows-label = Filas
settings-selector-hex-cols-label = Columnas
settings-selector-cells-card = Celdas
settings-selector-cells-card-desc = Cambia el tamaño de mosaico y el espaciado sin cambiar la forma del campo seleccionada.
settings-selector-hex-cell-size-label = Tamaño de celda
settings-selector-hex-gap-x-label = Espaciado horizontal
settings-selector-hex-gap-y-label = Espaciado vertical
settings-selector-wall-mode-label = Modo Wall
settings-selector-wall-mode-desc = Elige cómo Wall organiza las tarjetas. Cada modo usa diferente tamaño de filas y comportamiento de desplazamiento.
settings-selector-wall-mode-uniform = Uniforme
settings-selector-wall-mode-brick = Ladrillo
settings-selector-wall-mode-masonry = Mampostería
settings-selector-wall-mode-justified = Justificado
settings-selector-wall-mode-editorial = Editorial
settings-selector-wall-mode-cylinder = Cilindro
settings-selector-grid-columns-label = Columnas
settings-selector-grid-rows-label = Filas
settings-selector-grid-stagger-label = Equilibrio
settings-selector-grid-stagger-desc = Cambia el desplazamiento de filas alternas o el tamaño de la tarjeta principal en modo Editorial.
settings-selector-grid-bend-label = Curvatura
settings-selector-grid-bend-desc = Positivo se curva hacia fuera; negativo se arquea hacia ti.
settings-selector-grid-cylinder-radius-label = Radio del cilindro
settings-selector-grid-cylinder-radius-desc = Valores más pequeños hacen el envoltorio más ajustado.
settings-selector-cards-card = Tarjetas
settings-selector-cards-card-desc = Ajusta tamaño de tarjeta, espaciado y forma de esquinas.
settings-selector-card-width-label = Ancho de tarjeta
settings-selector-card-height-label = Alto de tarjeta
settings-selector-grid-gap-x-label = Espaciado horizontal
settings-selector-grid-gap-x-desc = Espacio visible de borde a borde entre columnas.
settings-selector-grid-gap-y-label = Espaciado vertical
settings-selector-grid-gap-y-desc = Espacio visible de borde a borde entre filas.
settings-selector-grid-round-label = Esquinas redondeadas
settings-selector-grid-round-desc = Desactivado usa esquinas rectas para cada tarjeta de Wall.
settings-selector-grid-corner-radius-label = Radio de esquina
settings-selector-grid-corner-radius-desc = Redondeo usado mientras las esquinas redondeadas están activadas.
settings-selector-performance-card = Rendimiento
settings-selector-performance-card-desc = Cada grano es geometría separada. Granos más grandes significan menos formas y mucho menos trabajo de GPU.
settings-selector-sand-note-discrete = Esta carga es pequeña para la GPU discreta detectada. El mismo tamaño de grano puede ser unas 150 veces más lento en una GPU integrada.
settings-selector-sand-note-integrated = Sand puede estar limitado por GPU en esta GPU integrada. Aumenta el tamaño de grano o mantén activado el detalle de movimiento automático.
settings-selector-sand-meter-label = { $count } granos/fotograma  ·  { $load }
settings-selector-sand-meter-desc = Grano { $grain } en una imagen central típica · { $card } ({ $tier }) · { $note }
settings-selector-sand-load-very-heavy = Muy pesado
settings-selector-sand-load-heavy = Pesado
settings-selector-sand-load-moderate = Moderado
settings-selector-sand-load-light = Ligero
settings-selector-grain-size-label = Tamaño de grano
settings-selector-grain-size-desc = Tamaño de grano en píxeles. 1 significa un grano por píxel de imagen y es el más pesado; granos más grandes se ven más toscos pero cuestan mucho menos.
settings-selector-render-scale-label = Escala de renderizado
settings-selector-render-scale-desc = Renderiza arena a menor resolución y escala. Ahorra menos que el tamaño de grano, porque los granos son geometría y no píxeles.
settings-selector-lod-auto-label = Detalle de movimiento automático
settings-selector-lod-auto-desc = Aumenta el tamaño de grano al desplazarse rápido. Activado por defecto en GPUs integradas, donde reduce el coste de movimiento unas 3,5 veces.
settings-selector-lod-strength-label = Intensidad de detalle de movimiento
settings-selector-lod-strength-desc = Multiplicador máximo de grano a velocidad máxima de desplazamiento cuando el detalle de movimiento está activo.
settings-selector-sandy-card = Sandy
settings-selector-sandy-card-desc = El fondo actual queda centrado sobre una fila de miniaturas redondas. Elegir otro rompe ambas imágenes en granos que salen y entran por bordes opuestos.
settings-selector-sandy-center-label = Altura central
settings-selector-sandy-slice-height-label = Alto de rebanada
settings-selector-sandy-slice-width-label = Ancho de rebanada
settings-selector-sandy-gap-label = Separación
settings-selector-sandy-gap-desc = Separación entre rebanadas inclinadas en su punto medio vertical. 0 hace que los bordes se toquen; valores negativos se solapan.
settings-selector-sandy-skew-label = Inclinación
settings-selector-sandy-edge-speed-label = Desplazamiento de bordes
settings-selector-sandy-edge-speed-desc = Velocidad de desplazamiento del carrusel en los bordes, 100 = por defecto.
settings-selector-sand-card = Arena
settings-selector-sand-card-desc = Cómo viajan los granos. Todos los porcentajes, 100 = por defecto.
settings-selector-sandy-duration-label = Duración
settings-selector-sandy-duration-desc = Tiempo total desde que la imagen antigua empieza a salir hasta que la nueva termina de formarse.
settings-selector-sandy-blend-label = Mezcla
settings-selector-sandy-blend-desc = Longitud del barrido de color; los fundidos de anillo van a la mitad de esto.
settings-selector-sandy-strands-label = Cintas
settings-selector-sandy-strands-desc = Divide los granos en más o menos flujos visibles.
settings-selector-sandy-twist-label = Giro
settings-selector-sandy-twist-desc = Intensidad de tirabuzón a lo largo de cada cinta.
settings-selector-sandy-orbit-label = Órbita
settings-selector-sandy-orbit-desc = Qué tan ancho giran los granos alrededor de su cinta.
settings-selector-sandy-turbulence-label = Turbulencia
settings-selector-sandy-turbulence-desc = Torsión aleatoria de las trayectorias de las cintas.
settings-selector-sandy-waist-label = Cintura
settings-selector-sandy-waist-desc = Estrechamiento a mitad del vuelo de los flujos; menor = garganta más estrecha.
settings-selector-sandy-front-label = Frente
settings-selector-sandy-front-desc = Escalonamiento de cuándo salen diferentes partes de la imagen antigua. Valores más altos mantienen regiones posteriores más tiempo.
settings-selector-sandy-fan-label = Abanico
settings-selector-sandy-fan-desc = Dispersión del flujo en los bordes, o remolino en modo vórtice.
settings-selector-swap-style-label = Estilo de intercambio
settings-selector-swap-style-desc = Elige la trayectoria que siguen los granos entre la imagen antigua y la nueva.
settings-selector-sandy-arc-label = Arco
settings-selector-sandy-arc-desc = Tamaño del bucle cuando está activado el intercambio de bucle por esquina.
settings-selector-swap-loop-label = Intercambio de bucle por esquina
settings-selector-swap-loop-desc = Al interrumpir selecciones, los granos hacen bucle por la esquina superior en lugar de elevarse al anillo giratorio.
settings-selector-outgoing-live-label = El vídeo saliente permanece activo
settings-selector-outgoing-live-desc = Mantén el vídeo antiguo reproduciéndose mientras se convierte en arena. Los cambios de vídeo a vídeo ejecutan un segundo decodificador hasta que termina la transición; desactivado lleva un fotograma congelado sin coste extra.
settings-selector-ring-card = Anillo
settings-selector-ring-card-desc = Estos ajustes controlan el anillo giratorio de granos mostrado al moverse rápido entre fondos. Un valor de 100 es el predeterminado.
settings-selector-ring-size-label = Tamaño
settings-selector-ring-size-desc = Diámetro de órbita relativo al héroe. El anillo sigue la relación de aspecto del héroe; 100 conserva el tamaño diseñado.
settings-selector-ring-spin-label = Giro
settings-selector-ring-spin-desc = Velocidad orbital de la banda.
settings-selector-ring-wave-label = Onda
settings-selector-ring-wave-desc = Ondulación radial que recorre la banda.
settings-selector-ring-soft-label = Suavidad
settings-selector-ring-soft-desc = Valores más altos usan granos más grandes y tenues y hacen el anillo menos definido.
settings-selector-ring-blend-label = Mezcla del anillo
settings-selector-ring-blend-desc = Longitud del barrido de color mientras está anillado.
settings-selector-ring-hold-label = Retardo de asentamiento
settings-selector-ring-hold-desc = Cuánto tiempo tras la última selección antes de que el anillo se fije al héroe.
settings-selector-slice-size-card = Tamaño de rebanada
settings-selector-slice-height-label = Alto de rebanada
settings-selector-visible-count-label = Elementos visibles
settings-selector-expanded-width-label = Ancho seleccionado
settings-selector-slice-width-label = Ancho de rebanada
settings-selector-slice-gap-label = Separación
settings-selector-slice-gap-desc = Separación entre rebanadas inclinadas en su punto medio vertical. 0 hace que los bordes se toquen; valores negativos se solapan.
settings-selector-skew-label = Inclinación
settings-selector-edge-tilt-label = Inclinación de bordes
settings-selector-edge-tilt-desc = Inclina los bordes superior e inferior. Valores positivos elevan el borde derecho; negativos elevan el izquierdo.
settings-selector-wobble-label = Bamboleo
settings-selector-wobble-desc = Las tarjetas se doblan en la dirección de desplazamiento y rebotan al detenerse. Movimiento más rápido también separa los canales de color.
settings-selector-wobble-strength-label = Intensidad de bamboleo
settings-selector-wobble-strength-desc = Un valor de 100 es el predeterminado. 200 duplica la curvatura y la separación de colores.
settings-selector-corners-card = Esquinas
settings-selector-round-corners-label = Esquinas redondeadas
settings-selector-round-corners-desc = Aplica un radio de esquina a los bordes de rebanada.
settings-selector-corner-tl-label = Superior izquierda
settings-selector-corner-tl-desc = Radio de esquina superior izquierda. 0 = cuadrada.
settings-selector-corner-tr-label = Superior derecha
settings-selector-corner-tr-desc = Radio de esquina superior derecha. 0 = cuadrada.
settings-selector-corner-br-label = Inferior derecha
settings-selector-corner-br-desc = Radio de esquina inferior derecha. 0 = cuadrada.
settings-selector-corner-bl-label = Inferior izquierda
settings-selector-corner-bl-desc = Radio de esquina inferior izquierda. 0 = cuadrada.
settings-selector-card-flip-card = Giro de tarjeta
settings-selector-card-flip-card-desc = Elige cómo una tarjeta de fondo cambia de su miniatura a los detalles del reverso.
settings-selector-flip-effect-label = Efecto
settings-selector-flip-effect-desc = El shader de miniatura usado durante la primera fase.
settings-selector-flip-shader-label = Shader de miniatura
settings-selector-flip-shader-desc = Desactívalo para omitir el efecto de miniatura y revelar el reverso directamente.
settings-selector-flip-back-label = Revelado del reverso
settings-selector-flip-back-desc = Desactívalo para encajar el panel trasero tras terminar el efecto de miniatura.
settings-selector-flip-duration-label = Sobrescribir duración
settings-selector-flip-duration-desc = Tiempo total de giro de tarjeta. Sobrescribe intencionalmente los pesos de movimiento compartidos de la interfaz.
settings-selector-tag-cloud-card = Nube de etiquetas
settings-selector-tag-cloud-card-desc = El panel de filtro de etiquetas que aparece debajo del selector.
settings-selector-tag-cloud-width-label = Ancho
settings-selector-tag-cloud-width-desc = Ancho del panel de nube de etiquetas.
settings-selector-tag-cloud-rows-label = Filas de etiquetas clicables
settings-selector-tag-cloud-rows-desc = Cuántas filas de sugerencias clicables se abren debajo del campo de búsqueda.
settings-selector-tag-cloud-rows-one = 1 fila
settings-selector-tag-cloud-rows-two = 2 filas
settings-selector-tag-cloud-rows-three = 3 filas
settings-selector-video-preview-card = Vista previa de vídeo
settings-selector-video-preview-card-desc = Una vista previa en movimiento al pasar por encima o seleccionar un vídeo.
settings-selector-video-preview-label = Activar vista previa de vídeo
settings-selector-video-preview-desc = Anima el vídeo mismo al pasar por encima/seleccionar en lugar de una miniatura estática.
settings-selector-preview-delay-label = Retardo de vista previa
settings-selector-preview-delay-desc = Espera este tiempo al pasar por encima/seleccionar antes de iniciar la vista previa (ms).
settings-selector-tag-cloud-position-card = Posición del panel de búsqueda
settings-selector-tag-cloud-position-card-desc = Mueve el panel de búsqueda horizontal o verticalmente en píxeles. Desplazamientos horizontales positivos lo mueven a la derecha; verticales hacia abajo.
settings-selector-tag-offset-x-label = Desplazamiento horizontal del panel de búsqueda
settings-selector-tag-offset-x-desc = Mueve el panel de búsqueda a izquierda o derecha respecto a este selector.
settings-selector-tag-offset-y-label = Desplazamiento vertical del panel de búsqueda
settings-selector-tag-offset-y-desc = Mueve el panel de búsqueda arriba o abajo respecto a este selector.
settings-selector-mode-slices = Slices
settings-selector-mode-hex = Geometric
settings-selector-mode-wall = Wall
settings-selector-mode-sandy = Sandy
settings-selector-gpu-tier-discrete = Discreta
settings-selector-gpu-tier-integrated = Integrada
settings-selector-gpu-tier-other = Otra
settings-selector-swap-style-vortex = Vórtice
settings-selector-swap-style-hourglass = Reloj de arena
settings-selector-swap-style-castle = Castillo de arena
settings-selector-swap-style-saltation = Saltación
settings-selector-swap-style-pour = Vertido de vaso
settings-selector-swap-style-orbit = Vorágine
settings-selector-swap-style-burst = Explosión
settings-selector-swap-style-weave = Tejido
settings-selector-swap-style-bloom = Floración
settings-selector-swap-style-flock = Bandada
settings-selector-swap-style-ring = Anillo
settings-selector-preset-rename-hint = Selecciona un estilo para renombrar
settings-selector-preset-save-current = Guardar actual
