settings-selector-layout-card = লেআউট
settings-selector-display-mode-label = প্রদর্শন মোড
settings-selector-display-mode-desc = পিকারে ওয়ালপেপার কার্ডগুলো কীভাবে সাজানো হবে তা বেছে নিন।
settings-selector-filter-motion-label = ফিল্টার গতি
settings-selector-filter-motion-desc = ফিল্টারের ফলাফল বদলালে রোল কত দ্রুত চলবে। তিনটি ভাগ করা ওজন গতি সেটিংসে আছে।
settings-selector-presets-card = প্রিসেট
settings-selector-preset-generated-name = স্টাইল { $number }
settings-selector-saved-styles-label = সংরক্ষিত স্টাইল
settings-selector-live-preview-card = রঙের প্রিভিউ
settings-selector-live-preview-label = হোভারে থিম প্রিভিউ
settings-selector-live-preview-desc = পয়েন্টারের নিচের ওয়ালপেপার থেকে পিকারের রং বদলায়। প্রয়োগ না করলে পয়েন্টার সরে গেলে বর্তমান থিম ফিরে আসে।
settings-selector-type-badges-label = ধরনের ব্যাজ দেখান
settings-selector-type-badges-desc = ওয়ালপেপার কার্ডে Pic, Vid বা WE চিহ্ন দেখায়, যাতে কার্ড না খুলেই ফাইলের ধরন বোঝা যায়।
settings-selector-composition-card = বিন্যাস
settings-selector-composition-card-desc-hex = ক্ষেত্রের সামগ্রিক আকার বেছে নিন, তারপর এর বাঁক, টাইলের আকৃতি, সারি ও কলাম সামঞ্জস্য করুন।
settings-selector-composition-card-desc-wall = একটি Wall লেআউট বেছে নিন, তারপর এর ঘনত্ব, ফাঁক ও কার্ড সামঞ্জস্য করুন।
settings-selector-hex-curve-label = Geometric মোড
settings-selector-hex-curve-desc = পুরো ক্ষেত্র সমতল থাকবে, নাকি ধনুক, ঢেউ, S আকৃতি বা সিলিন্ডারে বাঁকবে তা বেছে নিন।
settings-selector-hex-curve-flat = সমতল
settings-selector-hex-curve-arc = ধনুক
settings-selector-hex-curve-wave = রিবন
settings-selector-hex-curve-s = S বাঁক
settings-selector-hex-curve-cylinder = সিলিন্ডার
settings-selector-hex-shape-label = টাইলের ধরন
settings-selector-hex-shape-desc = একটি টেসেলেটিং টাইল বেছে নিন। ডায়মন্ড ও রম্বস একটি ওয়ালপেপারকে উল্লম্ব বা অনুভূমিক জ্যামিতিতে মোড়ে।
settings-selector-hex-shape-triangle = ত্রিভুজ
settings-selector-hex-shape-hexagon = ষড়ভুজ
settings-selector-hex-shape-diamond = ডায়মন্ড
settings-selector-hex-shape-rhombus = রম্বস
settings-selector-hex-intensity-label = বাঁকের মাত্রা
settings-selector-hex-intensity-desc = নির্বাচিত ক্ষেত্রের আকার আরও বেশি বাঁকাতে ডানে সরান।
settings-selector-hex-waves-label = ঢেউ
settings-selector-hex-waves-desc = ক্ষেত্র জুড়ে কতগুলো রিবন ঢেউ যাবে।
settings-selector-hex-orbit-radius-label = সিলিন্ডারের ব্যাসার্ধ
settings-selector-hex-orbit-radius-desc = ছোট মান ক্ষেত্রটিকে আরও আঁটসাঁট করে মোড়ে।
settings-selector-hex-rows-label = সারি
settings-selector-hex-cols-label = কলাম
settings-selector-cells-card = সেল
settings-selector-cells-card-desc = নির্বাচিত ক্ষেত্রের আকার না বদলে টাইলের মাপ ও ফাঁক বদলান।
settings-selector-hex-cell-size-label = সেলের মাপ
settings-selector-hex-gap-x-label = অনুভূমিক ফাঁক
settings-selector-hex-gap-y-label = উল্লম্ব ফাঁক
settings-selector-wall-mode-label = Wall মোড
settings-selector-wall-mode-desc = Wall কীভাবে কার্ড সাজাবে তা বেছে নিন। প্রতিটি মোডে সারির মাপ ও স্ক্রলের আচরণ আলাদা।
settings-selector-wall-mode-uniform = অভিন্ন
settings-selector-wall-mode-brick = ইট
settings-selector-wall-mode-masonry = গাঁথুনি
settings-selector-wall-mode-justified = জাস্টিফাইড
settings-selector-wall-mode-editorial = সম্পাদকীয়
settings-selector-wall-mode-cylinder = সিলিন্ডার
settings-selector-grid-columns-label = কলাম
settings-selector-grid-rows-label = সারি
settings-selector-grid-stagger-label = ভারসাম্য
settings-selector-grid-stagger-desc = পর্যায়ক্রমিক সারির অফসেট বদলান, বা সম্পাদকীয় মোডে প্রধান কার্ডের মাপ।
settings-selector-grid-bend-label = বক্রতা
settings-selector-grid-bend-desc = ধনাত্মক মান দূরে মোড়ে; ঋণাত্মক মান আপনার দিকে বাঁকে।
settings-selector-grid-cylinder-radius-label = সিলিন্ডারের ব্যাসার্ধ
settings-selector-grid-cylinder-radius-desc = ছোট মানে মোড়ানো আরও আঁটসাঁট হয়।
settings-selector-cards-card = কার্ড
settings-selector-cards-card-desc = কার্ডের মাপ, ফাঁক ও কোণার আকৃতি সামঞ্জস্য করুন।
settings-selector-card-width-label = কার্ডের প্রস্থ
settings-selector-card-height-label = কার্ডের উচ্চতা
settings-selector-grid-gap-x-label = অনুভূমিক ফাঁক
settings-selector-grid-gap-x-desc = কলামগুলোর মধ্যে দৃশ্যমান প্রান্ত-থেকে-প্রান্ত ফাঁক।
settings-selector-grid-gap-y-label = উল্লম্ব ফাঁক
settings-selector-grid-gap-y-desc = সারিগুলোর মধ্যে দৃশ্যমান প্রান্ত-থেকে-প্রান্ত ফাঁক।
settings-selector-performance-card = কর্মক্ষমতা
settings-selector-performance-card-desc = প্রতিটি দানা আলাদা জ্যামিতি। বড় দানা মানে কম আকৃতি এবং GPU-র অনেক কম কাজ।
settings-selector-sand-note-discrete = শনাক্ত করা ডিসক্রিট GPU-র জন্য এই লোড কম। একই দানার মাপ ইন্টিগ্রেটেড GPU-তে প্রায় 150 গুণ ধীর হতে পারে।
settings-selector-sand-note-integrated = এই ইন্টিগ্রেটেড GPU-তে Sand GPU-নির্ভর হতে পারে। দানার মাপ বাড়ান বা স্বয়ংক্রিয় গতি বিবরণ চালু রাখুন।
settings-selector-sand-meter-label = { $count } দানা/ফ্রেম  ·  { $load }
settings-selector-sand-meter-desc = সাধারণ কেন্দ্রীয় ছবিতে দানা { $grain } · { $card } ({ $tier }) · { $note }
settings-selector-sand-load-very-heavy = অত্যন্ত ভারী
settings-selector-sand-load-heavy = ভারী
settings-selector-sand-load-moderate = মাঝারি
settings-selector-sand-load-light = হালকা
settings-selector-grain-size-label = দানার মাপ
settings-selector-grain-size-desc = পিক্সেলে দানার মাপ। 1 মানে ছবির প্রতি পিক্সেলে একটি দানা, যা সবচেয়ে ভারী; বড় দানা মোটা দেখায় কিন্তু খরচ অনেক কম।
settings-selector-render-scale-label = রেন্ডার স্কেল
settings-selector-render-scale-desc = কম রেজোলিউশনে বালি রেন্ডার করে বড় করে। দানার মাপের চেয়ে কম সাশ্রয় হয়, কারণ দানা পিক্সেল নয়, জ্যামিতি।
settings-selector-lod-auto-label = স্বয়ংক্রিয় গতি বিবরণ
settings-selector-lod-auto-desc = দ্রুত স্ক্রল করার সময় দানার মাপ বাড়ায়। ইন্টিগ্রেটেড GPU-তে ডিফল্টভাবে চালু, যেখানে এটি গতির খরচ প্রায় 3.5 গুণ কমায়।
settings-selector-lod-strength-label = গতি বিবরণের মাত্রা
settings-selector-lod-strength-desc = গতি বিবরণ চলাকালীন পূর্ণ স্ক্রল গতিতে দানার সর্বোচ্চ গুণক।
settings-selector-sandy-card = Sandy
settings-selector-sandy-card-desc = বর্তমান ওয়ালপেপার গোল থাম্বনেইলের একটি সারির ওপরে কেন্দ্রে থাকে। অন্যটি বাছলে দুটি ছবিই দানায় ভেঙে বিপরীত প্রান্ত দিয়ে বেরিয়ে যায় ও ঢোকে।
settings-selector-sandy-center-label = কেন্দ্রের উচ্চতা
settings-selector-sandy-slice-height-label = স্লাইসের উচ্চতা
settings-selector-sandy-slice-width-label = স্লাইসের প্রস্থ
settings-selector-sandy-gap-label = ফাঁক
settings-selector-sandy-gap-desc = তির্যক স্লাইসগুলোর উল্লম্ব মধ্যবিন্দুতে ফাঁক। 0 হলে প্রান্ত স্পর্শ করে; ঋণাত্মক মানে ওভারল্যাপ হয়।
settings-selector-sandy-skew-label = তির্যকতা
settings-selector-sandy-edge-speed-label = প্রান্ত স্ক্রল
settings-selector-sandy-edge-speed-desc = পর্দার প্রান্তে ক্যারোসেল সরার গতি, 100 = ডিফল্ট।
settings-selector-sand-card = বালি
settings-selector-sand-card-desc = দানাগুলো কীভাবে চলে। সবই শতাংশ, 100 = ডিফল্ট।
settings-selector-sandy-duration-label = সময়কাল
settings-selector-sandy-duration-desc = পুরোনো ছবি বেরোতে শুরু করা থেকে নতুন ছবি পুরোপুরি গঠিত হওয়া পর্যন্ত মোট সময়।
settings-selector-sandy-blend-label = মিশ্রণ
settings-selector-sandy-blend-desc = রং বদলের দৈর্ঘ্য; রিং ফেড এর অর্ধেকে চলে।
settings-selector-sandy-strands-label = রিবন
settings-selector-sandy-strands-desc = দানাগুলোকে কম বা বেশি দৃশ্যমান ধারায় ভাগ করুন।
settings-selector-sandy-twist-label = মোচড়
settings-selector-sandy-twist-desc = প্রতিটি রিবন বরাবর পেঁচানোর তীব্রতা।
settings-selector-sandy-orbit-label = কক্ষপথ
settings-selector-sandy-orbit-desc = দানাগুলো তাদের রিবনের চারপাশে কত চওড়া হয়ে ঘোরে।
settings-selector-sandy-turbulence-label = অস্থিরতা
settings-selector-sandy-turbulence-desc = রিবনের পথের এলোমেলো মোচড়।
settings-selector-sandy-waist-label = কোমর
settings-selector-sandy-waist-desc = উড়ন্ত অবস্থায় ধারাগুলোর মাঝখানের সংকোচন; কম = সরু গলা।
settings-selector-sandy-front-label = সম্মুখ
settings-selector-sandy-front-desc = পুরোনো ছবির বিভিন্ন অংশ কখন বেরোবে তার ব্যবধান। বেশি মানে পরের অংশগুলো বেশিক্ষণ জায়গায় থাকে।
settings-selector-sandy-fan-label = পাখা
settings-selector-sandy-fan-desc = প্রান্তে ধারার ছড়ানো, বা ঘূর্ণি মোডে ঘোরা।
settings-selector-swap-style-label = অদলবদলের ধরন
settings-selector-swap-style-desc = পুরোনো ও নতুন ছবির মধ্যে দানাগুলো কোন পথে যাবে তা বেছে নিন।
settings-selector-sandy-arc-label = বৃত্তচাপ
settings-selector-sandy-arc-desc = কোণার লুপ অদলবদল চালু থাকলে লুপের মাপ।
settings-selector-swap-loop-label = কোণার লুপ অদলবদল
settings-selector-swap-loop-desc = মাঝপথে বাছাই করলে দানাগুলো ঘূর্ণায়মান রিংয়ে না উঠে ওপরের কোণা দিয়ে লুপ করে।
settings-selector-outgoing-live-label = বিদায়ী ভিডিও চালু থাকে
settings-selector-outgoing-live-desc = পুরোনো ভিডিও বালিতে পরিণত হওয়ার সময়ও চলতে থাকে। ভিডিও থেকে ভিডিওতে বদলালে ট্রানজিশন শেষ না হওয়া পর্যন্ত দ্বিতীয় একটি ডিকোডার চলে; বন্ধ থাকলে বাড়তি খরচ ছাড়াই একটি স্থির ফ্রেম বহন করে।
settings-selector-ring-card = রিং
settings-selector-ring-card-desc = ওয়ালপেপারের মধ্যে দ্রুত সরার সময় দেখানো ঘূর্ণায়মান দানার রিং এই সেটিংস নিয়ন্ত্রণ করে। 100 মান ডিফল্ট।
settings-selector-ring-size-label = মাপ
settings-selector-ring-size-desc = মূল ছবির তুলনায় কক্ষপথের ব্যাস। রিং তবুও মূল ছবির অনুপাত অনুসরণ করে; 100 নকশার মাপ বজায় রাখে।
settings-selector-ring-spin-label = ঘূর্ণন
settings-selector-ring-spin-desc = ব্যান্ডের কক্ষপথের গতি।
settings-selector-ring-wave-label = ঢেউ
settings-selector-ring-wave-desc = ব্যান্ড জুড়ে বয়ে যাওয়া রেডিয়াল ঢেউ।
settings-selector-ring-soft-label = কোমলতা
settings-selector-ring-soft-desc = বেশি মানে বড় ও অস্পষ্ট দানা ব্যবহৃত হয় এবং রিং কম তীক্ষ্ণ দেখায়।
settings-selector-ring-blend-label = রিং মিশ্রণ
settings-selector-ring-blend-desc = রিং অবস্থায় রং বদলের দৈর্ঘ্য।
settings-selector-ring-hold-label = থিতু হওয়ার বিলম্ব
settings-selector-ring-hold-desc = শেষ বাছাইয়ের কতক্ষণ পরে রিং মূল ছবিতে স্থির হবে।
settings-selector-slice-size-card = স্লাইসের মাপ
settings-selector-slice-height-label = স্লাইসের উচ্চতা
settings-selector-visible-count-label = দৃশ্যমান আইটেম
settings-selector-expanded-width-label = নির্বাচিতটির প্রস্থ
settings-selector-slice-width-label = স্লাইসের প্রস্থ
settings-selector-slice-gap-label = ফাঁক
settings-selector-slice-gap-desc = তির্যক স্লাইসগুলোর উল্লম্ব মধ্যবিন্দুতে ফাঁক। 0 হলে প্রান্ত স্পর্শ করে; ঋণাত্মক মানে ওভারল্যাপ হয়।
settings-selector-skew-label = তির্যকতা
settings-selector-edge-tilt-label = প্রান্তের ঢাল
settings-selector-edge-tilt-desc = ওপরের ও নিচের প্রান্ত হেলান। ধনাত্মক মান ডান প্রান্ত ওঠায়; ঋণাত্মক মান বাম প্রান্ত ওঠায়।
settings-selector-wobble-label = দোলন
settings-selector-wobble-desc = কার্ড স্ক্রলের দিকে বাঁকে এবং স্ক্রল থামলে ফিরে আসে। দ্রুত সরালে রঙের চ্যানেলগুলোও আলাদা হয়।
settings-selector-wobble-strength-label = দোলনের মাত্রা
settings-selector-wobble-strength-desc = 100 মান ডিফল্ট। 200 মানে বাঁক ও রং বিচ্ছেদ দ্বিগুণ হয়।
settings-selector-corners-card = কোণা
settings-selector-card-flip-card = কার্ড উল্টানো
settings-selector-card-flip-card-desc = ওয়ালপেপার কার্ড থাম্বনেইল থেকে পেছনের বিবরণে কীভাবে বদলাবে তা বেছে নিন।
settings-selector-flip-effect-label = ইফেক্ট
settings-selector-flip-effect-desc = প্রথম পর্যায়ে ব্যবহৃত থাম্বনেইল শেডার।
settings-selector-flip-shader-label = থাম্বনেইল শেডার
settings-selector-flip-shader-desc = বন্ধ করলে থাম্বনেইল ইফেক্ট বাদ দিয়ে সরাসরি পেছনটা দেখায়।
settings-selector-flip-back-label = পেছন উন্মোচন
settings-selector-flip-back-desc = বন্ধ করলে থাম্বনেইল ইফেক্ট শেষ হওয়ার পর পেছনের প্যানেল সরাসরি বসে যায়।
settings-selector-flip-duration-label = সময়কাল ওভাররাইড
settings-selector-flip-duration-desc = কার্ড উল্টানোর মোট সময়। এটি ইচ্ছাকৃতভাবে ভাগ করা UI গতির ওজন ওভাররাইড করে।
settings-selector-tag-cloud-card = অনুসন্ধান
settings-selector-tag-cloud-card-desc = পিকারের নিচে নেমে আসা ট্যাগ ও বর্ণনা অনুসন্ধান প্যানেল।
settings-selector-tag-cloud-width-label = প্রস্থ
settings-selector-tag-cloud-width-desc = অনুসন্ধান প্যানেলের প্রস্থ।
settings-selector-tag-cloud-rows-label = ক্লিকযোগ্য ট্যাগ সারি
settings-selector-tag-cloud-rows-desc = অনুসন্ধান ক্ষেত্রের নিচে ক্লিকযোগ্য পরামর্শের কতগুলো সারি খুলবে।
settings-selector-tag-cloud-rows-one = 1 সারি
settings-selector-tag-cloud-rows-two = 2 সারি
settings-selector-tag-cloud-rows-three = 3 সারি
settings-selector-video-preview-card = ভিডিও প্রিভিউ
settings-selector-video-preview-card-desc = ভিডিওতে হোভার বা নির্বাচন করলে চলমান প্রিভিউ।
settings-selector-video-preview-label = ভিডিও প্রিভিউ চালু করুন
settings-selector-video-preview-desc = হোভার/নির্বাচনে স্থির থাম্বনেইলের বদলে ভিডিওটিই চালায়।
settings-selector-preview-delay-label = প্রিভিউ বিলম্ব
settings-selector-preview-delay-desc = হোভার/নির্বাচনের পর প্রিভিউ শুরুর আগে এতক্ষণ অপেক্ষা করে (ms)।
settings-selector-tag-cloud-position-card = অনুসন্ধান প্যানেলের অবস্থান
settings-selector-tag-cloud-position-card-desc = অনুসন্ধান প্যানেল পিক্সেলে অনুভূমিক বা উল্লম্বভাবে সরান। ধনাত্মক অনুভূমিক অফসেট ডানে সরায়; ধনাত্মক উল্লম্ব অফসেট নিচে সরায়।
settings-selector-tag-position-enabled-label = স্ক্রিনের অবস্থান ব্যবহার করুন
settings-selector-tag-position-enabled-desc = সার্চ প্যানেলের আকার বা পিকারের স্টাইল বদলালেও প্যানেলকে এই স্ক্রিন স্থানাঙ্কে রাখে। পিক্সেল অফসেট ব্যবহার করতে বন্ধ করুন।
settings-selector-tag-position-x-label = বাম প্রান্ত
settings-selector-tag-position-x-desc = সার্চ প্যানেলের বাম প্রান্ত স্ক্রিনের প্রস্থের শতাংশ হিসেবে ঠিক করুন।
settings-selector-tag-position-y-label = ওপরের প্রান্ত
settings-selector-tag-position-y-desc = সার্চ প্যানেলের ওপরের প্রান্ত স্ক্রিনের উচ্চতার শতাংশ হিসেবে ঠিক করুন।
settings-selector-tag-offset-x-label = অনুসন্ধান প্যানেলের অনুভূমিক অফসেট
settings-selector-tag-offset-x-desc = এই পিকারের সাপেক্ষে অনুসন্ধান প্যানেল বামে বা ডানে সরান।
settings-selector-tag-offset-y-label = অনুসন্ধান প্যানেলের উল্লম্ব অফসেট
settings-selector-tag-offset-y-desc = এই পিকারের সাপেক্ষে অনুসন্ধান প্যানেল ওপরে বা নিচে সরান।
settings-selector-mode-slices = স্লাইস
settings-selector-mode-hex = জ্যামিতিক
settings-selector-mode-wall = ওয়াল
settings-selector-mode-sandy = বালু
settings-selector-gpu-tier-discrete = ডিসক্রিট
settings-selector-gpu-tier-integrated = ইন্টিগ্রেটেড
settings-selector-gpu-tier-other = অন্যান্য
settings-selector-swap-style-vortex = ঘূর্ণি
settings-selector-swap-style-hourglass = বালুঘড়ি
settings-selector-swap-style-castle = বালির দুর্গ
settings-selector-swap-style-saltation = লম্ফন
settings-selector-swap-style-pour = গ্লাসে ঢালা
settings-selector-swap-style-orbit = মহাঘূর্ণি
settings-selector-swap-style-burst = বিস্ফোরণ
settings-selector-swap-style-weave = বুনন
settings-selector-swap-style-bloom = প্রস্ফুটন
settings-selector-swap-style-flock = পাখির ঝাঁক
settings-selector-swap-style-ring = রিং

settings-selector-mode-hand = তাসের হাত
settings-selector-hand-card = তাসের হাত
settings-selector-hand-card-desc = হাতে ধরা তাসের মতো পার্সপেক্টিভে সাজানো লম্বা কার্ডের পাখা। হাত হেলাতে পয়েন্টার সরান, ঘোরাতে মঞ্চ টেনে আনুন, আর পরের হাত বিলি করতে প্রান্ত ছাড়িয়ে স্ক্রল করুন।
settings-selector-hand-move-label = বিলির চাল
settings-selector-hand-move-desc = কার্ডগুলো কীভাবে উড়ে যায় আর পরের হাত কীভাবে উড়ে আসে। চক্র চালু থাকা চালগুলো ক্রমানুসারে ঘোরে; এলোমেলো প্রতি বিলিতে তার একটি বেছে নেয়। বাদ দিতে নিচে চাল বন্ধ করুন।
settings-selector-hand-move-random = এলোমেলো
settings-selector-hand-move-cycle = চক্র
settings-selector-hand-move-corkscrew = কর্কস্ক্রু
settings-selector-hand-move-cascade = ক্যাসকেড
settings-selector-hand-move-shuffle = শাফল
settings-selector-hand-move-ribbon = রিবন
settings-selector-hand-move-spiral = সর্পিল
settings-selector-hand-count-label = হাতে কার্ড
settings-selector-hand-count-desc = একসাথে দেখানো কার্ড, 3 থেকে 9।
settings-selector-hand-card-width-label = কার্ডের প্রস্থ
settings-selector-hand-card-height-label = কার্ডের উচ্চতা
settings-selector-hand-spread-label = পাখার বিস্তার
settings-selector-hand-spread-desc = পাশাপাশি কার্ডের মধ্যে অনুভূমিক দূরত্ব। মাপগুলো 1440 x 900 মঞ্চের নকশা পিক্সেল এবং পর্দার সাথে স্কেল হয়।
settings-selector-hand-perspective-label = পার্সপেক্টিভ
settings-selector-hand-perspective-desc = ক্যামেরার দূরত্ব। কম মান গভীরতা বাড়িয়ে দেখায়।
settings-selector-hand-tilt-label = পয়েন্টার ঢাল
settings-selector-hand-tilt-desc = পুরো হাত পয়েন্টারের দিকে কতটা হেলবে। 0 ঢাল বন্ধ করে।
settings-selector-hand-speed-label = গতি
settings-selector-hand-speed-desc = বিলি ও উল্টানোর গতি, 100 = ডিফল্ট।
settings-selector-ribbons-card = রিবন
settings-selector-ribbons-card-desc = প্রতিটি কার্ড রিবনে কাটা থাকে, যা কার্ড উল্টালে একে একে খুলে যায় এবং রিবন বিলিতে ছড়িয়ে উড়ে যায়।
settings-selector-hand-ribbon-axis-label = কাটার দিক
settings-selector-hand-ribbon-axis-rows = সারি
settings-selector-hand-ribbon-axis-columns = কলাম
settings-selector-hand-ribbons-label = রিবন
settings-selector-hand-ribbons-desc = প্রতি কার্ডে রিবনের সংখ্যা, 2 থেকে 14।
settings-selector-hand-cut-label = কাটার কোণ
settings-selector-hand-cut-straight = সোজা
settings-selector-hand-cut-slant = হেলানো
settings-selector-hand-cut-steep = খাড়া
settings-selector-hand-cut-variance-label = কাটার তারতম্য
settings-selector-hand-cut-variance-desc = প্রতি কার্ডে রিবনের প্রস্থ ও কোণ এলোমেলো করে।
settings-selector-hand-cut-variance-none = সমান
settings-selector-hand-cut-variance-soft = মৃদু
settings-selector-hand-cut-variance-wild = উদ্দাম
settings-selector-hand-effects-card = আবহ
settings-selector-hand-effects-card-desc = হাতের চারপাশে ঐচ্ছিক স্তর।
settings-selector-hand-ghosts-label = ছায়া রেশ
settings-selector-hand-ghosts-desc = বিলির সময় ঝাপসা, উজ্জ্বল প্রতিলিপি প্রতিটি কার্ডের পেছনে থাকে।
settings-selector-hand-backdrop-label = ঝাপসা পটভূমি
settings-selector-hand-backdrop-desc = হাতের পেছনে নির্বাচিত ওয়ালপেপারের অন্ধকার, ঝাপসা প্রতিলিপি দিয়ে পর্দা ভরায়।
settings-selector-hand-bob-label = নিষ্ক্রিয় দোলা
settings-selector-hand-bob-desc = পিকার খোলা থাকাকালীন কার্ডগুলো মৃদু দোলে। এতে পিকার সারাক্ষণ অ্যানিমেট হয়, তাই নিষ্ক্রিয় অবস্থায়ও GPU সময় খরচ হয়।
settings-selector-hand-fan-angle-label = পাখার কোণ
settings-selector-hand-fan-angle-desc = কেন্দ্র থেকে দূরে প্রতি কার্ডে যোগ করা ঘূর্ণন। 0 হলে প্রতিটি কার্ড আপনার দিকে মুখ করে থাকে।
settings-selector-hand-fan-roll-label = পাখার হেলা
settings-selector-hand-fan-roll-desc = প্রতি কার্ডে যোগ করা ঢাল, হাতে ছড়ানো তাসের মতো। 0 হলে সেগুলো সোজা থাকে।
settings-selector-hand-arch-label = খিলান
settings-selector-hand-arch-desc = বাইরের কার্ডগুলো কেন্দ্রের কার্ডের চেয়ে কতটা নিচে নামবে।
settings-selector-hand-skew-label = তির্যকতা
settings-selector-hand-skew-desc = কার্ডের আকৃতিকে সামান্তরিকে হেলায়, অনুভূমিক অফসেটের পিক্সেলে।
settings-selector-hand-backdrop-blur-label = পটভূমির ঝাপসা
settings-selector-hand-backdrop-blur-desc = পটভূমির ঝাপসার ব্যাসার্ধ, 100 = ডিফল্ট।
settings-selector-hand-reveal-fill-label = প্রিভিউ ফ্রেম পূর্ণ করে
settings-selector-hand-reveal-fill-desc = তাসের হাত উল্টে প্রিভিউ দেখালে কার্ডগুলো প্রসারিত হয়ে পূর্ণ আকারের ছবি তৈরি করে। বন্ধ থাকলে প্রতিটি কার্ড নিজের প্রস্থ ও উচ্চতা রাখে এবং সারিটি জায়গামতো আঁটতে আকার বদলায়।

settings-selector-start-position-label = শুরুর অবস্থান
settings-selector-start-position-desc = শুরুতে, সর্বশেষ প্রয়োগ করা ওয়ালপেপারে, বা যেখানে ব্রাউজ থামিয়েছিলেন সেখানে খোলে। বর্তমান ফিল্টার ব্যবহার করে।
settings-selector-start-position-beginning = শুরু
settings-selector-start-position-applied = সর্বশেষ প্রয়োগ করা ওয়ালপেপার
settings-selector-start-position-browsing = সর্বশেষ ব্রাউজ অবস্থান
settings-selector-loop-around-label = দুই প্রান্তে ঘুরে আসা
settings-selector-loop-around-desc = প্রথম বা শেষ ওয়ালপেপার পেরিয়ে গেলে নির্বাচন অন্য প্রান্তে চলে যায়। চেপে ধরা কী, পেজ বদল ও দ্রুত স্ক্রল আগে প্রান্তে থামে, তাই ঘুরে আসতে আবার চাপুন বা স্ক্রল করুন। সব পেজ লোড হলে অনলাইন উৎসগুলো ঘুরে আসে। Wall লেআউটে ও অনলাইন উৎসে মাউস হুইল শুধু দৃশ্য স্ক্রল করে।

settings-selector-mode-depth = গভীরতা
settings-selector-depth-card = ডেপথ কার্ড
settings-selector-depth-desc = কার্ডগুলো প্রান্তের দিকে ছোট হয়ে আসে। স্ক্রল করার সময় প্রতিটি কার্ডের ভেতরের ছবি সারিতে তার অবস্থান অনুযায়ী সরে যায়।

settings-selector-parallax-label = ছবির প্যারালাক্স
settings-selector-parallax-desc = কার্ড ভিউয়ের মধ্য দিয়ে সরার সময় তার ভেতরের ছবি সরিয়ে দেয়। ছবি দৃশ্যমান প্রান্ত ছাড়িয়েও সরতে থাকে।
settings-selector-mode-collection = সংগ্রহ
settings-selector-collection-desc = মাউস হুইল বা তীর কী দিয়ে হেলানো কার্ডের স্তূপ দেখুন। কার্ড বড় করতে ক্লিক করুন; ফিরতে আবার ক্লিক করুন বা Escape চাপুন। প্রয়োগ করতে Enter চাপুন। বিস্তারিত দেখতে রাইট-ক্লিক করুন।

settings-selector-depth-height-label = কার্ডের উচ্চতা
settings-selector-depth-height-desc = মাঝের কার্ডের উচ্চতা। বড় কার্ড স্ক্রিনে ধরানোর জন্য ছোট হয়ে যায়।

settings-selector-depth-width-label = কার্ডের প্রস্থ
settings-selector-depth-width-desc = মাঝের কার্ডের প্রস্থ পিক্সেলে।

settings-selector-depth-spacing-label = কার্ডের ব্যবধান
settings-selector-depth-spacing-desc = গভীরতায় ছোট হওয়ার আগে কার্ডের কেন্দ্রগুলোর মধ্যে পিক্সেলে দূরত্ব।

settings-selector-depth-count-label = দৃশ্যমান কার্ড
settings-selector-depth-count-desc = বর্তমান নির্বাচনের চারপাশে কার্ডের সর্বোচ্চ সংখ্যা।

settings-selector-depth-falloff-label = গভীরতায় ছোট হওয়া
settings-selector-depth-falloff-desc = কেন্দ্র থেকে প্রতিটি কার্ড দূরে গেলে মাপ কতটা কমবে, 0 থেকে 1-এর মধ্যে। শূন্য রাখলে সব মাপ সমান থাকে।


settings-selector-depth-skew-label = কার্ডের হেলান
settings-selector-depth-skew-desc = কার্ডের প্রান্ত হেলিয়ে দেয়। শূন্য রাখলে সেগুলো সোজা থাকে।

settings-selector-depth-speed-label = নেভিগেশনের সময়
settings-selector-depth-speed-desc = একটি নেভিগেশন নড়াচড়ার সময় মিলিসেকেন্ডে। কম মান মানে দ্রুত।

settings-selector-collection-size-label = কার্ডের আকার
settings-selector-collection-size-desc = কার্ডের প্রস্থ, স্ক্রিনের উচ্চতার শতাংশ হিসেবে।

settings-selector-collection-spacing-label = স্তূপের ব্যবধান
settings-selector-collection-spacing-desc = স্তূপে সাজানো কার্ডগুলোর মধ্যে খাড়া দূরত্ব, কার্ডের আকারের শতাংশ হিসেবে।

settings-selector-collection-count-label = দৃশ্যমান কার্ড
settings-selector-collection-count-desc = স্তূপে কার্ডের সর্বোচ্চ সংখ্যা।

settings-selector-collection-tilt-label = স্তূপের হেলান
settings-selector-collection-tilt-desc = স্তূপটিকে আপনার থেকে দূরে হেলিয়ে দেয়। শূন্য রাখলে কার্ডগুলো সামনাসামনি দেখায়।


settings-selector-collection-speed-label = গতির মাত্রা
settings-selector-collection-speed-desc = নেভিগেশন এবং কার্ড খোলা বা বন্ধ হওয়ার গতি। বেশি মান মানে দ্রুত।

settings-selector-depth-frame-label = নির্বাচন ফ্রেম
settings-selector-depth-frame-desc = নির্বাচিত কার্ডের চারপাশে উজ্জ্বল বর্ডার আঁকে।

settings-selector-shadows-label = কার্ডের ছায়া
settings-selector-shadows-desc = প্রতিটি কার্ডের পেছনে ছায়া আঁকে।
