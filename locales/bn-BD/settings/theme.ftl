settings-theme-behaviour-card = আচরণ
settings-theme-behaviour-card-desc = ওয়ালপেপার বদলালে ইন্টারফেস ও ডেস্কটপ ইন্টিগ্রেশনের রংও বদলাবে কি না তা বেছে নিন।
settings-theme-policy-label = প্যালেট আচরণ
settings-theme-policy-desc = ওয়ালপেপার অনুসরণ প্রতিটি প্রয়োগ করা ওয়ালপেপার থেকে নতুন রং দেয়। স্থির প্যালেট একটি বেছে নেওয়া প্যালেট ব্যবহার করে। বর্তমান রং রাখুন থিমকে যেমন আছে তেমন রাখে।
settings-theme-policy-wallpaper = ওয়ালপেপার অনুসরণ
settings-theme-policy-fixed = স্থির প্যালেট
settings-theme-policy-off = বর্তমান রং রাখুন
settings-theme-driver-card = রঙের উৎস
settings-theme-driver-card-desc = skwd-wall নিজে রং তৈরি করবে নাকি ডেস্কটপ শেলের তৈরি রং আমদানি করবে তা বেছে নিন।
settings-theme-authority-label = রং নিয়ন্ত্রণ
settings-theme-authority-desc = Skwd-wall নিচের জেনারেটর চালায়; এর বদলে ডেস্কটপ শেল বর্তমান ছবি থেকে নিজের প্যালেট ফেরত দেয়।
settings-theme-authority-caelestia = Caelestia ব্যবহার করুন
settings-theme-authority-noctalia = Noctalia ব্যবহার করুন
settings-theme-authority-dms = DMS ব্যবহার করুন
settings-theme-authority-end4 = end-4 ব্যবহার করুন
settings-theme-engine-card = রং জেনারেটর
settings-theme-engine-card-desc = ওয়ালপেপার প্রয়োগের পরে skwd-wall যে প্রোগ্রাম চালায় তা বেছে নিন। শুধু ইনস্টল করা জেনারেটর এখানে দেখা যায়।
settings-theme-engine-label = জেনারেটর
settings-theme-engine-desc = বিল্ট-ইন Iris-এর কোনো বাহ্যিক প্রোগ্রাম লাগে না। Matugen, Wallust, Pywal ও বাহ্যিক Iris নিজেরাই প্যালেট তৈরি করে।
settings-theme-engine-iris-builtin = Iris (বিল্ট-ইন)
settings-theme-engine-matugen = Matugen
settings-theme-engine-wallust = Wallust
settings-theme-engine-pywal = Pywal
settings-theme-engine-iris-external = Iris (বাহ্যিক)
settings-theme-engine-native-legacy = Skwd-colour (পুরোনো)
settings-theme-engine-pywal-legacy = Skwd-Pywal (পুরোনো)
settings-theme-engine-wallust-legacy = Skwd-Wallust (পুরোনো)
settings-theme-appearance-card = চেহারা
settings-theme-appearance-card-desc = ইন্টারফেসে প্রয়োগের আগে তৈরি করা প্যালেট সামঞ্জস্য করুন।
settings-theme-scheme-label = রঙের চরিত্র
settings-theme-scheme-desc = সিড রং কতটা জোরালোভাবে ছড়াবে তা ঠিক করে। Tonal spot ভারসাম্যপূর্ণ, Vibrant ও Expressive বেশি রং ব্যবহার করে, Neutral ও Monochrome কম।
settings-theme-scheme-tonal-spot = Tonal spot
settings-theme-scheme-vibrant = Vibrant
settings-theme-scheme-expressive = Expressive
settings-theme-scheme-neutral = Neutral
settings-theme-scheme-monochrome = Monochrome
settings-theme-scheme-fidelity = Fidelity
settings-theme-scheme-content = Content
settings-theme-scheme-rainbow = Rainbow
settings-theme-scheme-fruit-salad = Fruit salad
settings-theme-finish-label = ফিনিশ
settings-theme-finish-desc = স্বাভাবিক তৈরি করা রং রাখে। প্যাস্টেল হালকা করে, নিষ্প্রভ স্যাচুরেশন কমায়, উজ্জ্বল স্যাচুরেশন বাড়ায়। টেক্সটের রং পাঠযোগ্য থাকে।
settings-theme-finish-natural = স্বাভাবিক (ওয়ালপেপার থেকে)
settings-theme-finish-natural-plain = স্বাভাবিক
settings-theme-finish-pastel = প্যাস্টেল
settings-theme-finish-muted = নিষ্প্রভ
settings-theme-finish-vibrant = উজ্জ্বল
settings-theme-variant-label = ভ্যারিয়েন্ট
settings-theme-variant-desc = গাঢ় বা হালকা প্যালেট। স্বয়ংক্রিয় ওয়ালপেপারের মাপা উজ্জ্বলতা থেকে বেছে নেয়।
settings-theme-variant-dark = গাঢ়
settings-theme-variant-light = হালকা
settings-theme-variant-auto = স্বয়ংক্রিয় (ওয়ালপেপার থেকে)
settings-theme-fixed-card = স্থির প্যালেট
settings-theme-fixed-card-desc = কোন ওয়ালপেপার প্রয়োগ করা আছে তা নির্বিশেষে সবসময় একটি প্যালেট ব্যবহার করুন।
settings-theme-static-theme-label = থিম
settings-theme-static-theme-desc = একটি বিল্ট-ইন প্যালেট, ডিজাইনারে সংরক্ষণ করা একটি, অথবা নিজের রং থেকে তৈরি করতে কাস্টম সিড বেছে নিন।
settings-theme-static-theme-yours = { $name } (আপনার)
settings-theme-static-theme-custom = কাস্টম সিড
settings-theme-designer-label = থিম ডিজাইনার
settings-theme-designer-desc = রঙের চাকায় প্রতিটি ইন্টারফেস রং সম্পাদনা করুন এবং লাইভ প্রিভিউতে ফলাফল দেখুন। সংরক্ষিত প্যালেট উপরের থিম তালিকায় যুক্ত হয়।
settings-theme-designer-action = খুলুন
settings-theme-custom-colors-label = কাস্টম সিড রং
settings-theme-custom-colors-desc = কমা দিয়ে আলাদা করা হেক্স রং, যেমন #1e1e2e, #89b4fa। শুধু কাস্টম সিডের সাথে ব্যবহৃত হয় এবং পূর্ণ প্যালেটে বিস্তৃত হয়।
settings-theme-matugen-card = Matugen চেহারা
settings-theme-matugen-card-desc = Matugen প্যালেট তৈরি করে এবং skwd-wall এর ইন্টারফেস রং আমদানি করে।
settings-theme-matugen-scheme-desc = টেমপ্লেট এবং ইন্টারফেস প্যালেটের জন্য Material 3 স্কিম। স্মার্টে Matugen ছবির রঙের বৈচিত্র্য থেকে স্কিম বেছে নেয়। স্মার্টের জন্য Matugen 4.2 বা নতুন সংস্করণ প্রয়োজন।
settings-theme-interface-finish-label = ইন্টারফেস ফিনিশ
settings-theme-interface-finish-desc = আমদানি করা ইন্টারফেস রোলে প্রয়োগ করা ঐচ্ছিক চূড়ান্ত পরিবর্তন। এটি Matugen-এর বাহ্যিক টেমপ্লেট বদলায় না।
settings-theme-color-index-label = উৎস রঙের সূচক
settings-theme-color-index-desc = কোন প্যালেট স্লট সিড রং হিসেবে ব্যবহার হবে।
settings-theme-color-index-primary = 0 (প্রাথমিক)
settings-theme-contrast-label = কনট্রাস্ট
settings-theme-contrast-desc = Matugen কনট্রাস্ট। পরিসর -1.0 থেকে 1.0 (0 = আদর্শ)।
settings-theme-wallust-card = Wallust
settings-theme-wallust-palette-label = প্যালেট
settings-theme-wallust-palette-desc = একটি wallust প্যালেট জোর করে ব্যবহার করুন (যেমন dark16, harddark, light16)। খালি = মোড অনুযায়ী স্বয়ংক্রিয়।
settings-theme-native-card = Skwd-colour
settings-theme-native-card-desc = পুরোনো বিল্ট-ইন এক্সট্র্যাক্টর, বিদ্যমান কনফিগারেশনের জন্য রাখা। Iris বর্তমান প্যালেট ফরম্যাট তৈরি করে।
settings-theme-external-card = বাহ্যিক প্যালেট
settings-theme-external-card-desc-noctalia = Noctalia রং তৈরি নিয়ন্ত্রণ করে। skwd-wall দ্বিতীয় রঙের উৎস চালানোর বদলে সম্পূর্ণ প্যালেট আমদানি করে।
settings-theme-external-card-desc-dms = Dank Material Shell রং তৈরি নিয়ন্ত্রণ করে। skwd-wall দ্বিতীয় রঙের উৎস চালানোর বদলে সম্পূর্ণ প্যালেট আমদানি করে।
settings-theme-imported-variant-label = আমদানি করা ভ্যারিয়েন্ট
settings-theme-imported-variant-desc-noctalia = বর্তমান ওয়ালপেপারের জন্য skwd-wall কোন Noctalia ভ্যারিয়েন্ট তৈরি ও আমদানি করবে তা বেছে নিন।
settings-theme-imported-variant-desc-dms = বর্তমান ওয়ালপেপারের জন্য DMS-এর তৈরি গাঢ়/হালকা প্যালেটের কোন অর্ধেক skwd-wall আমদানি করবে তা বেছে নিন।

settings-theme-matugen-smart = স্মার্ট
settings-theme-matugen-smart-mode-desc = অটো Skwd-এর উজ্জ্বলতা শনাক্তকরণ ব্যবহার করে। স্মার্টে Matugen ছবি থেকে হালকা বা গাঢ় মোড বেছে নেয়। স্মার্টের জন্য Matugen 4.2 বা নতুন সংস্করণ প্রয়োজন।
