settings-bar-filter = ফিল্টার বার
settings-bar-filter-desc = পিকারের ওপরে ধরন, সাজানো ও ফিল্টার বোতামের সারি।
settings-bar-filter-say = { $val }{ $buttons }{ $end } ও { $val }{ $sorts }{ $end } দেখায়, { $orientation ->
        [vertical] খাড়াভাবে
       *[horizontal] আড়াআড়ি
    } সাজানো। { $visibility ->
        [hover] পয়েন্টার এর ওপর থাকা পর্যন্ত এটি দেখা যায়।
        [hidden] এর কীবাইন্ড চাপা পর্যন্ত এটি লুকানো থাকে।
       *[always] এটি সবসময় পিন করা থাকে।
    } দৃশ্য শৈলী: { $style }।
settings-bar-button-count = { $all }টির মধ্যে { $shown }টি বোতাম
settings-bar-sort-count = { $all }টির মধ্যে { $shown }টি সাজানো
settings-bar-offers = এতে কী আছে
settings-bar-behaves = এটি কেমন আচরণ করে
settings-bar-buttons = বারের বোতাম
settings-bar-search-pinned-hint = পিকারের সাথে খোলে
settings-bar-placed = বারের অবস্থান লেআউটে ঠিক হয়।
settings-bar-sizes = মাপের পরিসর
settings-bar-sizes-desc = যে রেজোলিউশন পরিসর দিয়ে মাপ বোতাম ফিল্টার করে।
settings-bar-sizes-say = মাপ বোতাম { $bands } দেয়।
settings-bar-sizes-none = এখনো কোনো মাপের পরিসর নেই, তাই মাপ বোতামে দেওয়ার কিছু নেই।
settings-bar-unnamed = নামহীন
settings-bar-from = থেকে
settings-bar-up-to = পর্যন্ত
settings-bar-no-limit = সর্বোচ্চ সীমা নেই
settings-bar-add-hint = তৈরি পরিসর বা নিজস্ব পরিসর
settings-bar-start = পিকার কোথা থেকে শুরু হয়
settings-bar-start-desc = পিকার খুললে দেখানো ফোল্ডার।
settings-bar-start-say = পিকার { $folder } এ খোলে এবং { $sticky ->
        [yes] বন্ধ হওয়ার পরেও আপনার ফিল্টার রাখে।
       *[no] প্রতিবার খোলার সময় আপনার ফিল্টার রিসেট করে।
    }
settings-bar-sticky-hint = পিকার বন্ধ হওয়ার পরেও ধরন, ফোল্ডার, রং, সাজানো ও পছন্দের ফিল্টার রাখে
settings-bar-search-desc = ট্যাগ সংরক্ষিত শব্দের সাথে মেলে। বর্ণনা ছোট বিবরণ থেকে ছবি খুঁজে দেয়।
settings-bar-search-say = খোঁজ { $mode ->
        [describe] বর্ণনা
       *[tags] ট্যাগ
    } দিয়ে খোলে। বর্ণনা খোঁজ { $views ->
        [multiview] কম্পোজিশন ও ক্রপে
       *[full] পুরো ছবিতে
    } { $model } ব্যবহার করে।
settings-bar-search-off = খোঁজ { $mode ->
        [describe] বর্ণনা
       *[tags] ট্যাগ
    } দিয়ে খোলে। বর্ণনা খোঁজ বন্ধ: কোনো মডেল লোড হয় না, কিছু ইনডেক্সও হয় না। ট্যাগ কাজ করে।
settings-bar-model-status = { " " }মডেলের অবস্থা: { $val }{ $status }{ $end }।
settings-bar-searching = খোঁজ
settings-bar-unused = ব্যবহৃত নয়
settings-bar-name-hint = সক্রিয় মডেলের তালিকায় দেখায়
settings-bar-manual-hint = প্যাকটি যেখানে আছে সেখান থেকেই যুক্ত করে
settings-bar-forget-hint = ফাইলগুলো থেকে যায়
settings-bar-delete-hint = সিম্যান্টিক খোঁজও বন্ধ করে
settings-menu-choose = বাছুন
settings-checks-count = { $all }টির মধ্যে { $shown }টি
settings-bar-floats-hint = সাজানোতে বসান
settings-bar-delete-named = { $name } মুছুন
settings-bar-forget-named = { $name } ভুলে যান
