settings-paper-awww-type-wave = তরঙ্গ
settings-paper-awww-type-grow = বৃদ্ধি
settings-paper-awww-type-center = কেন্দ্র
settings-paper-awww-type-outer = বাইরে
settings-paper-awww-type-left = বাম
settings-paper-awww-type-right = ডান
settings-paper-awww-type-top = উপরে
settings-paper-awww-type-bottom = নিচে
