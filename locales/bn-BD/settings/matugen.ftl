settings-matugen-external-card = বাহ্যিক Matugen
settings-matugen-external-card-desc = Matugen ওয়ালপেপারের রঙ তৈরি করলে আপনার বাহ্যিক কনফিগারেশন চালান।
settings-matugen-config-label = কনফিগ পাথ
settings-matugen-config-desc = বাহ্যিক matugen কনফিগ ফাইলের পাথ।
settings-matugen-command-label = কমান্ড
settings-matugen-command-desc = Matugen চালাতে ব্যবহৃত কমান্ড। প্লেসহোল্ডার হিসেবে %config%, %path%, %scheme%, %mode% এবং %index% বসাতে পারেন।
settings-matugen-integrations-card = ইন্টিগ্রেশন
settings-matugen-integrations-card-desc = প্রতিটি এন্ট্রি একটি টেমপ্লেট থেকে একটি আউটপুট ফাইল রেন্ডার করে। ফাইল লেখার পরে একটি রিলোড কমান্ড চলতে পারে।
settings-matugen-name-label = নাম
settings-matugen-name-desc = এই ইন্টিগ্রেশনের স্থায়ী শনাক্তকারী।
settings-matugen-template-label = টেমপ্লেট
settings-matugen-template-desc = অ্যাপের রং তৈরি করতে ব্যবহৃত টেমপ্লেট।
settings-matugen-output-label = আউটপুট
settings-matugen-output-desc = রেন্ডার করা আউটপুট যে পাথে লেখা হয়।
settings-matugen-reload-label = রিলোড
settings-matugen-reload-desc = আউটপুট লেখার পরে চালানোর ঐচ্ছিক শেল কমান্ড।
settings-matugen-live-preview-label = লাইভ প্রিভিউ
settings-matugen-live-preview-desc = ওয়ালপেপারের উপর হোভার করার সময়ই Wall-এর রং বদলান। শুধু ওয়ালপেপার প্রয়োগের পরে রং বদলাতে এটি বন্ধ করুন।
settings-matugen-remove-desc = এই এন্ট্রি মুছুন।
settings-matugen-remove-action = সরান
settings-matugen-add-label = ইন্টিগ্রেশন যোগ করুন
settings-matugen-add-desc = একটি খালি ইন্টিগ্রেশন যোগ করুন, তারপর এর টেমপ্লেট, আউটপুট ফাইল ও ঐচ্ছিক রিলোড কমান্ড ঠিক করুন।
settings-matugen-add-action = যোগ করুন

settings-app-themes-title = অ্যাপ থিম
settings-app-themes-desc = কোন অ্যাপগুলো আপনার রং অনুসরণ করবে তা বেছে নিন। কোনো অ্যাপ বন্ধ করলে তার আগের থিম সেটআপ ফিরে আসে।
settings-app-themes-custom = কাস্টম আউটপুট
settings-app-themes-custom-desc = উন্নত টেমপ্লেট, আউটপুট ফাইল ও রিলোড কমান্ড।
settings-app-themes-error = অ্যাপ থিম সেটআপ ব্যর্থ হয়েছে: { $error }
settings-app-themes-scan = অ্যাপ খুঁজুন
settings-app-themes-scan-desc = কোনো অ্যাপ ইনস্টল করার বা তার কনফিগারেশন বদলানোর পরে আবার পরীক্ষা করুন।
settings-app-themes-loading = ইনস্টল করা অ্যাপ ও তাদের থিম সেটআপ পরীক্ষা করতে Deck-এর সাথে সংযোগ করুন।
settings-app-themes-refresh = আবার পরীক্ষা করুন
settings-app-themes-ready = আপনার রং অনুসরণ করতে প্রস্তুত
settings-app-themes-not-installed = ইনস্টল করা নেই
settings-app-themes-conflict = অন্য একটি সেটআপ এই থিম নিয়ন্ত্রণ করছে
settings-app-themes-review = সেটআপ পর্যালোচনা প্রয়োজন
settings-app-themes-changed = Skwd-এর বাইরে কনফিগ বদলেছে
settings-app-themes-interrupted = সেটআপ বাধাগ্রস্ত হয়েছে
settings-app-themes-reload-needed = রং রিফ্রেশ করা যায়নি
settings-app-themes-reload-sent = রং লেখা হয়েছে · রিলোডের অনুরোধ পাঠানো হয়েছে
settings-app-themes-watching = রং লেখা হয়েছে · অ্যাপ পরিবর্তনের জন্য নজর রাখছে
settings-app-themes-next-open = অ্যাপ খুললে প্রযোজ্য হবে
settings-app-themes-busy = কাজ চলছে…
settings-app-themes-configured = থিম কনফিগার করা আছে
settings-app-themes-installed = ইনস্টল করা আছে
settings-app-themes-config-found = কনফিগ পাওয়া গেছে
settings-app-themes-config-create = প্রথম ব্যবহারে কনফিগ তৈরি করে
settings-app-themes-on = চালু
settings-app-themes-off = বন্ধ
settings-app-themes-hide = বিস্তারিত লুকান
settings-app-themes-details = বিস্তারিত
settings-app-themes-custom-conflict = এই অ্যাপের ইতিমধ্যে একটি কাস্টম আউটপুট আছে। ম্যানেজড থিমিংয়ে যাওয়ার আগে কাস্টম আউটপুটের অধীনে সেটি পর্যালোচনা করুন।
settings-app-themes-other-owner = অন্য একটি থিম টুল এই অ্যাপের সাথে যুক্ত আছে। Skwd চালু করার আগে সেই ইন্টিগ্রেশন বিচ্ছিন্ন করুন।
settings-app-themes-restore-desc = Skwd আগের থিম সেটআপ সংরক্ষণ করে এবং শুধু নিজের সেটিংস বদলায়। পরে অসম্পর্কিত সেটিংসে করা সম্পাদনা অক্ষুণ্ণ থাকে।
settings-app-themes-config = অ্যাপ কনফিগারেশন
settings-app-themes-output = তৈরি করা রং
settings-app-themes-adopt = ম্যানেজড থিম ব্যবহার করুন
settings-app-themes-adopt-desc = পুরোনো কাস্টম আউটপুট সংরক্ষিত কিন্তু নিষ্ক্রিয় রাখুন। Skwd এই অ্যাপ সেট আপ করবে, আপনার রং প্রয়োগ করবে এবং বন্ধ করলে পুনরুদ্ধার সামলাবে।
settings-app-themes-custom-enabled = কাস্টম আউটপুট চালান
settings-app-themes-custom-enabled-desc = রং বদলালে এই আউটপুট তৈরি করুন এবং এর রিলোড কমান্ড চালান। ম্যানেজড থিমিংয়ে যাওয়ার পরে এটি বন্ধ রাখুন।
settings-app-themes-undo = সেটআপ বাতিল করুন

settings-app-themes-applied = রং প্রয়োগ হয়েছে
settings-app-themes-refresh-colours = রং রিফ্রেশ করুন
settings-app-themes-retry-reload = অ্যাপটি খুলুন, তারপর আবার চেষ্টা করতে রং রিফ্রেশ করুন বেছে নিন।

settings-matugen-enabled-notice = ওয়ালপেপারের রঙের জন্য Matugen বেছে নেওয়া হয়েছে।
settings-matugen-disabled-notice = ওয়ালপেপারের রঙের জন্য বিল্ট-ইন Iris বেছে নেওয়া হয়েছে।

settings-app-themes-disconnected = Disconnected - keeping current colours
settings-app-themes-template-desc = Edit this template to choose which palette colours each field uses. Save the file, then refresh colours. Wallpaper changes keep your mappings.
settings-app-themes-create-template = Create editable template
settings-app-themes-copy-template = Copy template path
settings-app-themes-reset-template = Reset mappings to defaults
settings-app-themes-disconnect = Disconnect and keep current colours
settings-app-themes-disconnect-desc = Stop updating this app. Keep its current files and colours, including your edits.
settings-app-themes-reconnect = Back up edits and reconnect
settings-app-themes-reconnect-desc = Save a backup of the current files, then apply your mappings and resume colour updates. Direct edits to generated colours are replaced.

settings-app-themes-custom-output-status = বিদ্যমান Skwd কাস্টম আউটপুট এই অ্যাপের রং নির্ধারণ করে
settings-app-themes-custom-switch = বদলাতে নিচের ম্যানেজড থিম বেছে নিন, অথবা আপনার কাস্টম আউটপুট ব্যবহার চালিয়ে যেতে এটি অপরিবর্তিত রাখুন।
