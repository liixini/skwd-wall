settings-transitions-transitions-card = ট্রানজিশন
settings-transitions-transitions-card-desc = এক ওয়ালপেপার থেকে পরেরটিতে কীভাবে যাওয়া হবে তা বেছে নিন। একই সেটিংস ছবি, ভিডিও ও Wallpaper Engine সিনে প্রযোজ্য।
settings-transitions-enable-label = ট্রানজিশন চালু করুন
settings-transitions-enable-desc = বন্ধ থাকলে সরাসরি নতুন ওয়ালপেপারে কাট হয়।
settings-transitions-duration-label = সময়কাল
settings-transitions-duration-desc = মিলিসেকেন্ডে মোট ট্রানজিশনের সময় ঠিক করুন। বালুকণার চলাচল দৃশ্যমান রাখতে বালু ট্রানজিশনের অন্তত 4000 ms দরকার।
settings-transitions-family-label = পরিবার
settings-transitions-shader-label = ট্রানজিশন
settings-transitions-shader-count-desc = এই পরিবারে { $count }টি আছে।
settings-transitions-preview-card = প্রিভিউ
settings-transitions-preview-card-desc = নিচের সময়কাল ও পারফরম্যান্স সেটিংস দিয়ে নির্বাচিত ট্রানজিশন লুপ করুন।
settings-transitions-show-preview-label = প্রিভিউ দেখান
settings-transitions-show-preview-desc = এই ট্যাব খোলা থাকলে ট্রানজিশন রেন্ডারার চালান। এর CPU ও GPU ব্যবহার বন্ধ করতে এটি বন্ধ করুন।
settings-transitions-preview-fps-label = প্রিভিউ ফ্রেম রেট
settings-transitions-preview-fps-desc = প্রতিটি প্রিভিউ ফ্রেমে পুরো পিকার আবার আঁকা হয়। 30 মসৃণ; 120 কোনো দৃশ্যমান লাভ ছাড়াই প্রায় চার গুণ CPU খরচ করে। সর্বোচ্চ FPS-এ সীমাবদ্ধ।
settings-transitions-sand-card = ট্রানজিশন পারফরম্যান্স
settings-transitions-sand-card-desc = প্রতিটি ট্রানজিশন সব মনিটরে নাকি শুধু প্রধান মনিটরে চলবে তা বেছে নিন। উপরের গ্লোবাল সুইচই একমাত্র বন্ধ করার নিয়ন্ত্রণ।
settings-transitions-quality-label = মান
settings-transitions-quality-desc = স্বয়ংক্রিয় ডিসক্রিট GPU-তে 60 fps-এ পূর্ণ রেজোলিউশনে চলে এবং ইন্টিগ্রেটেডে কম হিসেবে। পূর্ণ সীমাহীন; কম কমানো রেজোলিউশনে 30 fps-এ সীমিত, প্রায় 4.5 গুণ সাশ্রয়ী।
settings-transitions-quality-auto = স্বয়ংক্রিয়
settings-transitions-quality-full = পূর্ণ
settings-transitions-quality-low = কম
settings-transitions-scope-desc = সব প্রতিটি আপডেট হওয়া মনিটরে এই শেডার অ্যানিমেট করে। প্রধান একবার অ্যানিমেট করে এবং অন্য মনিটরগুলো সঙ্গে সঙ্গে বদলায়।
settings-transitions-scope-all = সব মনিটর
settings-transitions-scope-primary = শুধু প্রধান
settings-transitions-primary-label = প্রধান মনিটর
settings-transitions-primary-desc = শেডার প্রধান-এ সেট থাকলে যে আউটপুট অ্যানিমেট হয়, যেমন DP-2। খালি হলে প্রথম উপলব্ধ আউটপুট ব্যবহৃত হয়।
settings-transitions-sharp-label = কমানো বালু শার্প করুন
settings-transitions-sharp-desc = কম-রেজোলিউশন বালুতে FSR1-ধাঁচের শার্পেনিং। সামান্য বেশি GPU; শুধু মান রেজোলিউশন কমালে সক্রিয়।
settings-transitions-family-random = এলোমেলো
settings-transitions-family-random-desc = প্রতিবার আলাদা ট্রানজিশন।
settings-transitions-family-fade = ফেড
settings-transitions-family-fade-desc = মিলিয়ে যাওয়া ও মিশে যাওয়া, কোনো জ্যামিতি নেই।
settings-transitions-family-wipe = ওয়াইপ
settings-transitions-family-wipe-desc = একটি আকৃতি বা প্রান্ত স্ক্রিন জুড়ে ছুটে যায়।
settings-transitions-family-warp = ওয়ার্প
settings-transitions-family-warp-desc = ছবি বাঁকে, টানে বা ঢেউ খেলে।
settings-transitions-family-break = ভেঙে যাওয়া
settings-transitions-family-break-desc = ছবি চুরমার হয়, পিক্সেলে ভাঙে বা লেপ্টে যায়।
settings-transitions-family-sand = বালু
settings-transitions-family-sand-desc = প্রতিটি পিক্সেল বালুকণা হয়ে একটি আকৃতিতে উড়ে যায়।

settings-transitions-rate-label = ট্রানজিশন FPS
settings-transitions-rate-desc = ওয়ালপেপারের প্লেব্যাক না বদলে অ্যানিমেশনের প্রতি সেকেন্ডের ফ্রেম সীমিত করুন। প্রতিটি ডিসপ্লের রিফ্রেশ রেট ব্যবহার করতে খালি রাখুন বা 0 লিখুন।
settings-transitions-rate-auto = স্বয়ংক্রিয়

settings-drawing-card = অঙ্কন ট্রানজিশন
settings-drawing-card-desc = অঙ্কনের জন্য একটি ছবি, ভিডিও বা সমর্থিত Wallpaper Engine ওয়ালপেপার প্রস্তুত করে। প্রসেসিং চালানোর আগে একবারই হয়; ক্যাশে থাকা অঙ্কন প্রসেসিং ফাইল ছাড়াই চলে।
settings-drawing-enable-label = প্রস্তুত ওয়ালপেপার ডিফল্টভাবে আঁকুন
settings-drawing-enable-desc = কার্ডে কোনো পছন্দ না থাকলে প্রস্তুত ওয়ালপেপারের জন্য অঙ্কন ব্যবহার করে। কার্ডে "আঁকুন" বা "আঁকা হয়েছে" বেছে নিলে এই ডিফল্ট বদলে যায়। সাধারণ ট্রানজিশন আলাদা।
settings-drawing-enable-unprepared = অঙ্কন ট্রানজিশন চালু করার আগে নির্বাচিত ওয়ালপেপার প্রস্তুত করুন।
settings-drawing-paper-label = কাগজের রং
settings-drawing-paper-desc = যে পটভূমিতে ছবিটি আঁকা হয়।
settings-drawing-ink-label = কালির রং
settings-drawing-ink-desc = আঁকা রেখাগুলোর রং।
settings-drawing-ink-style-label = কালি
settings-drawing-ink-style-desc = সাধারণ রেখা কালির রং ব্যবহার করে। রংধনু রেখা বর্ণালির সব রঙের মধ্য দিয়ে যায়।
settings-drawing-ink-style-plain = সাধারণ
settings-drawing-ink-style-rainbow = রংধনু
settings-drawing-duration-label = সময়কাল
settings-drawing-duration-desc = অঙ্কন ও শেষ ছোঁয়ার মোট সময় মিলিসেকেন্ডে, 1500 থেকে 20000।
settings-drawing-battery-label = ব্যাটারিতে প্রস্তুত করুন
settings-drawing-battery-desc = চার্জার খোলা থাকলেও প্রসেসিং চালাতে দেয়। বন্ধ থাকলে ব্যাটারিতে প্রস্তুতি থেমে যায়; প্রস্তুত অঙ্কন তবু চলতে পারে।
settings-drawing-library-label = সব ওয়ালপেপার প্রস্তুত করুন
settings-drawing-library-desc = অঙ্কন চালু আছে এমন প্রতিটি ওয়ালপেপার প্রস্তুত করে, ভিডিও ও Wallpaper Engine-সহ। প্রস্তুত ওয়ালপেপার বাদ পড়ে, তাই থেমে যাওয়া কাজ যেখানে থেমেছিল সেখান থেকে চলে।
settings-drawing-library-action = সব প্রস্তুত করুন
settings-drawing-library-stop = থামান
settings-drawing-library-skipped = { $count }টি বাদ গেছে
settings-drawing-auto-label = নতুন ওয়ালপেপার স্বয়ংক্রিয়ভাবে প্রস্তুত করুন
settings-drawing-auto-desc = প্রতিবার লাইব্রেরি স্ক্যানের পর, অঙ্কন চালু আছে অথচ এখনো প্রস্তুত হয়নি এমন ওয়ালপেপার প্রস্তুত করে। বিরতি দিলে আপনি আবার শুরু না করা পর্যন্ত এটি আটকে থাকে; থামালে এটি বন্ধ হয়ে যায়।
settings-drawing-pack-label = প্রসেসিং ফাইল
settings-drawing-pack-missing = কোনো প্রসেসিং ফাইল নিবন্ধিত নেই। ওয়ালপেপার প্রস্তুত করতে একটি স্থানীয় অঙ্কন প্যাক ম্যানিফেস্ট বেছে নিন।
settings-drawing-pack-checking = প্রসেসিং ফাইল ও রানটাইম যাচাই হচ্ছে। আপনি এই যাচাই বাতিল করতে পারেন।
settings-drawing-pack-install = অঙ্কন ব্যবহার করতে skwd-drawing-model প্যাকেজটি ইনস্টল করুন।
settings-drawing-pack-ready = প্রসেসিং ফাইল পাওয়া যাচ্ছে। এগুলো শুধু ওয়ালপেপার প্রস্তুত করার সময় ব্যবহার হয়।
settings-drawing-pack-invalid = নিবন্ধিত প্রসেসিং ফাইল ব্যবহার করা যায়নি। একটি বৈধ অঙ্কন প্যাক ম্যানিফেস্ট বেছে নিন।
settings-drawing-pack-action-label = প্রসেসিং ফাইল বেছে নিন
settings-drawing-pack-action-desc = স্থানীয়ভাবে ইনস্টল করা অঙ্কন প্রসেসিং প্যাকের ম্যানিফেস্ট বেছে নিন। এতে কোনো ফাইল ডাউনলোড হয় না।
settings-drawing-pack-action = ম্যানিফেস্ট বেছে নিন
settings-drawing-pack-picker-title = অঙ্কন প্যাক ম্যানিফেস্ট বেছে নিন
settings-drawing-pack-picker-filter = JSON ম্যানিফেস্ট | *.json
settings-drawing-detach-label = প্রসেসিং ফাইল বিচ্ছিন্ন করুন
settings-drawing-detach-desc = নিবন্ধিত প্রসেসিং প্যাক ব্যবহার বন্ধ করে। প্রস্তুত অঙ্কন ক্যাশে থাকে এবং চালানো যায়।
settings-drawing-detach-action = ফাইল বিচ্ছিন্ন করুন
settings-drawing-selection-label = নির্বাচিত ওয়ালপেপার
settings-drawing-selection-none = একটি ওয়ালপেপার বেছে নিন
settings-drawing-selection-unprepared = এই ওয়ালপেপার প্রস্তুত নয়। এটি সাধারণ ট্রানজিশন সেটিং ব্যবহার করে; সেটি বন্ধ থাকলে ওয়ালপেপার সঙ্গে সঙ্গে বদলে যায়।
settings-drawing-selection-prepared = প্রস্তুত। প্রসেসিং ফাইল ছাড়াই অঙ্কন চালানো যায়।
settings-drawing-selection-checking = প্রস্তুতির আগে প্রসেসিং ফাইল যাচাই হচ্ছে।
settings-drawing-selection-preparing = নির্বাচিত ওয়ালপেপার প্রস্তুত হচ্ছে।
settings-drawing-selection-cancelled = প্রস্তুতি বাতিল হয়েছে। ওয়ালপেপারটি আবার প্রস্তুত করা যাবে।
settings-drawing-selection-failed = প্রস্তুতি ব্যর্থ হয়েছে। ত্রুটিটি দেখে আবার চেষ্টা করুন।
settings-drawing-checking-label = প্রসেসিং ফাইল যাচাই হচ্ছে
settings-drawing-checking-desc = স্থানীয় প্যাক ও তার রানটাইম যাচাই হচ্ছে। এতে একটু সময় লাগতে পারে।
settings-drawing-progress-label = প্রস্তুতি
settings-drawing-progress-value = { $stage } · { $percent }% · { $total }-এর মধ্যে { $completed } সম্পন্ন
settings-drawing-prepare-desc = নির্বাচিত ওয়ালপেপার অঙ্কনের জন্য প্রস্তুত করে। ভিডিও ও Wallpaper Engine দৃশ্যে ধরে রাখা একটি ফ্রেম ব্যবহার হয়।
settings-drawing-prepare-action = নির্বাচিত ওয়ালপেপার প্রস্তুত করুন
settings-drawing-prepare-again-action = আবার প্রস্তুত করুন
settings-drawing-cancel-desc = প্রস্তুতি থামায়। ক্যাশে থাকা শেষ হওয়া অঙ্কনগুলো রেখে দেওয়া হয়।
settings-drawing-cancel-action = প্রস্তুতি বাতিল করুন
settings-drawing-preview-desc = নির্বাচিত রঙ ও সময়কাল দিয়ে এই অঙ্কন ডেস্কটপে চালায়। দেখতে পাওয়ার জন্য পিকার লুকিয়ে যায়; ফিরতে Wall-এর শর্টকাট ব্যবহার করুন। এতে অঙ্কন ট্রানজিশন চালু হয় না।
settings-drawing-preview-action = ডেস্কটপে প্রিভিউ করুন
settings-drawing-cache-label = অঙ্কনের ক্যাশ
settings-drawing-clear-desc = ক্যাশ থেকে প্রস্তুত অঙ্কন মুছে দেয়। প্রসেসিং ফাইল নিবন্ধিত থাকে।
settings-drawing-clear-action = অঙ্কনের ক্যাশ খালি করুন
settings-drawing-unavailable-label = অঙ্কন উপলব্ধ নয়
settings-drawing-unavailable-desc = নতুন ওয়ালপেপার প্রস্তুত করতে প্রসেসিং ফাইল নিবন্ধন করুন, অথবা আগে থেকে প্রস্তুত ওয়ালপেপার ব্যবহার করুন।
settings-drawing-error = অঙ্কন ব্যর্থ হয়েছে: { $error }
settings-drawing-selection-paused = প্রস্তুতি বিরতিতে আছে। ক্যাশে থাকা অঙ্কন পাওয়া যায়।
settings-drawing-pause-desc = প্রসেসিং থামায় এবং মডেলগুলো ছেড়ে দেয়। আবার শুরু করলে এই ওয়ালপেপারের প্রস্তুতি নতুন করে শুরু হয়।
settings-drawing-pause-action = প্রস্তুতি বিরতি দিন
settings-drawing-resume-desc = নির্বাচিত ওয়ালপেপারের প্রস্তুতি আবার শুরু করে। ক্যাশে থাকা সম্পূর্ণ অঙ্কন পাওয়া যায়।
settings-drawing-resume-action = প্রস্তুতি আবার শুরু করুন
settings-drawing-pack-size = মডেল ফাইল: { $size }
settings-drawing-stage-checking = ওয়ালপেপার যাচাই হচ্ছে
settings-drawing-stage-ready = প্রস্তুত করার জন্য তৈরি
settings-drawing-stage-starting = মডেল চালু হচ্ছে
settings-drawing-stage-source = মূল ছবি পড়া হচ্ছে
settings-drawing-stage-lineart = রেখা খোঁজা হচ্ছে
settings-drawing-stage-depth = গভীরতা মাপা হচ্ছে
settings-drawing-stage-subjects = মূল বিষয় খোঁজা হচ্ছে
settings-drawing-stage-complete = অঙ্কন প্রস্তুত
settings-drawing-stage-other = ছবি প্রস্তুত হচ্ছে
settings-drawing-selection-other-preparing = আরেকটি ওয়ালপেপার প্রস্তুত হচ্ছে। এটি প্রস্তুত করার আগে ওটি বিরতি দিন বা বাতিল করুন।
settings-drawing-selection-other-paused = আরেকটি ওয়ালপেপার বিরতিতে আছে। এটি প্রস্তুত করার আগে ওটি আবার শুরু বা বাতিল করুন।
settings-drawing-scope-label = প্রস্তুত করুন
settings-drawing-scope-desc = একটি ওয়ালপেপার বা বর্তমান ফিল্টার করা ভিউ বেছে নিন। ছবি, ভিডিও ও সমর্থিত Wallpaper Engine ওয়ালপেপার প্রস্তুত করা যায়, একবারে সর্বোচ্চ 128টি।
settings-drawing-scope-selected = নির্বাচিত ওয়ালপেপার
settings-drawing-scope-view = বর্তমান ভিউ
settings-drawing-view-count-label = বর্তমান ভিউয়ের ওয়ালপেপার
settings-drawing-view-count = বর্তমান ফিল্টার করা ভিউয়ে { $count }টি ওয়ালপেপার আছে।
settings-drawing-view-empty-label = এই ভিউয়ে কোনো ওয়ালপেপার নেই
settings-drawing-view-empty-desc = এই ভিউ প্রস্তুত করার আগে বর্তমান ফিল্টার বদলান বা একটি ওয়ালপেপার বেছে নিন।
settings-drawing-view-limit-label = ওয়ালপেপার অনেক বেশি
settings-drawing-view-limit-desc = এই ভিউয়ে { $count }টি ওয়ালপেপার আছে। প্রস্তুত করার আগে ফিল্টার সংকুচিত করে { $limit }টি বা তার কম করুন।
settings-drawing-prepare-view-desc = বর্তমান ফিল্টার করা ভিউয়ের ওয়ালপেপারগুলো একটি একটি করে প্রস্তুত করে। ক্যাশে থাকা অঙ্কন রেখে দেওয়া হয়।
settings-drawing-prepare-view-action = { $count }টি ওয়ালপেপার প্রস্তুত করুন
settings-drawing-selection-view-preparing = বর্তমান ভিউ প্রস্তুত হচ্ছে। শুধু ক্যাশে থাকা ওয়ালপেপার অঙ্কন ট্রানজিশন ব্যবহার করবে।
settings-drawing-selection-view-paused = বর্তমান ভিউয়ের প্রস্তুতি বিরতিতে আছে। নিচে থেকে আবার শুরু বা বাতিল করুন।

settings-transitions-family-studio = স্টুডিও
settings-transitions-family-studio-desc = কাটা, ভাঁজ করা ও মঞ্চস্থ ট্রানজিশন।
settings-transitions-preset-timing-label = প্রিসেট সময় ব্যবহার করুন
settings-transitions-preset-timing-desc = এই ট্রানজিশনের জন্য তৈরি সময় ব্যবহার করে: { $duration } ms। নিজের সময়কাল দিতে বন্ধ করুন।
settings-transitions-effect-photo-cutout = ফটো কাটআউট
settings-transitions-effect-slat-turn = ঘূর্ণায়মান ফটো স্ল্যাট
settings-transitions-effect-crop-relay = ক্রপ রিলে
settings-transitions-effect-sunlit-arcade = রোদেলা আর্কেড
settings-transitions-effect-paper-heart = ফ্রেমে বাঁধা কাগজের হৃদয়
settings-drawing-device-label = প্রস্তুতির ডিভাইস
settings-drawing-device-desc = ওয়ালপেপার প্রস্তুত করার সময় মডেল কিসে চলবে তা বেছে নিন। স্বয়ংক্রিয় অঙ্কন প্যাকের নিজের পছন্দ ব্যবহার করে, যা প্রথমে CUDA, তারপর WebGPU এবং শেষে CPU চেষ্টা করে। মেমরির সীমা ছাড়ালে কেবল স্বয়ংক্রিয়ই CPU-তে আবার চেষ্টা করে। CPU সব মেশিনে চলে, তবে সবচেয়ে ধীর।
settings-drawing-device-auto = স্বয়ংক্রিয়
settings-drawing-device-cuda = CUDA (NVIDIA)
settings-drawing-device-webgpu = WebGPU
settings-drawing-device-cpu = CPU
settings-drawing-memory-label = মেমরির সীমা
settings-drawing-memory-desc = থামিয়ে দেওয়ার আগে প্রস্তুতি সর্বোচ্চ যত মেমরি ব্যবহার করতে পারে। স্বয়ংক্রিয় 6 GiB-এর সাধারণ সীমা রাখে। বড় ওয়ালপেপার প্রস্তুত না হলে বাড়ান, বা অন্য অ্যাপের জন্য বেশি মেমরি রাখতে কমান। স্বয়ংক্রিয় ডিভাইসে, সীমা ছাড়ানো GPU রান CPU-তে আবার চলে।
settings-drawing-memory-auto = স্বয়ংক্রিয় (6 GiB)
settings-drawing-memory-gib = { $gib } GiB
settings-drawing-memory-mib = { $mib } MiB
