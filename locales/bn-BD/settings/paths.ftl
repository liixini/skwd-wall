settings-paths-excluded-card = বাদ দেওয়া ফোল্ডার
settings-paths-excluded-card-desc = ছবি ও ভিডিও লাইব্রেরিতে এই ফোল্ডার এবং এর সাবফোল্ডারগুলো এড়িয়ে যান। সংরক্ষিত মেটাডেটা অক্ষত থাকে।
settings-paths-path-placeholder = ফোল্ডারের পাথ
settings-paths-source-card = ওয়ালপেপার ফোল্ডারগুলো
settings-paths-source-card-desc = ছবি ও ভিডিওর জন্য এই ফোল্ডারগুলো এবং তাদের সাবফোল্ডার স্ক্যান করুন। পরিবর্তন করলে লাইব্রেরি স্বয়ংক্রিয়ভাবে হালনাগাদ হয়।
settings-paths-folder-choose-action = ফোল্ডার বেছে নিন
settings-paths-folder-picker-error = ফোল্ডার বাছাই ব্যর্থ হয়েছে: { $error }
settings-paths-empty-path = এখনো কোনো পাথ নেই
settings-paths-excluded-everywhere = প্রতিটি ওয়ালপেপার ফোল্ডারে
settings-paths-excluded-inside = { $root }-এর ভেতরে
settings-paths-excluded-outside = কোনো ওয়ালপেপার ফোল্ডারের ভেতরে নয়, তাই কিছুই বাদ দেয় না
settings-paths-count = { $count ->
   *[other] { $count } টি ফোল্ডার
    }
settings-paths-source-empty = এখনো কোনো ওয়ালপেপার ফোল্ডার নেই। লাইব্রেরি গড়তে একটি যোগ করুন।
settings-paths-excluded-empty = কিছুই বাদ দেওয়া নেই।
settings-paths-source-draft = একটি ফোল্ডারের পথ লিখুন
settings-paths-excluded-draft = পূর্ণ পথ লিখুন, অথবা সব জায়গায় বাদ দিতে আপেক্ষিক পথ
settings-paths-add-action = যোগ করুন
settings-paths-remove-action = সরান
settings-paths-undo-action = পূর্বাবস্থায় ফেরান
settings-paths-removed-source = ওয়ালপেপার ফোল্ডার সরানো হয়েছে: { $path }
settings-paths-removed-excluded = বাদ দেওয়া ফোল্ডার সরানো হয়েছে: { $path }
settings-paths-watch-polling = পোলিং
settings-paths-watch-error = পড়া যাচ্ছে না
settings-paths-watch-error-note = মাউন্ট করা ও পড়ার যোগ্য কিনা দেখুন। পোলিং আবার চেষ্টা করতে থাকে।
settings-paths-excluded-footer = বাদ দেওয়া ফোল্ডার কখনো স্ক্যান হয় না, তাই কোনো প্রোফাইল সেগুলো দেখাতে পারে না। ফোল্ডার রেখে জনসমক্ষে লুকাতে লাইব্রেরি › প্রোফাইল ব্যবহার করুন।
