settings-search-index-note = ফলাফল পুরো পাতা জুড়ে থাকে। সেখানেই বদলান, অথবা একটি তার নিজের জায়গায় খুলুন।
settings-search-title = খুঁজুন
settings-search-heading = “{ $query }”
settings-search-note-empty = সব সেটিং খুঁজতে লিখুন, যেগুলো শুধু কিছু সেটআপে খাটে সেগুলোও।
settings-search-note-none = মিলে যাওয়া কোনো সেটিং নেই। পর্দায় যা বদলায় তা চেষ্টা করুন, যেমন ঝাপসা বা শব্দ।
settings-search-note-found = { $count ->
        [one] { $count }টি সেটিং, বর্তমান মানসহ। এখানে বদলান বা তার জায়গায় খুলুন।
       *[other] { $count }টি সেটিং, প্রতিটি বর্তমান মানসহ। এখানে বদলান বা তাদের জায়গায় খুলুন।
    }
settings-search-note-top = { $count }টির মধ্যে সেরা { $shown }টি সেটিং, প্রতিটি বর্তমান মানসহ। এখানে বদলান বা তাদের জায়গায় খুলুন।
