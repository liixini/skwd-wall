settings-sources-wallhaven-say = { $top ->
        [yes] নতুন সেশন { $sort } অনুযায়ী { $range } সময়ে সাজায়, অনুপাত { $ratio }, এবং { $categories } দেখায় { $purity } স্তরে।
       *[no] নতুন সেশন { $sort } অনুযায়ী সাজায়, অনুপাত { $ratio }, এবং { $categories } দেখায় { $purity } স্তরে।
    }
settings-sources-wallhaven-off = বন্ধ। Wallhaven ব্রাউজার লুকানো।
settings-sources-workshop-say = { $trend ->
        [yes] নতুন সেশন { $sort } অনুযায়ী { $days } সময়ে সাজায়, ধরন { $type }, রেজোলিউশন { $resolution }, বিভাগ { $category }।
       *[no] নতুন সেশন { $sort } অনুযায়ী সাজায়, ধরন { $type }, রেজোলিউশন { $resolution }, বিভাগ { $category }।
    }
