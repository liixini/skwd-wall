settings-colours-go-say = { $val }{ $all } میں سے { $on } ایپس{ $end } { $followers ->
        [one] آپ کے رنگوں کی
       *[some] آپ کے رنگوں کی
    } پیروی کرتی ہیں{ $changed ->
        [one] ؛ { $val }{ $name } کی ترتیب Skwd سے باہر بدلی{ $end }۔
        [some] ؛ { $val }{ $count } ایپس Skwd سے باہر بدلیں{ $end }۔
       *[none] ۔
    }
settings-colours-outputs-say = { $state ->
        [none] ابھی کوئی انضمام ٹیمپلیٹ نہیں بناتا۔
        [single] { $val }1 انضمام{ $end } ہر رنگ تبدیلی کے بعد ٹیمپلیٹ فائل میں لکھتا ہے۔
       *[many] { $val }{ $count } انضمام{ $end } ہر رنگ تبدیلی کے بعد ٹیمپلیٹس فائلوں میں لکھتے ہیں۔
    }
settings-colours-shells-say = پروگرام Noctalia { $val }{ $noctalia ->
        [follows] Skwd کے رنگوں کی پیروی کرتا ہے
       *[keeps] اپنے رنگ رکھتا ہے
    }{ $end }؛ پروگرام DMS { $val }{ $dms ->
        [follows] Skwd کے رنگوں کی پیروی کرتا ہے
       *[keeps] اپنے رنگ رکھتا ہے
    }{ $end }{ $caelestia ->
        [yes] ؛ Caelestia کے وال پیپرز ہم آہنگ ہوتے ہیں۔
       *[no] ۔
    }
