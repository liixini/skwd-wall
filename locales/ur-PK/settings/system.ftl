settings-system-power-desc = پکر اور وال پیپرز کی بیٹری حدیں الگ ہیں۔
settings-system-power-say = بیٹری پر { $cap ->
        [none] پکر کی کوئی اضافی حد نہیں ({ $fps })
       *[cap] پکر { $fps } تک محدود رہتا ہے
    }{ $idle ->
        [off] ، صرف عام بیکار وقفہ لاگو ہوتا ہے ({ $seconds })
       *[on] ، کوئی ان پٹ نہ ہو تو { $seconds } بعد ویڈیو رک جاتی ہے
    }، اور { $detail ->
        [full] وال پیپرز پوری تفصیل برقرار رکھتے ہیں
       *[performance] وال پیپرز کارکردگی موڈ پر چلے جاتے ہیں
    }۔
settings-system-power-off = بند۔ بیٹری پر پکر اور وال پیپرز انہی حدوں کے ساتھ چلتے ہیں جو بجلی سے جڑے ہونے پر ہوتی ہیں۔
settings-system-power-source = موجودہ پاور ذریعہ: { $source }
settings-system-always = ہمیشہ
settings-system-on-battery = بیٹری پر · جب سیور چالو ہو
settings-system-max-fps-hint = ڈسپلے کی ریفریش ریٹ، یا ٹھنڈے لیپ ٹاپ کے لیے 60
settings-system-idle-hint = 0 بند کرتا ہے
settings-system-battery-fps-hint = اس اور زیادہ سے زیادہ FPS میں سے کم · 0 بند کرتا ہے
settings-system-battery-idle-hint = چھوٹا والا لاگو ہوتا ہے · 0 بند کرتا ہے
settings-system-battery-wallpaper-hint = براہ راست ویڈیو، 30 fps مناظر
settings-system-gpu-desc = تبدیلی کے بعد پکر دوبارہ کھولیں۔
settings-system-gpu-say = { $mode ->
        [low] پکر { $gpu } استعمال کرتا ہے: یہ انٹیگریٹڈ GPU مانگتا ہے۔
        [high] پکر { $gpu } استعمال کرتا ہے: یہ ڈسکریٹ GPU مانگتا ہے۔
        [none] پکر { $gpu } استعمال کرتا ہے: ڈرائیور فیصلہ کرتا ہے۔
        [auto] پکر { $gpu } استعمال کرتا ہے: بیٹری سیور فعال ہو تو یہ کم پاور والا GPU ترجیح دیتا ہے۔
       *[custom] پکر { $gpu } استعمال کرتا ہے، جسے وہ پہچانتا نہیں، اس لیے یہ خودکار کی طرح کام کرتا ہے۔
    }
settings-system-language-desc = تبدیلیاں فوراً لاگو اور محفوظ ہوتی ہیں۔
settings-system-language-say = { $follow ->
        [desktop] انٹرفیس کی زبان { $language } ہے، ڈیسک ٹاپ کے مطابق۔ وال پیپرز کے نام اور ٹیگ نہیں بدلتے۔
       *[chosen] انٹرفیس کی زبان { $language } ہے۔ وال پیپرز کے نام اور ٹیگ نہیں بدلتے۔
    }
settings-system-bug-title = بگ رپورٹ
settings-system-bug-desc = کسی مسئلے کے ساتھ لگانے کے لیے ایک فائل۔
settings-system-bug-say = ورژن، ماحول اور حالیہ لاگز ایک فائل میں جمع کریں۔
