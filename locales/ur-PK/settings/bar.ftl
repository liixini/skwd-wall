settings-bar-filter = فلٹر بار
settings-bar-filter-desc = پکر کے اوپر قسم، ترتیب اور فلٹر بٹنوں کی پٹی۔
settings-bar-filter-say = { $val }{ $buttons }{ $end } اور { $val }{ $sorts }{ $end } دکھاتا ہے، { $orientation ->
        [vertical] عمودی
       *[horizontal] افقی
    } ترتیب میں۔ { $visibility ->
        [hover] پوائنٹر اس پر رہنے تک یہ دکھائی دیتا ہے۔
        [hidden] اس کی کی بائنڈ دبانے تک یہ چھپا رہتا ہے۔
       *[always] یہ ہمیشہ پن رہتا ہے۔
    } بصری انداز: { $style }۔
settings-bar-button-count = { $all } میں سے { $shown } بٹن
settings-bar-sort-count = { $all } میں سے { $shown } ترتیبیں
settings-bar-offers = اس میں کیا ہے
settings-bar-behaves = یہ کیسے برتاؤ کرتا ہے
settings-bar-buttons = بار کے بٹن
settings-bar-search-pinned-hint = پکر کے ساتھ کھلتا ہے
settings-bar-placed = بار کی جگہ لے آؤٹ میں طے ہوتی ہے۔
settings-bar-sizes = سائز کی حدیں
settings-bar-sizes-desc = ریزولوشن کی حدیں جن سے سائز بٹن فلٹر کرتا ہے۔
settings-bar-sizes-say = سائز بٹن { $bands } پیش کرتا ہے۔
settings-bar-sizes-none = ابھی کوئی سائز کی حد نہیں، اس لیے سائز بٹن کے پاس دینے کو کچھ نہیں۔
settings-bar-unnamed = بے نام
settings-bar-from = سے
settings-bar-up-to = تک
settings-bar-no-limit = کوئی بالائی حد نہیں
settings-bar-add-hint = تیار حد یا اپنی حد
settings-bar-start = پکر کہاں سے شروع ہوتا ہے
settings-bar-start-desc = پکر کھلنے پر دکھایا جانے والا فولڈر۔
settings-bar-start-say = پکر { $folder } پر کھلتا ہے اور { $sticky ->
        [yes] بند ہونے کے بعد آپ کے فلٹر رکھتا ہے۔
       *[no] ہر بار کھلنے پر آپ کے فلٹر ری سیٹ کرتا ہے۔
    }
settings-bar-sticky-hint = پکر بند ہونے کے بعد قسم، فولڈر، رنگ، ترتیب اور پسندیدہ فلٹر برقرار رکھیں
settings-bar-search-desc = ٹیگز محفوظ الفاظ سے ملتے ہیں۔ بیان مختصر تفصیل سے تصاویر ڈھونڈتا ہے۔
settings-bar-search-say = تلاش { $mode ->
        [describe] بیان
       *[tags] ٹیگز
    } کے ساتھ کھلتی ہے۔ بیان والی تلاش { $views ->
        [multiview] ترکیب اور کراپس
       *[full] پوری تصویر
    } پر { $model } استعمال کرتی ہے۔
settings-bar-search-off = تلاش { $mode ->
        [describe] بیان
       *[tags] ٹیگز
    } کے ساتھ کھلتی ہے۔ بیان والی تلاش بند ہے: کوئی ماڈل لوڈ نہیں ہوتا اور کچھ انڈیکس نہیں ہوتا۔ ٹیگز کام کرتے رہتے ہیں۔
settings-bar-model-status = { " " }ماڈل کی حالت: { $val }{ $status }{ $end }۔
settings-bar-searching = تلاش
settings-bar-unused = استعمال میں نہیں
settings-bar-name-hint = فعال ماڈلز کی فہرست میں دکھتا ہے
settings-bar-manual-hint = پیک کو اسی جگہ سے جوڑیں
settings-bar-forget-hint = فائلیں رہتی ہیں
settings-bar-delete-hint = معنوی تلاش بھی بند کرتا ہے
settings-menu-choose = منتخب کریں
settings-checks-count = { $all } میں سے { $shown }
settings-bar-floats-hint = ترتیب میں رکھیں
settings-bar-delete-named = { $name } حذف کریں
settings-bar-forget-named = { $name } بھول جائیں
