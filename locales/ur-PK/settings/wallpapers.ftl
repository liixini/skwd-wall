settings-wallpapers-displays-say = { $state ->
        [none] کوئی ڈسپلے لاک نہیں۔
        [one] { $names } لاک ہے۔
        [some] { $names } لاک ہیں۔
       *[detecting] ڈسپلے تلاش ہو رہے ہیں۔
    } اپنی جگہ کے بغیر ڈسپلے { $fill } استعمال کرتے ہیں۔
settings-wallpapers-play-say = تصاویر { $backend }، ویڈیوز { $val }Vulkan{ $end } استعمال کرتی ہیں، { $layer } تہہ پر۔
settings-wallpapers-transitions-say = { $family } خاندان{ $kind ->
        [random] ، ہر بار مختلف، { $duration } میں۔
        [preset] ، { $shader } سے، { $ms } ms میں۔
       *[shader] ، { $shader } سے، { $duration } میں۔
    } فریم ریٹ { $rate }۔
settings-wallpapers-primary-count = { $state ->
        [none] { $all } میں سے کوئی نہیں
        [all] تمام { $all }
       *[some] { $all } میں سے { $shown }
    }
settings-wallpapers-awww-say = تصاویر { $type } چلاتی ہیں، { $filter } فلٹر کے ساتھ، { $duration } میں۔
settings-wallpapers-drawing-say = { $state ->
        [on] تیار وال پیپر { $duration } میں ڈرا ہوتے ہیں۔
       *[off] بند۔ ڈرا والے کارڈ پھر بھی { $duration } میں ڈرا ہوتے ہیں۔
    }
settings-wallpapers-sound-say = وال پیپر کی آواز { $volume } پر چلتی ہے{ $duck ->
        [yes] { " " }اور دوسری ایپس کی آواز پر رکتی ہے۔
       *[no] ۔
    }
settings-wallpapers-pause-say = { $scope } پر { $rules } سے رکتا ہے{ $apps ->
        [yes] ، اور فہرست کی ایپس کے لیے۔
       *[no] ۔
    }
settings-wallpapers-pause-rules = { $count } ونڈو قواعد
settings-wallpapers-plasma-say = { $state ->
        [off] لاک اسکرین { $mode }۔
        [static] لاک اسکرین { $mode }: { $image }۔
       *[follow] لاک اسکرین { $mode }، مناظر بطور { $scenes ->
        [live] لائیو رینڈر۔
       *[poster] پوسٹر فریم۔
    }
    }
settings-wallpapers-niri-say = دکھاتا ہے { $source ->
       *[current] موجودہ وال پیپر
        [own] اپنا ماخذ
        [stationary] ایک ساکن وال پیپر
    }{ $blur ->
        [yes] ، دھندلا
       *[no] { "" }
    }، مدھم { $dim }{ $auto ->
        [yes] ، نئے رنگ میں
       *[no] { "" }
    }۔
settings-wallpapers-device-hint = خودکار CUDA، WebGPU، پھر CPU آزماتا ہے
settings-wallpapers-memory-hint = حد سے بڑھنے پر خودکار CPU پر دوبارہ چلاتا ہے
