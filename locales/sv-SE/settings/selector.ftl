settings-selector-hex-curve-arc = Båge
settings-selector-hex-curve-wave = Band
settings-selector-hex-curve-s = S-svep
settings-selector-hex-curve-cylinder = Cylinder
settings-selector-hex-shape-label = Plattfamilj
settings-selector-hex-shape-desc = Välj en tessellerande platta. Diamant och Romb sveper en bakgrundsbild i vertikal eller horisontell geometri.
