settings-selector-hex-shape-hexagon = Hexagon
settings-selector-hex-shape-diamond = Diamant
settings-selector-hex-shape-rhombus = Romb
settings-selector-hex-intensity-label = Böjningsstyrka
settings-selector-hex-intensity-desc = Flytta åt höger för att den valda fältformen ska böjas kraftigare.
settings-selector-hex-waves-label = Vågor
settings-selector-hex-waves-desc = Hur många bandvågor som korsar fältet.
settings-selector-hex-orbit-radius-label = Cylinderradie
settings-selector-hex-orbit-radius-desc = Mindre värden sveper fältet tätare.
settings-selector-hex-rows-label = Rader
settings-selector-hex-cols-label = Kolumner
settings-selector-cells-card = Celler
settings-selector-cells-card-desc = Ändra plattornas storlek och mellanrum utan att ändra den valda fältformen.
settings-selector-hex-cell-size-label = Cellstorlek
settings-selector-hex-gap-x-label = Horisontellt mellanrum
settings-selector-hex-gap-y-label = Vertikalt mellanrum
settings-selector-wall-mode-label = Wall-läge
settings-selector-wall-mode-desc = Välj hur Wall arrangerar kort. Varje läge har olika radstorlekar och rullningsbeteende.
settings-selector-wall-mode-uniform = Enhetlig
settings-selector-wall-mode-brick = Tegel
settings-selector-wall-mode-masonry = Murverk
settings-selector-wall-mode-justified = Justerad
settings-selector-wall-mode-editorial = Redaktionell
settings-selector-wall-mode-cylinder = Cylinder
settings-selector-grid-columns-label = Kolumner
settings-selector-grid-rows-label = Rader
settings-selector-grid-stagger-label = Balans
settings-selector-grid-stagger-desc = Ändra förskjutningen för varannan rad, eller huvudkortets storlek i läget Redaktionell.
settings-selector-grid-bend-label = Krökning
settings-selector-grid-bend-desc = Positivt böjer bort; negativt bågnar mot dig.
settings-selector-grid-cylinder-radius-label = Cylinderradie
settings-selector-grid-cylinder-radius-desc = Mindre värden gör svepet tätare.
settings-selector-cards-card = Kort
settings-selector-cards-card-desc = Justera kortens storlek, mellanrum och hörnform.
settings-selector-card-width-label = Kortbredd
settings-selector-card-height-label = Korthöjd
settings-selector-grid-gap-x-label = Horisontellt mellanrum
settings-selector-grid-gap-x-desc = Synligt avstånd kant till kant mellan kolumner.
settings-selector-grid-gap-y-label = Vertikalt mellanrum
settings-selector-grid-gap-y-desc = Synligt avstånd kant till kant mellan rader.
settings-selector-performance-card = Prestanda
settings-selector-performance-card-desc = Varje korn är separat geometri. Större korn ger färre former och mycket mindre GPU-arbete.
settings-selector-sand-note-discrete = Belastningen är liten för den identifierade diskreta GPU:n. Samma kornstorlek kan vara ungefär 150 gånger långsammare på en integrerad GPU.
settings-selector-sand-note-integrated = Sanden kan begränsas av GPU:n på den här integrerade GPU:n. Öka kornstorleken eller låt automatisk rörelsedetalj vara på.
settings-selector-sand-meter-label = { $count } korn/bildruta  ·  { $load }
settings-selector-sand-meter-desc = Korn { $grain } vid en typisk mittbild · { $card } ({ $tier }) · { $note }
settings-selector-sand-load-very-heavy = Mycket tung
settings-selector-sand-load-heavy = Tung
settings-selector-sand-load-moderate = Måttlig
settings-selector-sand-load-light = Lätt
settings-selector-grain-size-label = Kornstorlek
settings-selector-grain-size-desc = Kornstorlek i pixlar. 1 ger ett korn per bildpixel och är tyngst; större korn ser grövre ut men kostar mycket mindre.
settings-selector-render-scale-label = Renderingsskala
settings-selector-render-scale-desc = Rendera sanden i lägre upplösning och skala upp. Sparar mindre än kornstorlek, eftersom kornen är geometri snarare än pixlar.
settings-selector-lod-auto-label = Automatisk rörelsedetalj
settings-selector-lod-auto-desc = Öka kornstorleken vid snabb rullning. På som standard på integrerade GPU:er, där det minskar rörelsekostnaden ungefär 3,5x.
settings-selector-lod-strength-label = Rörelsedetaljens styrka
settings-selector-lod-strength-desc = Största kornmultiplikator vid full rullningshastighet när rörelsedetalj körs.
settings-selector-sandy-card = Sandy
settings-selector-sandy-card-desc = Den aktuella bakgrundsbilden ligger centrerad ovanför en rad runda miniatyrer. Att välja en annan bryter båda bilderna i korn som lämnar och kommer in genom motsatta kanter.
settings-selector-sandy-center-label = Mitthöjd
settings-selector-sandy-slice-height-label = Skivhöjd
settings-selector-sandy-slice-width-label = Skivbredd
settings-selector-sandy-gap-label = Mellanrum
settings-selector-sandy-gap-desc = Mellanrum mellan skeva skivor vid deras vertikala mittpunkt. 0 låter kanterna nudda; negativa värden överlappar.
settings-selector-sandy-skew-label = Skevning
settings-selector-sandy-edge-speed-label = Kantrullning
settings-selector-sandy-edge-speed-desc = Karusellens panoreringshastighet vid skärmkanterna, 100 = standard.
settings-selector-sand-card = Sand
settings-selector-sand-card-desc = Hur kornen färdas. Allt i procent, 100 = standard.
settings-selector-sandy-duration-label = Längd
settings-selector-sandy-duration-desc = Total tid från att den gamla bilden börjar lämna tills den nya bilden är färdigsatt.
settings-selector-sandy-blend-label = Toning
settings-selector-sandy-blend-desc = Färgsvepets längd; ringtoningar går på halva detta.
settings-selector-sandy-strands-label = Band
settings-selector-sandy-strands-desc = Dela upp kornen i fler eller färre synliga strömmar.
settings-selector-sandy-twist-label = Vridning
settings-selector-sandy-twist-desc = Korkskruvsintensitet längs varje band.
settings-selector-sandy-orbit-label = Omlopp
settings-selector-sandy-orbit-desc = Hur brett kornen spiralerar runt sitt band.
settings-selector-sandy-turbulence-label = Turbulens
settings-selector-sandy-turbulence-desc = Slumpmässig vridning av bandens banor.
settings-selector-sandy-waist-label = Midja
settings-selector-sandy-waist-desc = Strömmarnas hopsnörning mitt i flykten; lägre = smalare hals.
settings-selector-sandy-front-label = Front
settings-selector-sandy-front-desc = Förskjutning i när olika delar av den gamla bilden lämnar. Högre värden håller senare områden kvar längre.
settings-selector-sandy-fan-label = Solfjäder
settings-selector-sandy-fan-desc = Strömmarnas spridning vid kanterna, eller virvel i vortexläge.
settings-selector-swap-style-label = Bytesstil
settings-selector-swap-style-desc = Välj vilken bana kornen följer mellan den gamla och den nya bilden.
settings-selector-sandy-arc-label = Båge
settings-selector-sandy-arc-desc = Öglans storlek när hörnögle-bytet är på.
settings-selector-swap-loop-label = Hörnögla vid byte
settings-selector-swap-loop-desc = Avbrytande val öglar kornen genom det övre hörnet i stället för att lyfta in i den snurrande ringen.
settings-selector-outgoing-live-label = Utgående video fortsätter spela
settings-selector-outgoing-live-desc = Låt den gamla videon spela medan den blir sand. Video-till-video kör en andra avkodare tills övergången är klar; av bär en frusen bildruta utan extra kostnad.
settings-selector-ring-card = Ring
settings-selector-ring-card-desc = Inställningarna styr den snurrande kornringen som visas när du bläddrar snabbt bland bakgrundsbilder. Värdet 100 är standard.
settings-selector-ring-size-label = Storlek
settings-selector-ring-size-desc = Omloppsdiameter i förhållande till huvudbilden. Ringen följer fortfarande huvudbildens proportioner; 100 bevarar den avsedda storleken.
settings-selector-ring-spin-label = Rotation
settings-selector-ring-spin-desc = Bandets omloppshastighet.
settings-selector-ring-wave-label = Våg
settings-selector-ring-wave-desc = Radiell vågighet som böljar genom bandet.
settings-selector-ring-soft-label = Mjukhet
settings-selector-ring-soft-desc = Högre värden ger större, svagare korn och gör ringen mindre skarpt avgränsad.
settings-selector-ring-blend-label = Ringtoning
settings-selector-ring-blend-desc = Färgsvepets längd i ringläge.
settings-selector-ring-hold-label = Vilofördröjning
settings-selector-ring-hold-desc = Hur länge efter senaste valet ringen väntar innan den lägger sig på huvudbilden.
settings-selector-slice-size-card = Skivstorlek
settings-selector-slice-height-label = Skivhöjd
settings-selector-visible-count-label = Synliga objekt
settings-selector-expanded-width-label = Vald bredd
settings-selector-slice-width-label = Skivbredd
settings-selector-slice-gap-label = Mellanrum
settings-selector-slice-gap-desc = Mellanrum mellan skeva skivor vid deras vertikala mittpunkt. 0 låter kanterna nudda; negativa värden överlappar.
settings-selector-skew-label = Skevning
settings-selector-edge-tilt-label = Kantlutning
settings-selector-edge-tilt-desc = Luta över- och underkanten. Positiva värden höjer högerkanten; negativa värden höjer vänsterkanten.
settings-selector-wobble-label = Gungning
settings-selector-wobble-desc = Kort böjs i rullningsriktningen och fjädrar tillbaka när rullningen stannar. Snabbare rörelse separerar även färgkanalerna.
settings-selector-wobble-strength-label = Gungningens styrka
settings-selector-wobble-strength-desc = Värdet 100 är standard. Värdet 200 dubblar böjningen och färgseparationen.
settings-selector-corners-card = Hörn
settings-selector-card-flip-card = Kortvändning
settings-selector-card-flip-card-desc = Välj hur ett bakgrundskort går över från miniatyren till detaljerna på baksidan.
settings-selector-flip-effect-label = Effekt
settings-selector-flip-effect-desc = Miniatyrshadern som används under första fasen.
settings-selector-flip-shader-label = Miniatyrshader
settings-selector-flip-shader-desc = Stäng av för att hoppa över miniatyreffekten och visa baksidan direkt.
settings-selector-flip-back-label = Baksidesvisning
settings-selector-flip-back-desc = Stäng av för att knäppa in baksidan direkt när miniatyreffekten är klar.
settings-selector-flip-duration-label = Åsidosätt längd
settings-selector-flip-duration-desc = Total tid för kortvändningen. Detta åsidosätter medvetet de delade UI-rörelsevikterna.
settings-selector-tag-cloud-card = Sök
settings-selector-tag-cloud-card-desc = Sökpanelen för taggar och beskrivningar som fälls ut under väljaren.
settings-selector-tag-cloud-width-label = Bredd
settings-selector-tag-cloud-width-desc = Sökpanelens bredd.
settings-selector-tag-cloud-rows-label = Klickbara taggrader
settings-selector-tag-cloud-rows-desc = Hur många rader klickbara förslag som öppnas under sökfältet.
settings-selector-tag-cloud-rows-one = 1 rad
settings-selector-tag-cloud-rows-two = 2 rader
settings-selector-tag-cloud-rows-three = 3 rader
settings-selector-video-preview-card = Videoförhandsvisning
settings-selector-video-preview-card-desc = En rörlig förhandsvisning när du hovrar över eller väljer en video.
settings-selector-video-preview-label = Aktivera videoförhandsvisning
settings-selector-video-preview-desc = Animera själva videon vid hovring/val i stället för en statisk miniatyr.
settings-selector-preview-delay-label = Fördröjning
settings-selector-preview-delay-desc = Vänta så här länge vid hovring/val innan förhandsvisningen startar (ms).
settings-selector-tag-cloud-position-card = Sökpanelens position
settings-selector-tag-cloud-position-card-desc = Placera sökpanelen på skärmen. Skärmpositionen åsidosätter pixelförskjutningarna när den är aktiverad.
settings-selector-tag-position-enabled-label = Använd skärmposition
settings-selector-tag-position-enabled-desc = Behåll sökpanelens skärmkoordinater när dess storlek eller väljarens stil ändras. Stäng av för att använda pixelförskjutningarna.
settings-selector-tag-position-x-label = Vänsterkant
settings-selector-tag-position-x-desc = Ange sökpanelens vänsterkant som procent av skärmens bredd.
settings-selector-tag-position-y-label = Överkant
settings-selector-tag-position-y-desc = Ange sökpanelens överkant som procent av skärmens höjd.
settings-selector-tag-offset-x-label = Sökpanelens horisontella förskjutning
settings-selector-tag-offset-x-desc = Används när skärmposition är av. Flytta panelen åt vänster eller höger i förhållande till den här väljaren.
settings-selector-tag-offset-y-label = Sökpanelens vertikala förskjutning
settings-selector-tag-offset-y-desc = Används när skärmposition är av. Flytta panelen uppåt eller nedåt i förhållande till den här väljaren.
settings-selector-mode-slices = Skivor
settings-selector-mode-hex = Geometrisk
settings-selector-mode-wall = Vägg
settings-selector-mode-sandy = Sand
